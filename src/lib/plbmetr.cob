*> ---------------------------------------------------------------
*> plbmetr: size and complexity metrics (copy/plbmetr.cpy).
*>
*>   PLB-METRICS-COMPUTE  the metrics of the file just analyzed
*>   PLB-METRICS-TEXT     print them as text
*>   PLB-METRICS-JSON     print them as JSON objects of a list
*>   PLB-METRICS-CSV      print them as CSV rows
*> ---------------------------------------------------------------
IDENTIFICATION DIVISION.
PROGRAM-ID. PLB-METRICS-COMPUTE.
DATA DIVISION.
WORKING-STORAGE SECTION.
COPY "plbtokc.cpy".
COPY "plbmetrc.cpy".
*> The unit each token belongs to, and each unit's entries.
01  WS-TOKEN-UNIT           PIC 9(9) COMP-5 OCCURS TK-MAX TIMES.
01  WS-UNIT-MU              PIC 9(9) COMP-5 OCCURS 20000 TIMES.
01  WS-UNIT-MP              PIC 9(4) COMP-5 OCCURS 20000 TIMES.
LOCAL-STORAGE SECTION.
01  LS-ROOT                 PIC 9(9) COMP-5 VALUE 1.
01  LS-NODE                 PIC 9(9) COMP-5.
01  LS-DEPTH                PIC S9(9) COMP-5.
01  LS-CHILD                PIC 9(9) COMP-5.
01  LS-UP                   PIC 9(9) COMP-5.
01  LS-T                    PIC 9(9) COMP-5.
01  LS-U                    PIC 9(9) COMP-5.
01  LS-M                    PIC 9(9) COMP-5.
01  LS-P                    PIC 9(4) COMP-5.
01  LS-X                    PIC 9(4) COMP-5.
01  LS-S                    PIC 9(9) COMP-5.
01  LS-L                    PIC 9(9) COMP-5.
01  LS-FIRST                PIC 9(9) COMP-5.
01  LS-LAST                 PIC 9(9) COMP-5.
01  LS-FILE                 PIC 9(4) COMP-5.
01  LS-DECISIONS            PIC 9(9) COMP-5.
01  LS-NESTING              PIC 9(4) COMP-5.
01  LS-BODY                 PIC 9(9) COMP-5.
01  LS-TARGETS              PIC 9(9) COMP-5.
01  LS-LOOPS                PIC X.
01  LS-DEPENDING            PIC X.
01  LS-TEXT                 PIC X(31).
01  LS-LEN                  PIC 9(9) COMP-5.
LINKAGE SECTION.
COPY "plbsrcc.cpy".
COPY "plbsrc.cpy".
COPY "plbtok.cpy".
COPY "plbastc.cpy".
COPY "plbast.cpy".
COPY "plbsym.cpy".
COPY "plbflow.cpy".
COPY "plbmetr.cpy".
PROCEDURE DIVISION USING PLB-SOURCE-SET PLB-TOKENS PLB-AST PLB-SYMBOLS
        PLB-FLOW PLB-METRICS.
    MOVE 0 TO MP-COUNT MU-COUNT
    IF AS-COUNT = 0
        GOBACK
    END-IF
    MOVE 1 TO LS-NODE
    PERFORM UNTIL LS-NODE = 0
        IF ND-KIND(LS-NODE) = "PROG" AND MP-COUNT < MP-MAX
            PERFORM ADD-PROGRAM
        END-IF
        CALL "PLB-AST-NEXT" USING PLB-AST LS-ROOT LS-NODE LS-DEPTH
    END-PERFORM
    PERFORM ADD-UNITS
    PERFORM MAP-TOKENS
    MOVE 1 TO LS-NODE
    MOVE 0 TO LS-DEPTH
    PERFORM UNTIL LS-NODE = 0
        IF ND-KIND(LS-NODE) = "STMT"
            PERFORM COUNT-STATEMENT
        END-IF
        CALL "PLB-AST-NEXT" USING PLB-AST LS-ROOT LS-NODE LS-DEPTH
    END-PERFORM
    PERFORM COUNT-DATA-ITEMS
    GOBACK.

*> Programs --------------------------------------------------------

ADD-PROGRAM.
    ADD 1 TO MP-COUNT
    MOVE MP-COUNT TO LS-P
    INITIALIZE MP-ENTRY(LS-P)
    MOVE LS-NODE TO MP-NODE(LS-P)
    MOVE SPACES TO MP-NAME(LS-P)
    IF ND-NAME(LS-NODE) > 0
        CALL "PLB-TOK-TEXT" USING PLB-TOKENS ND-NAME(LS-NODE)
            MP-NAME(LS-P) LS-LEN
    END-IF
    MOVE 1 TO MP-COMPLEXITY(LS-P)
    MOVE ND-TOK-FIRST(LS-NODE) TO LS-T
    MOVE TK-FILE-ID(LS-T) TO LS-FILE MP-FILE-ID(LS-P)
    MOVE TK-SRC-LINE(LS-T) TO LS-FIRST
    MOVE ND-TOK-LAST(LS-NODE) TO LS-T
    MOVE TK-SRC-LINE(LS-T) TO LS-LAST
    IF LS-FIRST > 0
        MOVE SL-LINE-NO(LS-FIRST) TO MP-LINE(LS-P)
    END-IF
    *> The lines of the program's own file in that range.
    IF LS-FIRST > 0 AND LS-LAST >= LS-FIRST
        PERFORM VARYING LS-L FROM LS-FIRST BY 1 UNTIL LS-L > LS-LAST
            IF SL-FILE-ID(LS-L) = LS-FILE
                ADD 1 TO MP-LINES(LS-P)
                EVALUATE TRUE
                    WHEN SL-IS-BLANK(LS-L)
                        ADD 1 TO MP-BLANK-LINES(LS-P)
                    WHEN SL-IS-COMMENT(LS-L) OR SL-IS-PAGE(LS-L)
                        ADD 1 TO MP-COMMENT-LINES(LS-P)
                    WHEN OTHER
                        ADD 1 TO MP-CODE-LINES(LS-P)
                END-EVALUATE
            END-IF
        END-PERFORM
    END-IF.

*> LS-P = the entry of program node LS-UP, or 0.
FIND-PROGRAM.
    MOVE 0 TO LS-P
    PERFORM VARYING LS-X FROM 1 BY 1 UNTIL LS-X > MP-COUNT
        IF MP-NODE(LS-X) = LS-UP
            MOVE LS-X TO LS-P
            EXIT PERFORM
        END-IF
    END-PERFORM.

*> Units ---------------------------------------------------------------

ADD-UNITS.
    PERFORM VARYING LS-U FROM 1 BY 1 UNTIL LS-U > FU-COUNT
        MOVE 0 TO WS-UNIT-MU(LS-U) WS-UNIT-MP(LS-U)
        MOVE FU-PROGRAM(LS-U) TO LS-UP
        PERFORM FIND-PROGRAM
        IF LS-P > 0 AND MU-COUNT < MU-MAX
            ADD 1 TO MU-COUNT
            MOVE MU-COUNT TO LS-M
            INITIALIZE MU-ENTRY(LS-M)
            MOVE LS-U TO MU-UNIT(LS-M)
            MOVE FU-NAME(LS-U) TO MU-NAME(LS-M)
            MOVE FU-KIND(LS-U) TO MU-KIND(LS-M)
            MOVE 1 TO MU-COMPLEXITY(LS-M)
            MOVE ND-NAME(FU-NODE(LS-U)) TO MU-NAME-TOKEN(LS-M)
            MOVE ND-TOK-FIRST(FU-NODE(LS-U)) TO LS-T
            MOVE TK-SRC-LINE(LS-T) TO LS-FIRST
            MOVE ND-TOK-LAST(FU-NODE(LS-U)) TO LS-T
            *> The statements before the first section or paragraph end
            *> where it starts, not with the division.
            IF FU-KIND(LS-U) = "D" AND LS-U < FU-COUNT
                IF FU-PROGRAM(LS-U + 1) = FU-PROGRAM(LS-U)
                    COMPUTE LS-T = ND-TOK-FIRST(FU-NODE(LS-U + 1)) - 1
                END-IF
            END-IF
            MOVE TK-SRC-LINE(LS-T) TO LS-LAST
            IF LS-FIRST > 0 AND LS-LAST > 0
                MOVE SL-LINE-NO(LS-FIRST) TO MU-LINE(LS-M)
                IF SL-FILE-ID(LS-LAST) = SL-FILE-ID(LS-FIRST)
                   AND SL-LINE-NO(LS-LAST) >= SL-LINE-NO(LS-FIRST)
                    COMPUTE MU-LINES(LS-M) =
                        SL-LINE-NO(LS-LAST) - SL-LINE-NO(LS-FIRST) + 1
                END-IF
            END-IF
            MOVE LS-M TO WS-UNIT-MU(LS-U)
            MOVE LS-P TO WS-UNIT-MP(LS-U)
            IF MP-UNIT-COUNT(LS-P) = 0
                MOVE LS-M TO MP-UNIT-FIRST(LS-P)
            END-IF
            ADD 1 TO MP-UNIT-COUNT(LS-P)
            EVALUATE FU-KIND(LS-U)
                WHEN "S"
                    ADD 1 TO MP-SECTIONS(LS-P)
                WHEN "P"
                    ADD 1 TO MP-PARAGRAPHS(LS-P)
            END-EVALUATE
        END-IF
    END-PERFORM.

*> Units in source order: a paragraph's tokens overwrite those of the
*> section and division it is in.
MAP-TOKENS.
    PERFORM VARYING LS-T FROM 1 BY 1 UNTIL LS-T > TK-COUNT
        MOVE 0 TO WS-TOKEN-UNIT(LS-T)
    END-PERFORM
    PERFORM VARYING LS-U FROM 1 BY 1 UNTIL LS-U > FU-COUNT
        PERFORM VARYING LS-T FROM ND-TOK-FIRST(FU-NODE(LS-U)) BY 1
                UNTIL LS-T > ND-TOK-LAST(FU-NODE(LS-U))
            MOVE LS-U TO WS-TOKEN-UNIT(LS-T)
        END-PERFORM
    END-PERFORM.

*> Statements ------------------------------------------------------

COUNT-STATEMENT.
    MOVE WS-TOKEN-UNIT(ND-TOK-FIRST(LS-NODE)) TO LS-U
    IF LS-U = 0
        EXIT PARAGRAPH
    END-IF
    MOVE WS-UNIT-MU(LS-U) TO LS-M
    MOVE WS-UNIT-MP(LS-U) TO LS-P
    IF LS-M = 0 OR LS-P = 0
        EXIT PARAGRAPH
    END-IF
    ADD 1 TO MU-STATEMENTS(LS-M) MP-STATEMENTS(LS-P)
    *> Nesting: this statement and the statements it is inside.
    MOVE 1 TO LS-NESTING
    MOVE ND-PARENT(LS-NODE) TO LS-UP
    PERFORM UNTIL LS-UP = 0
        IF ND-KIND(LS-UP) = "STMT"
            ADD 1 TO LS-NESTING
        END-IF
        IF ND-KIND(LS-UP) = "SENT" OR ND-KIND(LS-UP) = "PARA"
           OR ND-KIND(LS-UP) = "SECT"
            EXIT PERFORM
        END-IF
        MOVE ND-PARENT(LS-UP) TO LS-UP
    END-PERFORM
    IF LS-NESTING > MU-NESTING(LS-M)
        MOVE LS-NESTING TO MU-NESTING(LS-M)
    END-IF
    IF LS-NESTING > MP-NESTING(LS-P)
        MOVE LS-NESTING TO MP-NESTING(LS-P)
    END-IF
    *> Decisions.
    MOVE 0 TO LS-DECISIONS
    EVALUATE ND-DETAIL(LS-NODE)
        WHEN "IF"
            ADD 1 TO LS-DECISIONS
        WHEN "PERFORM"
            PERFORM CHECK-LOOP
            IF LS-LOOPS = "Y"
                ADD 1 TO LS-DECISIONS
            END-IF
        WHEN "GO"
            ADD 1 TO MP-GO-TOS(LS-P)
            PERFORM CHECK-DEPENDING
            IF LS-DEPENDING = "Y"
                ADD LS-TARGETS TO LS-DECISIONS
            END-IF
        WHEN "CALL"
            ADD 1 TO MP-CALLS(LS-P)
    END-EVALUATE
    MOVE ND-FIRST(LS-NODE) TO LS-CHILD
    PERFORM UNTIL LS-CHILD = 0
        EVALUATE ND-KIND(LS-CHILD)
            WHEN "BLCK"
                EVALUATE ND-DETAIL(LS-CHILD)
                    WHEN "THEN" WHEN "ELSE" WHEN "BODY" WHEN "WHEN-OTHER"
                        CONTINUE
                    WHEN OTHER
                        *> WHEN, and AT END, INVALID KEY, ON SIZE
                        *> ERROR, ... and their NOT forms.
                        ADD 1 TO LS-DECISIONS
                END-EVALUATE
                PERFORM COUNT-CONDITIONS-IN-BLOCK
            WHEN "COND"
                PERFORM COUNT-AND-OR
            WHEN "PROC"
                IF ND-DETAIL(LS-CHILD) = "PERFORM"
                    ADD 1 TO MP-PERFORMS(LS-P)
                END-IF
        END-EVALUATE
        MOVE ND-NEXT(LS-CHILD) TO LS-CHILD
    END-PERFORM
    ADD LS-DECISIONS TO MU-COMPLEXITY(LS-M) MP-COMPLEXITY(LS-P).

*> A WHEN block holds its condition as a COND child.
COUNT-CONDITIONS-IN-BLOCK.
    MOVE ND-FIRST(LS-CHILD) TO LS-S
    PERFORM UNTIL LS-S = 0
        IF ND-KIND(LS-S) = "COND"
            MOVE LS-CHILD TO LS-UP
            MOVE LS-S TO LS-CHILD
            PERFORM COUNT-AND-OR
            MOVE LS-UP TO LS-CHILD
        END-IF
        MOVE ND-NEXT(LS-S) TO LS-S
    END-PERFORM.

*> Each AND and OR in condition node LS-CHILD.
COUNT-AND-OR.
    PERFORM VARYING LS-T FROM ND-TOK-FIRST(LS-CHILD) BY 1
            UNTIL LS-T > ND-TOK-LAST(LS-CHILD)
        IF TK-IS-WORD(LS-T)
            CALL "PLB-TOK-TEXT" USING PLB-TOKENS LS-T LS-TEXT LS-LEN
            IF LS-TEXT = "AND" OR LS-TEXT = "OR"
                ADD 1 TO LS-DECISIONS
            END-IF
        END-IF
    END-PERFORM.

*> LS-LOOPS = "Y" for PERFORM ... UNTIL, VARYING, TIMES, or FOREVER:
*> those words before the statements of an inline body.
CHECK-LOOP.
    MOVE "N" TO LS-LOOPS
    MOVE ND-TOK-LAST(LS-NODE) TO LS-BODY
    MOVE ND-FIRST(LS-NODE) TO LS-CHILD
    PERFORM UNTIL LS-CHILD = 0
        IF ND-KIND(LS-CHILD) = "BLCK"
            COMPUTE LS-BODY = ND-TOK-FIRST(LS-CHILD) - 1
            EXIT PERFORM
        END-IF
        MOVE ND-NEXT(LS-CHILD) TO LS-CHILD
    END-PERFORM
    PERFORM VARYING LS-T FROM ND-TOK-FIRST(LS-NODE) BY 1
            UNTIL LS-T > LS-BODY
        IF TK-IS-WORD(LS-T)
            CALL "PLB-TOK-TEXT" USING PLB-TOKENS LS-T LS-TEXT LS-LEN
            IF LS-TEXT = "UNTIL" OR LS-TEXT = "VARYING"
               OR LS-TEXT = "TIMES" OR LS-TEXT = "FOREVER"
                MOVE "Y" TO LS-LOOPS
                EXIT PERFORM
            END-IF
        END-IF
    END-PERFORM.

*> GO TO a b c DEPENDING ON x: LS-TARGETS = the number of targets.
CHECK-DEPENDING.
    MOVE "N" TO LS-DEPENDING
    MOVE 0 TO LS-TARGETS
    MOVE ND-FIRST(LS-NODE) TO LS-CHILD
    PERFORM UNTIL LS-CHILD = 0
        IF ND-KIND(LS-CHILD) = "PROC"
            ADD 1 TO LS-TARGETS
        END-IF
        MOVE ND-NEXT(LS-CHILD) TO LS-CHILD
    END-PERFORM
    PERFORM VARYING LS-T FROM ND-TOK-FIRST(LS-NODE) BY 1
            UNTIL LS-T > ND-TOK-LAST(LS-NODE)
        IF TK-IS-WORD(LS-T)
            CALL "PLB-TOK-TEXT" USING PLB-TOKENS LS-T LS-TEXT LS-LEN
            IF LS-TEXT = "DEPENDING"
                MOVE "Y" TO LS-DEPENDING
                EXIT PERFORM
            END-IF
        END-IF
    END-PERFORM.

*> Data items: entries other than condition names.
COUNT-DATA-ITEMS.
    PERFORM VARYING LS-S FROM 1 BY 1 UNTIL LS-S > SY-COUNT
        IF SY-LEVEL(LS-S) NOT = 88
            MOVE SY-PROGRAM(LS-S) TO LS-UP
            PERFORM FIND-PROGRAM
            IF LS-P > 0
                ADD 1 TO MP-DATA-ITEMS(LS-P)
            END-IF
        END-IF
    END-PERFORM.
END PROGRAM PLB-METRICS-COMPUTE.

*> PLB-METRICS-TEXT: one block per program, then a line per paragraph
*> and section.
IDENTIFICATION DIVISION.
PROGRAM-ID. PLB-METRICS-TEXT.
DATA DIVISION.
WORKING-STORAGE SECTION.
COPY "plbmetrc.cpy".
LOCAL-STORAGE SECTION.
01  LS-P                    PIC 9(4) COMP-5.
01  LS-M                    PIC 9(9) COMP-5.
01  LS-OUT                  PIC X(1024).
01  LS-PTR                  PIC 9(9) COMP-5.
01  LS-LEN                  PIC 9(9) COMP-5.
01  LS-NUM                  PIC S9(18) COMP-5.
01  LS-NUM-TEXT             PIC X(20).
01  LS-NUM-LEN              PIC 9(9) COMP-5.
01  LS-PATH                 PIC X(512).
LINKAGE SECTION.
COPY "plbsrcc.cpy".
COPY "plbsrc.cpy".
COPY "plbmetr.cpy".
PROCEDURE DIVISION USING PLB-SOURCE-SET PLB-METRICS.
    PERFORM VARYING LS-P FROM 1 BY 1 UNTIL LS-P > MP-COUNT
        PERFORM PRINT-PROGRAM
        PERFORM VARYING LS-M FROM MP-UNIT-FIRST(LS-P) BY 1
                UNTIL LS-M >= MP-UNIT-FIRST(LS-P) + MP-UNIT-COUNT(LS-P)
            PERFORM PRINT-UNIT
        END-PERFORM
    END-PERFORM
    GOBACK.

PRINT-PROGRAM.
    MOVE SPACES TO LS-OUT
    MOVE 1 TO LS-PTR
    STRING "program " DELIMITED BY SIZE
           MP-NAME(LS-P) DELIMITED BY SPACE
           " " DELIMITED BY SIZE
        INTO LS-OUT WITH POINTER LS-PTR
    CALL "PLB-SRC-FILE-PATH" USING PLB-SOURCE-SET MP-FILE-ID(LS-P) LS-PATH
    CALL "PLB-STR-LENGTH" USING LS-PATH LS-LEN
    IF LS-LEN > 0
        STRING LS-PATH(1:LS-LEN) DELIMITED BY SIZE
            INTO LS-OUT WITH POINTER LS-PTR
    END-IF
    STRING ":" DELIMITED BY SIZE INTO LS-OUT WITH POINTER LS-PTR
    MOVE MP-LINE(LS-P) TO LS-NUM
    PERFORM APPEND-NUM
    PERFORM PRINT-LINE
    MOVE "  lines " TO LS-OUT
    MOVE 9 TO LS-PTR
    MOVE MP-LINES(LS-P) TO LS-NUM
    PERFORM APPEND-NUM
    STRING " (code " DELIMITED BY SIZE INTO LS-OUT WITH POINTER LS-PTR
    MOVE MP-CODE-LINES(LS-P) TO LS-NUM
    PERFORM APPEND-NUM
    STRING ", comment " DELIMITED BY SIZE INTO LS-OUT WITH POINTER LS-PTR
    MOVE MP-COMMENT-LINES(LS-P) TO LS-NUM
    PERFORM APPEND-NUM
    STRING ", blank " DELIMITED BY SIZE INTO LS-OUT WITH POINTER LS-PTR
    MOVE MP-BLANK-LINES(LS-P) TO LS-NUM
    PERFORM APPEND-NUM
    STRING ")" DELIMITED BY SIZE INTO LS-OUT WITH POINTER LS-PTR
    PERFORM PRINT-LINE
    MOVE "  statements " TO LS-OUT
    MOVE 14 TO LS-PTR
    MOVE MP-STATEMENTS(LS-P) TO LS-NUM
    PERFORM APPEND-NUM
    STRING ", sections " DELIMITED BY SIZE INTO LS-OUT WITH POINTER LS-PTR
    MOVE MP-SECTIONS(LS-P) TO LS-NUM
    PERFORM APPEND-NUM
    STRING ", paragraphs " DELIMITED BY SIZE
        INTO LS-OUT WITH POINTER LS-PTR
    MOVE MP-PARAGRAPHS(LS-P) TO LS-NUM
    PERFORM APPEND-NUM
    STRING ", data items " DELIMITED BY SIZE
        INTO LS-OUT WITH POINTER LS-PTR
    MOVE MP-DATA-ITEMS(LS-P) TO LS-NUM
    PERFORM APPEND-NUM
    PERFORM PRINT-LINE
    MOVE "  complexity " TO LS-OUT
    MOVE 14 TO LS-PTR
    MOVE MP-COMPLEXITY(LS-P) TO LS-NUM
    PERFORM APPEND-NUM
    STRING ", deepest nesting " DELIMITED BY SIZE
        INTO LS-OUT WITH POINTER LS-PTR
    MOVE MP-NESTING(LS-P) TO LS-NUM
    PERFORM APPEND-NUM
    STRING ", GO TO " DELIMITED BY SIZE INTO LS-OUT WITH POINTER LS-PTR
    MOVE MP-GO-TOS(LS-P) TO LS-NUM
    PERFORM APPEND-NUM
    STRING ", PERFORM " DELIMITED BY SIZE INTO LS-OUT WITH POINTER LS-PTR
    MOVE MP-PERFORMS(LS-P) TO LS-NUM
    PERFORM APPEND-NUM
    STRING ", CALL " DELIMITED BY SIZE INTO LS-OUT WITH POINTER LS-PTR
    MOVE MP-CALLS(LS-P) TO LS-NUM
    PERFORM APPEND-NUM
    PERFORM PRINT-LINE.

*>  paragraph NAME line N: S statements, complexity C, nesting D, L lines
PRINT-UNIT.
    MOVE SPACES TO LS-OUT
    MOVE 1 TO LS-PTR
    EVALUATE MU-KIND(LS-M)
        WHEN "S"
            STRING "  section " DELIMITED BY SIZE
                   MU-NAME(LS-M) DELIMITED BY SPACE
                INTO LS-OUT WITH POINTER LS-PTR
        WHEN "P"
            STRING "  paragraph " DELIMITED BY SIZE
                   MU-NAME(LS-M) DELIMITED BY SPACE
                INTO LS-OUT WITH POINTER LS-PTR
        WHEN OTHER
            STRING "  (start)" DELIMITED BY SIZE
                INTO LS-OUT WITH POINTER LS-PTR
    END-EVALUATE
    STRING " line " DELIMITED BY SIZE INTO LS-OUT WITH POINTER LS-PTR
    MOVE MU-LINE(LS-M) TO LS-NUM
    PERFORM APPEND-NUM
    STRING ": " DELIMITED BY SIZE INTO LS-OUT WITH POINTER LS-PTR
    MOVE MU-STATEMENTS(LS-M) TO LS-NUM
    PERFORM APPEND-NUM
    IF LS-NUM = 1
        STRING " statement" DELIMITED BY SIZE
            INTO LS-OUT WITH POINTER LS-PTR
    ELSE
        STRING " statements" DELIMITED BY SIZE
            INTO LS-OUT WITH POINTER LS-PTR
    END-IF
    STRING ", complexity " DELIMITED BY SIZE
        INTO LS-OUT WITH POINTER LS-PTR
    MOVE MU-COMPLEXITY(LS-M) TO LS-NUM
    PERFORM APPEND-NUM
    STRING ", nesting " DELIMITED BY SIZE INTO LS-OUT WITH POINTER LS-PTR
    MOVE MU-NESTING(LS-M) TO LS-NUM
    PERFORM APPEND-NUM
    STRING ", " DELIMITED BY SIZE INTO LS-OUT WITH POINTER LS-PTR
    MOVE MU-LINES(LS-M) TO LS-NUM
    PERFORM APPEND-NUM
    STRING " lines" DELIMITED BY SIZE INTO LS-OUT WITH POINTER LS-PTR
    PERFORM PRINT-LINE.

APPEND-NUM.
    CALL "PLB-STR-FROM-INT" USING LS-NUM LS-NUM-TEXT LS-NUM-LEN
    STRING LS-NUM-TEXT(1:LS-NUM-LEN) DELIMITED BY SIZE
        INTO LS-OUT WITH POINTER LS-PTR.

PRINT-LINE.
    CALL "PLB-STR-LENGTH" USING LS-OUT LS-LEN
    IF LS-LEN = 0
        MOVE 1 TO LS-LEN
    END-IF
    DISPLAY LS-OUT(1:LS-LEN)
    MOVE SPACES TO LS-OUT.
END PROGRAM PLB-METRICS-TEXT.

*> PLB-METRICS-JSON: one JSON object per program, as elements of a
*> list the caller opens and closes. FIRST is "Y" until the first
*> element is written, and is set to "N" then.
IDENTIFICATION DIVISION.
PROGRAM-ID. PLB-METRICS-JSON.
DATA DIVISION.
WORKING-STORAGE SECTION.
COPY "plbmetrc.cpy".
LOCAL-STORAGE SECTION.
01  LS-P                    PIC 9(4) COMP-5.
01  LS-M                    PIC 9(9) COMP-5.
01  LS-OUT                  PIC X(2048).
01  LS-PTR                  PIC 9(9) COMP-5.
01  LS-LEN                  PIC 9(9) COMP-5.
01  LS-NUM                  PIC S9(18) COMP-5.
01  LS-NUM-TEXT             PIC X(20).
01  LS-NUM-LEN              PIC 9(9) COMP-5.
01  LS-PATH                 PIC X(512).
01  LS-KIND                 PIC X(9).
LINKAGE SECTION.
COPY "plbsrcc.cpy".
COPY "plbsrc.cpy".
COPY "plbmetr.cpy".
01  LK-FIRST                PIC X.
PROCEDURE DIVISION USING PLB-SOURCE-SET PLB-METRICS LK-FIRST.
    PERFORM VARYING LS-P FROM 1 BY 1 UNTIL LS-P > MP-COUNT
        IF LK-FIRST = "Y"
            MOVE "N" TO LK-FIRST
        ELSE
            DISPLAY "    ,"
        END-IF
        PERFORM WRITE-PROGRAM
    END-PERFORM
    GOBACK.

WRITE-PROGRAM.
    MOVE SPACES TO LS-OUT
    MOVE 1 TO LS-PTR
    STRING '    {"file": ' DELIMITED BY SIZE INTO LS-OUT WITH POINTER LS-PTR
    CALL "PLB-SRC-FILE-PATH" USING PLB-SOURCE-SET MP-FILE-ID(LS-P) LS-PATH
    CALL "PLB-JSON-STRING" USING LS-PATH LS-OUT LS-PTR
    STRING ', "program": ' DELIMITED BY SIZE INTO LS-OUT WITH POINTER LS-PTR
    CALL "PLB-JSON-STRING" USING MP-NAME(LS-P) LS-OUT LS-PTR
    STRING ', "line": ' DELIMITED BY SIZE INTO LS-OUT WITH POINTER LS-PTR
    MOVE MP-LINE(LS-P) TO LS-NUM
    PERFORM APPEND-NUM
    STRING ',' DELIMITED BY SIZE INTO LS-OUT WITH POINTER LS-PTR
    PERFORM PRINT-LINE
    STRING '     "lines": ' DELIMITED BY SIZE INTO LS-OUT WITH POINTER LS-PTR
    MOVE MP-LINES(LS-P) TO LS-NUM
    PERFORM APPEND-NUM
    STRING ', "codeLines": ' DELIMITED BY SIZE
        INTO LS-OUT WITH POINTER LS-PTR
    MOVE MP-CODE-LINES(LS-P) TO LS-NUM
    PERFORM APPEND-NUM
    STRING ', "commentLines": ' DELIMITED BY SIZE
        INTO LS-OUT WITH POINTER LS-PTR
    MOVE MP-COMMENT-LINES(LS-P) TO LS-NUM
    PERFORM APPEND-NUM
    STRING ', "blankLines": ' DELIMITED BY SIZE
        INTO LS-OUT WITH POINTER LS-PTR
    MOVE MP-BLANK-LINES(LS-P) TO LS-NUM
    PERFORM APPEND-NUM
    STRING ',' DELIMITED BY SIZE INTO LS-OUT WITH POINTER LS-PTR
    PERFORM PRINT-LINE
    STRING '     "statements": ' DELIMITED BY SIZE
        INTO LS-OUT WITH POINTER LS-PTR
    MOVE MP-STATEMENTS(LS-P) TO LS-NUM
    PERFORM APPEND-NUM
    STRING ', "sections": ' DELIMITED BY SIZE
        INTO LS-OUT WITH POINTER LS-PTR
    MOVE MP-SECTIONS(LS-P) TO LS-NUM
    PERFORM APPEND-NUM
    STRING ', "paragraphs": ' DELIMITED BY SIZE
        INTO LS-OUT WITH POINTER LS-PTR
    MOVE MP-PARAGRAPHS(LS-P) TO LS-NUM
    PERFORM APPEND-NUM
    STRING ', "dataItems": ' DELIMITED BY SIZE
        INTO LS-OUT WITH POINTER LS-PTR
    MOVE MP-DATA-ITEMS(LS-P) TO LS-NUM
    PERFORM APPEND-NUM
    STRING ',' DELIMITED BY SIZE INTO LS-OUT WITH POINTER LS-PTR
    PERFORM PRINT-LINE
    STRING '     "complexity": ' DELIMITED BY SIZE
        INTO LS-OUT WITH POINTER LS-PTR
    MOVE MP-COMPLEXITY(LS-P) TO LS-NUM
    PERFORM APPEND-NUM
    STRING ', "nesting": ' DELIMITED BY SIZE INTO LS-OUT WITH POINTER LS-PTR
    MOVE MP-NESTING(LS-P) TO LS-NUM
    PERFORM APPEND-NUM
    STRING ', "goTos": ' DELIMITED BY SIZE INTO LS-OUT WITH POINTER LS-PTR
    MOVE MP-GO-TOS(LS-P) TO LS-NUM
    PERFORM APPEND-NUM
    STRING ', "performs": ' DELIMITED BY SIZE
        INTO LS-OUT WITH POINTER LS-PTR
    MOVE MP-PERFORMS(LS-P) TO LS-NUM
    PERFORM APPEND-NUM
    STRING ', "calls": ' DELIMITED BY SIZE INTO LS-OUT WITH POINTER LS-PTR
    MOVE MP-CALLS(LS-P) TO LS-NUM
    PERFORM APPEND-NUM
    STRING ',' DELIMITED BY SIZE INTO LS-OUT WITH POINTER LS-PTR
    PERFORM PRINT-LINE
    DISPLAY '     "units": ['
    PERFORM VARYING LS-M FROM MP-UNIT-FIRST(LS-P) BY 1
            UNTIL LS-M >= MP-UNIT-FIRST(LS-P) + MP-UNIT-COUNT(LS-P)
        PERFORM WRITE-UNIT
    END-PERFORM
    DISPLAY '     ]}'.

WRITE-UNIT.
    EVALUATE MU-KIND(LS-M)
        WHEN "S"     MOVE "section" TO LS-KIND
        WHEN "P"     MOVE "paragraph" TO LS-KIND
        WHEN OTHER   MOVE "start" TO LS-KIND
    END-EVALUATE
    STRING '       {"kind": "' DELIMITED BY SIZE
           LS-KIND DELIMITED BY SPACE
           '", "name": ' DELIMITED BY SIZE
        INTO LS-OUT WITH POINTER LS-PTR
    CALL "PLB-JSON-STRING" USING MU-NAME(LS-M) LS-OUT LS-PTR
    STRING ', "line": ' DELIMITED BY SIZE INTO LS-OUT WITH POINTER LS-PTR
    MOVE MU-LINE(LS-M) TO LS-NUM
    PERFORM APPEND-NUM
    STRING ', "lines": ' DELIMITED BY SIZE INTO LS-OUT WITH POINTER LS-PTR
    MOVE MU-LINES(LS-M) TO LS-NUM
    PERFORM APPEND-NUM
    STRING ', "statements": ' DELIMITED BY SIZE
        INTO LS-OUT WITH POINTER LS-PTR
    MOVE MU-STATEMENTS(LS-M) TO LS-NUM
    PERFORM APPEND-NUM
    STRING ', "complexity": ' DELIMITED BY SIZE
        INTO LS-OUT WITH POINTER LS-PTR
    MOVE MU-COMPLEXITY(LS-M) TO LS-NUM
    PERFORM APPEND-NUM
    STRING ', "nesting": ' DELIMITED BY SIZE INTO LS-OUT WITH POINTER LS-PTR
    MOVE MU-NESTING(LS-M) TO LS-NUM
    PERFORM APPEND-NUM
    STRING '}' DELIMITED BY SIZE INTO LS-OUT WITH POINTER LS-PTR
    IF LS-M + 1 < MP-UNIT-FIRST(LS-P) + MP-UNIT-COUNT(LS-P)
        STRING ',' DELIMITED BY SIZE INTO LS-OUT WITH POINTER LS-PTR
    END-IF
    PERFORM PRINT-LINE.

APPEND-NUM.
    CALL "PLB-STR-FROM-INT" USING LS-NUM LS-NUM-TEXT LS-NUM-LEN
    STRING LS-NUM-TEXT(1:LS-NUM-LEN) DELIMITED BY SIZE
        INTO LS-OUT WITH POINTER LS-PTR.

PRINT-LINE.
    CALL "PLB-STR-LENGTH" USING LS-OUT LS-LEN
    IF LS-LEN > 0
        DISPLAY LS-OUT(1:LS-LEN)
    END-IF
    MOVE SPACES TO LS-OUT
    MOVE 1 TO LS-PTR.
END PROGRAM PLB-METRICS-JSON.

*> PLB-METRICS-CSV: one row per program and one per unit, after a
*> header row when HEADER is "Y" (set to "N" once written):
*>     file,program,kind,name,line,lines,statements,complexity,nesting
*> A program's row has kind "program" and its name in both columns.
IDENTIFICATION DIVISION.
PROGRAM-ID. PLB-METRICS-CSV.
DATA DIVISION.
WORKING-STORAGE SECTION.
COPY "plbmetrc.cpy".
LOCAL-STORAGE SECTION.
01  LS-P                    PIC 9(4) COMP-5.
01  LS-M                    PIC 9(9) COMP-5.
01  LS-OUT                  PIC X(1024).
01  LS-PTR                  PIC 9(9) COMP-5.
01  LS-LEN                  PIC 9(9) COMP-5.
01  LS-NUM                  PIC S9(18) COMP-5.
01  LS-NUM-TEXT             PIC X(20).
01  LS-NUM-LEN              PIC 9(9) COMP-5.
01  LS-PATH                 PIC X(512).
01  LS-PATH-LEN             PIC 9(9) COMP-5.
01  LS-KIND                 PIC X(9).
01  LS-NAME                 PIC X(31).
LINKAGE SECTION.
COPY "plbsrcc.cpy".
COPY "plbsrc.cpy".
COPY "plbmetr.cpy".
01  LK-HEADER               PIC X.
PROCEDURE DIVISION USING PLB-SOURCE-SET PLB-METRICS LK-HEADER.
    IF LK-HEADER = "Y"
        MOVE "N" TO LK-HEADER
        DISPLAY "file,program,kind,name,line,lines,statements,"
                "complexity,nesting"
    END-IF
    PERFORM VARYING LS-P FROM 1 BY 1 UNTIL LS-P > MP-COUNT
        CALL "PLB-SRC-FILE-PATH" USING PLB-SOURCE-SET MP-FILE-ID(LS-P)
            LS-PATH
        CALL "PLB-STR-LENGTH" USING LS-PATH LS-PATH-LEN
        MOVE "program" TO LS-KIND
        MOVE MP-NAME(LS-P) TO LS-NAME
        MOVE MP-LINE(LS-P) TO LS-NUM
        PERFORM START-ROW
        MOVE MP-LINES(LS-P) TO LS-NUM
        PERFORM APPEND-FIELD
        MOVE MP-STATEMENTS(LS-P) TO LS-NUM
        PERFORM APPEND-FIELD
        MOVE MP-COMPLEXITY(LS-P) TO LS-NUM
        PERFORM APPEND-FIELD
        MOVE MP-NESTING(LS-P) TO LS-NUM
        PERFORM APPEND-FIELD
        PERFORM PRINT-ROW
        PERFORM VARYING LS-M FROM MP-UNIT-FIRST(LS-P) BY 1
                UNTIL LS-M >= MP-UNIT-FIRST(LS-P) + MP-UNIT-COUNT(LS-P)
            EVALUATE MU-KIND(LS-M)
                WHEN "S"     MOVE "section" TO LS-KIND
                WHEN "P"     MOVE "paragraph" TO LS-KIND
                WHEN OTHER   MOVE "start" TO LS-KIND
            END-EVALUATE
            MOVE MU-NAME(LS-M) TO LS-NAME
            MOVE MU-LINE(LS-M) TO LS-NUM
            PERFORM START-ROW
            MOVE MU-LINES(LS-M) TO LS-NUM
            PERFORM APPEND-FIELD
            MOVE MU-STATEMENTS(LS-M) TO LS-NUM
            PERFORM APPEND-FIELD
            MOVE MU-COMPLEXITY(LS-M) TO LS-NUM
            PERFORM APPEND-FIELD
            MOVE MU-NESTING(LS-M) TO LS-NUM
            PERFORM APPEND-FIELD
            PERFORM PRINT-ROW
        END-PERFORM
    END-PERFORM
    GOBACK.

*> file,program,kind,name,line. The path is quoted, with doubled
*> quotes, so that commas in it are safe.
START-ROW.
    MOVE SPACES TO LS-OUT
    MOVE 1 TO LS-PTR
    STRING '"' DELIMITED BY SIZE INTO LS-OUT WITH POINTER LS-PTR
    PERFORM VARYING LS-LEN FROM 1 BY 1 UNTIL LS-LEN > LS-PATH-LEN
        IF LS-PATH(LS-LEN:1) = '"'
            STRING '""' DELIMITED BY SIZE INTO LS-OUT WITH POINTER LS-PTR
        ELSE
            STRING LS-PATH(LS-LEN:1) DELIMITED BY SIZE
                INTO LS-OUT WITH POINTER LS-PTR
        END-IF
    END-PERFORM
    STRING '",' DELIMITED BY SIZE
           MP-NAME(LS-P) DELIMITED BY SPACE
           "," DELIMITED BY SIZE
           LS-KIND DELIMITED BY SPACE
           "," DELIMITED BY SIZE
           LS-NAME DELIMITED BY SPACE
        INTO LS-OUT WITH POINTER LS-PTR
    PERFORM APPEND-FIELD.

APPEND-FIELD.
    STRING "," DELIMITED BY SIZE INTO LS-OUT WITH POINTER LS-PTR
    CALL "PLB-STR-FROM-INT" USING LS-NUM LS-NUM-TEXT LS-NUM-LEN
    STRING LS-NUM-TEXT(1:LS-NUM-LEN) DELIMITED BY SIZE
        INTO LS-OUT WITH POINTER LS-PTR.

PRINT-ROW.
    CALL "PLB-STR-LENGTH" USING LS-OUT LS-LEN
    DISPLAY LS-OUT(1:LS-LEN).
END PROGRAM PLB-METRICS-CSV.
