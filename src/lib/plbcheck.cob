*> ---------------------------------------------------------------
*> plbcheck: running the analysis rules.
*>
*> PLB-CHECK-RUN runs every enabled rule over one analyzed file: its
*> expanded tokens, syntax tree, symbol table, procedure graph, data
*> references, and the copybooks it includes.
*> Each rule is its own program, named after its rule id.
*>
*> The rules of embedded SQL and of CICS commands read the tokens of
*> the whole file for their EXEC blocks; they are run only for a file
*> whose procedure division has an EXEC SQL, or EXEC CICS, statement.
*> (PLB-C018, PLB-C019, and the others of PLB-RULE-EMBEDDED, and
*> PLB-K003, which reads DFHCOMMAREA, run for every file.)
*> ---------------------------------------------------------------
IDENTIFICATION DIVISION.
PROGRAM-ID. PLB-CHECK-RUN.
DATA DIVISION.
LOCAL-STORAGE SECTION.
01  LS-NODE                 PIC 9(9) COMP-5.
01  LS-T                    PIC 9(9) COMP-5.
01  LS-TEXT                 PIC X(31).
01  LS-LEN                  PIC 9(9) COMP-5.
01  LS-HAS-SQL              PIC X VALUE "N".
01  LS-HAS-CICS             PIC X VALUE "N".
LINKAGE SECTION.
COPY "plbsrcc.cpy".
COPY "plbsrc.cpy".
COPY "plbtokc.cpy".
COPY "plbtok.cpy".
COPY "plbastc.cpy".
COPY "plbast.cpy".
COPY "plbsym.cpy".
COPY "plbflow.cpy".
COPY "plbref.cpy".
COPY "plbincl.cpy".
COPY "plbrules.cpy".
COPY "plbfind.cpy".
PROCEDURE DIVISION USING PLB-SOURCE-SET PLB-TOKENS PLB-AST
        PLB-SYMBOLS PLB-FLOW PLB-REFS PLB-INCLUSIONS PLB-RULES
        PLB-FINDINGS.
    PERFORM VARYING LS-NODE FROM 1 BY 1 UNTIL LS-NODE > AS-COUNT
        IF ND-KIND(LS-NODE) = "STMT" AND ND-DETAIL(LS-NODE) = "EXEC"
            COMPUTE LS-T = ND-TOK-FIRST(LS-NODE) + 1
            CALL "PLB-TOK-TEXT" USING PLB-TOKENS LS-T LS-TEXT LS-LEN
            EVALUATE FUNCTION UPPER-CASE(LS-TEXT)
                WHEN "SQL"
                    MOVE "Y" TO LS-HAS-SQL
                WHEN "CICS"
                    MOVE "Y" TO LS-HAS-CICS
            END-EVALUATE
        END-IF
    END-PERFORM
    CALL "PLB-RULE-C001" USING PLB-SOURCE-SET PLB-TOKENS PLB-AST
        PLB-FLOW PLB-RULES PLB-FINDINGS
    CALL "PLB-RULE-C002" USING PLB-SOURCE-SET PLB-TOKENS PLB-AST
        PLB-FLOW PLB-RULES PLB-FINDINGS
    CALL "PLB-RULE-C003" USING PLB-SOURCE-SET PLB-TOKENS PLB-AST
        PLB-FLOW PLB-RULES PLB-FINDINGS
    CALL "PLB-RULE-PERFORM-RANGES" USING PLB-SOURCE-SET PLB-TOKENS
        PLB-AST PLB-FLOW PLB-RULES PLB-FINDINGS
    CALL "PLB-RULE-C029" USING PLB-SOURCE-SET PLB-TOKENS PLB-AST
        PLB-FLOW PLB-RULES PLB-FINDINGS
    CALL "PLB-RULE-C054" USING PLB-SOURCE-SET PLB-TOKENS PLB-AST
        PLB-FLOW PLB-RULES PLB-FINDINGS
    CALL "PLB-RULE-C035" USING PLB-SOURCE-SET PLB-TOKENS PLB-AST
        PLB-FLOW PLB-RULES PLB-FINDINGS
    CALL "PLB-RULE-STATEMENTS" USING PLB-SOURCE-SET PLB-TOKENS PLB-AST
        PLB-RULES PLB-FINDINGS
    CALL "PLB-RULE-C007" USING PLB-SOURCE-SET PLB-TOKENS PLB-SYMBOLS
        PLB-RULES PLB-FINDINGS
    CALL "PLB-RULE-M003" USING PLB-SOURCE-SET PLB-TOKENS PLB-AST
        PLB-SYMBOLS PLB-INCLUSIONS PLB-RULES PLB-FINDINGS
    CALL "PLB-RULE-NAMES" USING PLB-SOURCE-SET PLB-TOKENS PLB-REFS
        PLB-INCLUSIONS PLB-RULES PLB-FINDINGS
    CALL "PLB-RULE-C008" USING PLB-SOURCE-SET PLB-TOKENS PLB-AST
        PLB-SYMBOLS PLB-REFS PLB-RULES PLB-FINDINGS
    CALL "PLB-RULE-C036" USING PLB-SOURCE-SET PLB-TOKENS PLB-AST
        PLB-SYMBOLS PLB-REFS PLB-RULES PLB-FINDINGS
    CALL "PLB-RULE-C041" USING PLB-SOURCE-SET PLB-TOKENS PLB-AST
        PLB-SYMBOLS PLB-REFS PLB-RULES PLB-FINDINGS
    CALL "PLB-RULE-C042" USING PLB-SOURCE-SET PLB-TOKENS PLB-AST
        PLB-SYMBOLS PLB-FLOW PLB-REFS PLB-RULES PLB-FINDINGS
    CALL "PLB-RULE-C044" USING PLB-SOURCE-SET PLB-TOKENS PLB-AST
        PLB-SYMBOLS PLB-FLOW PLB-REFS PLB-RULES PLB-FINDINGS
    CALL "PLB-RULE-C049" USING PLB-SOURCE-SET PLB-TOKENS PLB-AST
        PLB-SYMBOLS PLB-FLOW PLB-REFS PLB-RULES PLB-FINDINGS
    CALL "PLB-RULE-M017" USING PLB-SOURCE-SET PLB-TOKENS PLB-AST
        PLB-RULES PLB-FINDINGS
    CALL "PLB-RULE-C037" USING PLB-SOURCE-SET PLB-TOKENS PLB-AST
        PLB-SYMBOLS PLB-FLOW PLB-REFS PLB-RULES PLB-FINDINGS
    CALL "PLB-RULE-C047" USING PLB-SOURCE-SET PLB-TOKENS PLB-AST
        PLB-SYMBOLS PLB-REFS PLB-RULES PLB-FINDINGS
    CALL "PLB-RULE-C048" USING PLB-SOURCE-SET PLB-TOKENS PLB-AST
        PLB-FLOW PLB-RULES PLB-FINDINGS
    CALL "PLB-RULE-C050" USING PLB-SOURCE-SET PLB-TOKENS PLB-AST
        PLB-SYMBOLS PLB-REFS PLB-RULES PLB-FINDINGS
    CALL "PLB-RULE-C038" USING PLB-SOURCE-SET PLB-TOKENS PLB-AST
        PLB-SYMBOLS PLB-RULES PLB-FINDINGS
    CALL "PLB-RULE-C040" USING PLB-SOURCE-SET PLB-TOKENS PLB-SYMBOLS
        PLB-RULES PLB-FINDINGS
    IF LS-HAS-SQL = "Y"
        CALL "PLB-RULE-SQL-CURSORS" USING PLB-SOURCE-SET PLB-TOKENS
            PLB-RULES PLB-FINDINGS
        CALL "PLB-RULE-Q005" USING PLB-SOURCE-SET PLB-TOKENS
            PLB-SYMBOLS PLB-REFS PLB-RULES PLB-FINDINGS
        CALL "PLB-RULE-SQL-TYPES" USING PLB-SOURCE-SET PLB-TOKENS
            PLB-SYMBOLS PLB-REFS PLB-RULES PLB-FINDINGS
        CALL "PLB-RULE-Q009" USING PLB-SOURCE-SET PLB-TOKENS PLB-RULES
            PLB-FINDINGS
    END-IF
    CALL "PLB-RULE-K003" USING PLB-SOURCE-SET PLB-TOKENS PLB-AST
        PLB-SYMBOLS PLB-REFS PLB-RULES PLB-FINDINGS
    IF LS-HAS-CICS = "Y"
        CALL "PLB-RULE-K004" USING PLB-SOURCE-SET PLB-TOKENS
            PLB-SYMBOLS PLB-REFS PLB-RULES PLB-FINDINGS
        CALL "PLB-RULE-K005" USING PLB-SOURCE-SET PLB-TOKENS PLB-AST
            PLB-RULES PLB-FINDINGS
        CALL "PLB-RULE-K006" USING PLB-SOURCE-SET PLB-TOKENS PLB-AST
            PLB-SYMBOLS PLB-RULES PLB-FINDINGS
        CALL "PLB-RULE-CICS-UPDATES" USING PLB-SOURCE-SET PLB-TOKENS
            PLB-AST PLB-RULES PLB-FINDINGS
    END-IF
    CALL "PLB-RULE-SET-AND-READ" USING PLB-SOURCE-SET PLB-TOKENS
        PLB-AST PLB-SYMBOLS PLB-REFS PLB-RULES PLB-FINDINGS
    CALL "PLB-RULE-USE-BEFORE-SET" USING PLB-SOURCE-SET PLB-TOKENS
        PLB-AST PLB-SYMBOLS PLB-FLOW PLB-REFS PLB-RULES PLB-FINDINGS
    CALL "PLB-RULE-REPORTS" USING PLB-SOURCE-SET PLB-TOKENS PLB-AST
        PLB-RULES PLB-FINDINGS
    CALL "PLB-RULE-EMBEDDED" USING PLB-SOURCE-SET PLB-TOKENS PLB-AST
        PLB-FLOW PLB-RULES PLB-FINDINGS
    CALL "PLB-RULE-FILES" USING PLB-SOURCE-SET PLB-TOKENS PLB-AST
        PLB-SYMBOLS PLB-FLOW PLB-RULES PLB-FINDINGS
    CALL "PLB-RULE-SIZE" USING PLB-SOURCE-SET PLB-TOKENS PLB-AST
        PLB-SYMBOLS PLB-FLOW PLB-RULES PLB-FINDINGS
    CALL "PLB-RULE-SECURITY" USING PLB-SOURCE-SET PLB-TOKENS PLB-AST
        PLB-SYMBOLS PLB-REFS PLB-RULES PLB-FINDINGS
    CALL "PLB-RULE-PORTABILITY" USING PLB-SOURCE-SET PLB-TOKENS
        PLB-AST PLB-SYMBOLS PLB-RULES PLB-FINDINGS
    CALL "PLB-RULE-RANGES" USING PLB-SOURCE-SET PLB-TOKENS
        PLB-SYMBOLS PLB-REFS PLB-RULES PLB-FINDINGS
    CALL "PLB-RULE-LOOPS" USING PLB-SOURCE-SET PLB-TOKENS PLB-AST
        PLB-SYMBOLS PLB-REFS PLB-RULES PLB-FINDINGS
    CALL "PLB-RULE-DEAD-STORE" USING PLB-SOURCE-SET PLB-TOKENS PLB-AST
        PLB-SYMBOLS PLB-REFS PLB-RULES PLB-FINDINGS
    CALL "PLB-RULE-STRINGS" USING PLB-SOURCE-SET PLB-TOKENS PLB-AST
        PLB-SYMBOLS PLB-REFS PLB-RULES PLB-FINDINGS
    CALL "PLB-RULE-C052" USING PLB-SOURCE-SET PLB-TOKENS PLB-AST
        PLB-SYMBOLS PLB-REFS PLB-RULES PLB-FINDINGS
    CALL "PLB-RULE-C055" USING PLB-SOURCE-SET PLB-TOKENS PLB-AST
        PLB-SYMBOLS PLB-REFS PLB-RULES PLB-FINDINGS
    CALL "PLB-RULE-C056" USING PLB-SOURCE-SET PLB-TOKENS PLB-AST
        PLB-SYMBOLS PLB-REFS PLB-RULES PLB-FINDINGS
    CALL "PLB-RULE-C057" USING PLB-SOURCE-SET PLB-TOKENS PLB-AST
        PLB-RULES PLB-FINDINGS
    CALL "PLB-RULE-C060" USING PLB-SOURCE-SET PLB-TOKENS PLB-AST
        PLB-SYMBOLS PLB-REFS PLB-RULES PLB-FINDINGS
    CALL "PLB-RULE-C061" USING PLB-SOURCE-SET PLB-TOKENS PLB-AST
        PLB-SYMBOLS PLB-REFS PLB-RULES PLB-FINDINGS
    CALL "PLB-RULE-C062" USING PLB-SOURCE-SET PLB-TOKENS PLB-AST
        PLB-SYMBOLS PLB-FLOW PLB-REFS PLB-RULES PLB-FINDINGS
    CALL "PLB-RULE-C064" USING PLB-SOURCE-SET PLB-TOKENS PLB-AST
        PLB-SYMBOLS PLB-REFS PLB-RULES PLB-FINDINGS
    CALL "PLB-RULE-C065" USING PLB-SOURCE-SET PLB-TOKENS PLB-AST
        PLB-FLOW PLB-REFS PLB-RULES PLB-FINDINGS
    CALL "PLB-RULE-C066" USING PLB-SOURCE-SET PLB-TOKENS PLB-AST
        PLB-RULES PLB-FINDINGS
    CALL "PLB-RULE-C067" USING PLB-SOURCE-SET PLB-TOKENS PLB-AST
        PLB-SYMBOLS PLB-FLOW PLB-REFS PLB-RULES PLB-FINDINGS
    CALL "PLB-RULE-M019" USING PLB-SOURCE-SET PLB-TOKENS PLB-RULES
        PLB-FINDINGS
    CALL "PLB-RULE-M020" USING PLB-SOURCE-SET PLB-TOKENS PLB-AST
