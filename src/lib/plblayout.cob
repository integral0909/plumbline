*> ---------------------------------------------------------------
*> plblayout: record layouts.
*>
*> plumbline layout lists the records of a program or a copybook with
*> each item's level, name, picture, usage, start position (from 1),
*> length in bytes, and OCCURS count: what a file transfer, a data
*> migration, or a program in another language needs to read the
*> records. The figures are those of the symbol table (plbsym).
*> ---------------------------------------------------------------

*> PLB-LAYOUT-START and PLB-LAYOUT-END open and close the report;
*> PLB-LAYOUT-RECORDS adds the records of one analyzed file. FORMAT is
*> text, json, or csv; FIRST is "Y" before the first JSON record.
IDENTIFICATION DIVISION.
PROGRAM-ID. PLB-LAYOUT-START.
DATA DIVISION.
LINKAGE SECTION.
01  LK-FORMAT               PIC X(5).
PROCEDURE DIVISION USING LK-FORMAT.
    EVALUATE LK-FORMAT
        WHEN "json"
            DISPLAY "{"
            DISPLAY '  "records": ['
        WHEN "csv"
            DISPLAY "record,level,name,picture,usage,start,length,"
                "occurs,redefines"
    END-EVALUATE
    GOBACK.
END PROGRAM PLB-LAYOUT-START.

IDENTIFICATION DIVISION.
PROGRAM-ID. PLB-LAYOUT-END.
DATA DIVISION.
LINKAGE SECTION.
01  LK-FORMAT               PIC X(5).
PROCEDURE DIVISION USING LK-FORMAT.
    IF LK-FORMAT = "json"
        DISPLAY "  ]"
        DISPLAY "}"
    END-IF
    GOBACK.
END PROGRAM PLB-LAYOUT-END.

IDENTIFICATION DIVISION.
PROGRAM-ID. PLB-LAYOUT-RECORDS.
DATA DIVISION.
LOCAL-STORAGE SECTION.
01  LS-S                    PIC 9(9) COMP-5.
01  LS-R                    PIC 9(9) COMP-5.
01  LS-CHILD                PIC 9(9) COMP-5.
01  LS-TOKEN                PIC 9(9) COMP-5.
01  LS-RECORD               PIC 9(9) COMP-5.
01  LS-PICTURE              PIC X(64).
01  LS-NAME                 PIC X(31).
01  LS-PATH                 PIC X(1024).
01  LS-LEN                  PIC 9(9) COMP-5.
01  LS-OUT                  PIC X(2000).
01  LS-PTR                  PIC 9(9) COMP-5.
01  LS-NUM                  PIC S9(18) COMP-5.
01  LS-NUM-TEXT             PIC X(20).
01  LS-NUM-LEN              PIC 9(9) COMP-5.
01  LS-FIRST-FIELD          PIC X.
01  LS-RIGHT                PIC X(7).
01  LS-LEVEL                PIC 99.
*> Text: the column where each heading starts.
01  LS-COLUMNS.
    05  LS-COL-NAME         PIC 9(4) COMP-5 VALUE 9.
    05  LS-COL-PICTURE      PIC 9(4) COMP-5 VALUE 41.
    05  LS-COL-USAGE        PIC 9(4) COMP-5 VALUE 57.
    05  LS-COL-START        PIC 9(4) COMP-5 VALUE 71.
    05  LS-COL-LENGTH       PIC 9(4) COMP-5 VALUE 79.
    05  LS-COL-OCCURS       PIC 9(4) COMP-5 VALUE 87.
LINKAGE SECTION.
COPY "plbsrcc.cpy".
COPY "plbsrc.cpy".
COPY "plbtokc.cpy".
COPY "plbtok.cpy".
COPY "plbastc.cpy".
COPY "plbast.cpy".
COPY "plbsym.cpy".
01  LK-FORMAT               PIC X(5).
01  LK-FIRST                PIC X.
*> The PROG node whose records to list, or 0 for all of the file's.
01  LK-PROGRAM              PIC 9(9) COMP-5.
PROCEDURE DIVISION USING PLB-SOURCE-SET PLB-TOKENS PLB-AST PLB-SYMBOLS
        LK-FORMAT LK-FIRST LK-PROGRAM.
    PERFORM VARYING LS-R FROM 1 BY 1 UNTIL LS-R > SY-COUNT
        IF SY-PARENT(LS-R) = 0 AND SY-NAME-TOKEN(LS-R) > 0
           AND (SY-LEVEL(LS-R) = 1 OR SY-LEVEL(LS-R) = 77)
           AND SY-CATEGORY(LS-R) NOT = "K"
           AND (LK-PROGRAM = 0 OR SY-PROGRAM(LS-R) = LK-PROGRAM)
            MOVE LS-R TO LS-RECORD
            EVALUATE LK-FORMAT
                WHEN "json" PERFORM JSON-RECORD
                WHEN "csv"  PERFORM CSV-RECORD
                WHEN "md"   PERFORM MD-RECORD
                WHEN OTHER  PERFORM TEXT-RECORD
            END-EVALUATE
        END-IF
    END-PERFORM
    GOBACK.

*> Markdown: a heading and a table of the record's items.
MD-RECORD.
    PERFORM START-OUT
    STRING "### " DELIMITED BY SIZE
           SY-NAME(LS-RECORD) DELIMITED BY SPACE
           " (" DELIMITED BY SIZE
        INTO LS-OUT WITH POINTER LS-PTR
    MOVE SY-SIZE(LS-RECORD) TO LS-NUM
    PERFORM APPEND-NUM
    PERFORM APPEND-BYTES
    IF SY-VARIABLE(LS-RECORD) = "Y"
        STRING " at most" DELIMITED BY SIZE
            INTO LS-OUT WITH POINTER LS-PTR
    END-IF
    STRING ")" DELIMITED BY SIZE INTO LS-OUT WITH POINTER LS-PTR
    PERFORM PRINT-OUT
    DISPLAY " "
    DISPLAY "| Level | Name | Picture | Usage | Start | Length | Occurs |"
    DISPLAY "|---|---|---|---|---:|---:|---:|"
    PERFORM VARYING LS-S FROM LS-RECORD BY 1 UNTIL LS-S > SY-COUNT
        IF LS-S > LS-RECORD
           AND (SY-LEVEL(LS-S) = 1 OR SY-LEVEL(LS-S) = 77)
            EXIT PERFORM
        END-IF
        IF SY-LEVEL(LS-S) NOT = 66 AND SY-LEVEL(LS-S) NOT = 88
           AND SY-LEVEL(LS-S) NOT = 78
            PERFORM MD-ITEM
        END-IF
    END-PERFORM
    DISPLAY " ".

MD-ITEM.
    PERFORM ITEM-PICTURE
    PERFORM ITEM-NAME
    PERFORM START-OUT
    *> plumbline: ignore move-truncation -- levels go up to 88
    MOVE SY-LEVEL(LS-S) TO LS-LEVEL
    STRING "| " DELIMITED BY SIZE
           LS-LEVEL DELIMITED BY SIZE
           " | " DELIMITED BY SIZE
           LS-NAME DELIMITED BY SPACE
           " | " DELIMITED BY SIZE
        INTO LS-OUT WITH POINTER LS-PTR
    IF LS-PICTURE NOT = SPACES
        STRING "`" DELIMITED BY SIZE
               LS-PICTURE DELIMITED BY SPACE
               "`" DELIMITED BY SIZE
            INTO LS-OUT WITH POINTER LS-PTR
    END-IF
    STRING " | " DELIMITED BY SIZE
           SY-USAGE(LS-S) DELIMITED BY SPACE
           " | " DELIMITED BY SIZE
        INTO LS-OUT WITH POINTER LS-PTR
    COMPUTE LS-NUM = SY-OFFSET(LS-S) + 1
    PERFORM APPEND-NUM
    STRING " | " DELIMITED BY SIZE INTO LS-OUT WITH POINTER LS-PTR
    MOVE SY-SIZE(LS-S) TO LS-NUM
    PERFORM APPEND-NUM
    STRING " | " DELIMITED BY SIZE INTO LS-OUT WITH POINTER LS-PTR
    IF SY-OCCURS(LS-S) > 0
        MOVE SY-OCCURS(LS-S) TO LS-NUM
        PERFORM APPEND-NUM
    END-IF
    STRING " |" DELIMITED BY SIZE INTO LS-OUT WITH POINTER LS-PTR
    PERFORM PRINT-OUT.

*> The items of record LS-RECORD: it, and the entries after it up to
*> the next record of level 01 or 77, leaving out 66 and 88.
TEXT-RECORD.
    PERFORM START-OUT
    STRING "record " DELIMITED BY SIZE
           SY-NAME(LS-RECORD) DELIMITED BY SPACE
           " " DELIMITED BY SIZE
        INTO LS-OUT WITH POINTER LS-PTR
    MOVE SY-NAME-TOKEN(LS-RECORD) TO LS-TOKEN
    PERFORM APPEND-PLACE
    STRING ", " DELIMITED BY SIZE INTO LS-OUT WITH POINTER LS-PTR
    MOVE SY-SIZE(LS-RECORD) TO LS-NUM
    PERFORM APPEND-NUM
    PERFORM APPEND-BYTES
    IF SY-VARIABLE(LS-RECORD) = "Y"
        STRING " at most" DELIMITED BY SIZE
            INTO LS-OUT WITH POINTER LS-PTR
    END-IF
    PERFORM PRINT-OUT
    MOVE SPACES TO LS-OUT
    MOVE "  level" TO LS-OUT
    MOVE "name" TO LS-OUT(LS-COL-NAME:)
    MOVE "picture" TO LS-OUT(LS-COL-PICTURE:)
    MOVE "usage" TO LS-OUT(LS-COL-USAGE:)
    MOVE "  start" TO LS-OUT(LS-COL-START:)
    MOVE " length" TO LS-OUT(LS-COL-LENGTH:)
    MOVE " occurs" TO LS-OUT(LS-COL-OCCURS:)
    PERFORM PRINT-OUT
    PERFORM VARYING LS-S FROM LS-RECORD BY 1 UNTIL LS-S > SY-COUNT
        IF LS-S > LS-RECORD
           AND (SY-LEVEL(LS-S) = 1 OR SY-LEVEL(LS-S) = 77)
            EXIT PERFORM
        END-IF
        IF SY-LEVEL(LS-S) NOT = 66 AND SY-LEVEL(LS-S) NOT = 88
           AND SY-LEVEL(LS-S) NOT = 78
            PERFORM TEXT-ITEM
        END-IF
    END-PERFORM
    DISPLAY " ".

TEXT-ITEM.
    PERFORM ITEM-PICTURE
    PERFORM ITEM-NAME
    MOVE SPACES TO LS-OUT
    *> Levels as written in COBOL: 01, 05, 77.
    *> plumbline: ignore move-truncation -- levels go up to 88
    MOVE SY-LEVEL(LS-S) TO LS-LEVEL
    MOVE LS-LEVEL TO LS-OUT(3:)
    MOVE LS-NAME TO LS-OUT(LS-COL-NAME:)
    MOVE LS-PICTURE TO LS-OUT(LS-COL-PICTURE:15)
    MOVE SY-USAGE(LS-S) TO LS-OUT(LS-COL-USAGE:13)
    COMPUTE LS-NUM = SY-OFFSET(LS-S) + 1
    PERFORM RIGHT-NUMBER
    MOVE LS-RIGHT TO LS-OUT(LS-COL-START:)
    MOVE SY-SIZE(LS-S) TO LS-NUM
    PERFORM RIGHT-NUMBER
    MOVE LS-RIGHT TO LS-OUT(LS-COL-LENGTH:)
    IF SY-OCCURS(LS-S) > 0
        MOVE SY-OCCURS(LS-S) TO LS-NUM
        PERFORM RIGHT-NUMBER
        MOVE LS-RIGHT TO LS-OUT(LS-COL-OCCURS:)
    END-IF
    PERFORM PRINT-OUT.

*> LS-RIGHT = LS-NUM, right-aligned in 7 characters.
RIGHT-NUMBER.
    CALL "PLB-STR-FROM-INT" USING LS-NUM LS-NUM-TEXT LS-NUM-LEN
    MOVE SPACES TO LS-RIGHT
    IF LS-NUM-LEN <= 7
        MOVE LS-NUM-TEXT(1:LS-NUM-LEN) TO LS-RIGHT(8 - LS-NUM-LEN:)
    ELSE
        MOVE LS-NUM-TEXT TO LS-RIGHT
    END-IF.

CSV-RECORD.
    PERFORM VARYING LS-S FROM LS-RECORD BY 1 UNTIL LS-S > SY-COUNT
        IF LS-S > LS-RECORD
           AND (SY-LEVEL(LS-S) = 1 OR SY-LEVEL(LS-S) = 77)
            EXIT PERFORM
        END-IF
        IF SY-LEVEL(LS-S) NOT = 66 AND SY-LEVEL(LS-S) NOT = 88
           AND SY-LEVEL(LS-S) NOT = 78
            PERFORM ITEM-PICTURE
            PERFORM ITEM-NAME
            PERFORM START-OUT
            STRING SY-NAME(LS-RECORD) DELIMITED BY SPACE
                   "," DELIMITED BY SIZE
                INTO LS-OUT WITH POINTER LS-PTR
            MOVE SY-LEVEL(LS-S) TO LS-NUM
            PERFORM APPEND-NUM
            STRING "," DELIMITED BY SIZE
                   LS-NAME DELIMITED BY SPACE
                   "," DELIMITED BY SIZE
                INTO LS-OUT WITH POINTER LS-PTR
            *> A picture may hold a comma (9,999): quote it.
            IF LS-PICTURE NOT = SPACES
                STRING '"' DELIMITED BY SIZE
                       LS-PICTURE DELIMITED BY SPACE
                       '"' DELIMITED BY SIZE
                    INTO LS-OUT WITH POINTER LS-PTR
            END-IF
            STRING "," DELIMITED BY SIZE
                   SY-USAGE(LS-S) DELIMITED BY SPACE
                   "," DELIMITED BY SIZE
                INTO LS-OUT WITH POINTER LS-PTR
            COMPUTE LS-NUM = SY-OFFSET(LS-S) + 1
            PERFORM APPEND-NUM
            STRING "," DELIMITED BY SIZE INTO LS-OUT WITH POINTER LS-PTR
            MOVE SY-SIZE(LS-S) TO LS-NUM
            PERFORM APPEND-NUM
            STRING "," DELIMITED BY SIZE INTO LS-OUT WITH POINTER LS-PTR
            IF SY-OCCURS(LS-S) > 0
                MOVE SY-OCCURS(LS-S) TO LS-NUM
                PERFORM APPEND-NUM
            END-IF
            STRING "," DELIMITED BY SIZE INTO LS-OUT WITH POINTER LS-PTR
            IF SY-REDEFINES(LS-S) > 0
                STRING SY-NAME(SY-REDEFINES(LS-S)) DELIMITED BY SPACE
                    INTO LS-OUT WITH POINTER LS-PTR
            END-IF
            PERFORM PRINT-OUT
        END-IF
    END-PERFORM.

*> One record as a JSON object, its items on lines of their own.
JSON-RECORD.
    PERFORM START-OUT
    IF LK-FIRST = "N"
        STRING "    ," DELIMITED BY SIZE INTO LS-OUT WITH POINTER LS-PTR
    ELSE
        STRING "     " DELIMITED BY SIZE INTO LS-OUT WITH POINTER LS-PTR
    END-IF
    MOVE "N" TO LK-FIRST
    STRING '{"name": ' DELIMITED BY SIZE INTO LS-OUT WITH POINTER LS-PTR
    CALL "PLB-JSON-STRING" USING SY-NAME(LS-RECORD) LS-OUT LS-PTR
    STRING ', "file": ' DELIMITED BY SIZE INTO LS-OUT WITH POINTER LS-PTR
    MOVE SY-NAME-TOKEN(LS-RECORD) TO LS-TOKEN
    CALL "PLB-SRC-FILE-PATH" USING PLB-SOURCE-SET TK-FILE-ID(LS-TOKEN)
        LS-PATH
    CALL "PLB-JSON-STRING" USING LS-PATH LS-OUT LS-PTR
    STRING ', "line": ' DELIMITED BY SIZE INTO LS-OUT WITH POINTER LS-PTR
    MOVE 0 TO LS-NUM
    IF TK-SRC-LINE(LS-TOKEN) > 0
        MOVE SL-LINE-NO(TK-SRC-LINE(LS-TOKEN)) TO LS-NUM
    END-IF
    PERFORM APPEND-NUM
    STRING ', "length": ' DELIMITED BY SIZE INTO LS-OUT WITH POINTER LS-PTR
    MOVE SY-SIZE(LS-RECORD) TO LS-NUM
    PERFORM APPEND-NUM
    STRING ', "variable": ' DELIMITED BY SIZE
        INTO LS-OUT WITH POINTER LS-PTR
    IF SY-VARIABLE(LS-RECORD) = "Y"
        STRING "true" DELIMITED BY SIZE INTO LS-OUT WITH POINTER LS-PTR
    ELSE
        STRING "false" DELIMITED BY SIZE INTO LS-OUT WITH POINTER LS-PTR
    END-IF
    STRING ', "items": [' DELIMITED BY SIZE
        INTO LS-OUT WITH POINTER LS-PTR
    PERFORM PRINT-OUT
    MOVE "Y" TO LS-FIRST-FIELD
    PERFORM VARYING LS-S FROM LS-RECORD BY 1 UNTIL LS-S > SY-COUNT
        IF LS-S > LS-RECORD
           AND (SY-LEVEL(LS-S) = 1 OR SY-LEVEL(LS-S) = 77)
            EXIT PERFORM
        END-IF
        IF SY-LEVEL(LS-S) NOT = 66 AND SY-LEVEL(LS-S) NOT = 88
           AND SY-LEVEL(LS-S) NOT = 78
            PERFORM JSON-ITEM
        END-IF
    END-PERFORM
    DISPLAY "       ]}".

JSON-ITEM.
    PERFORM ITEM-PICTURE
    PERFORM ITEM-NAME
    PERFORM START-OUT
    IF LS-FIRST-FIELD = "N"
        STRING "        ," DELIMITED BY SIZE
            INTO LS-OUT WITH POINTER LS-PTR
    ELSE
        STRING "         " DELIMITED BY SIZE
            INTO LS-OUT WITH POINTER LS-PTR
    END-IF
    MOVE "N" TO LS-FIRST-FIELD
    STRING '{"level": ' DELIMITED BY SIZE INTO LS-OUT WITH POINTER LS-PTR
    MOVE SY-LEVEL(LS-S) TO LS-NUM
    PERFORM APPEND-NUM
    STRING ', "name": ' DELIMITED BY SIZE INTO LS-OUT WITH POINTER LS-PTR
    CALL "PLB-JSON-STRING" USING LS-NAME LS-OUT LS-PTR
    STRING ', "picture": ' DELIMITED BY SIZE
        INTO LS-OUT WITH POINTER LS-PTR
    IF LS-PICTURE = SPACES
        STRING "null" DELIMITED BY SIZE INTO LS-OUT WITH POINTER LS-PTR
    ELSE
        CALL "PLB-JSON-STRING" USING LS-PICTURE LS-OUT LS-PTR
    END-IF
    STRING ', "usage": ' DELIMITED BY SIZE INTO LS-OUT WITH POINTER LS-PTR
    IF SY-USAGE(LS-S) = SPACES
        STRING "null" DELIMITED BY SIZE INTO LS-OUT WITH POINTER LS-PTR
    ELSE
        CALL "PLB-JSON-STRING" USING SY-USAGE(LS-S) LS-OUT LS-PTR
    END-IF
    STRING ', "start": ' DELIMITED BY SIZE INTO LS-OUT WITH POINTER LS-PTR
    COMPUTE LS-NUM = SY-OFFSET(LS-S) + 1
    PERFORM APPEND-NUM
    STRING ', "length": ' DELIMITED BY SIZE INTO LS-OUT WITH POINTER LS-PTR
    MOVE SY-SIZE(LS-S) TO LS-NUM
    PERFORM APPEND-NUM
    STRING ', "occurs": ' DELIMITED BY SIZE INTO LS-OUT WITH POINTER LS-PTR
    MOVE SY-OCCURS(LS-S) TO LS-NUM
    PERFORM APPEND-NUM
    IF SY-REDEFINES(LS-S) > 0
        STRING ', "redefines": ' DELIMITED BY SIZE
            INTO LS-OUT WITH POINTER LS-PTR
        CALL "PLB-JSON-STRING" USING SY-NAME(SY-REDEFINES(LS-S)) LS-OUT
            LS-PTR
    END-IF
    STRING "}" DELIMITED BY SIZE INTO LS-OUT WITH POINTER LS-PTR
    PERFORM PRINT-OUT.

*> LS-PICTURE = the PICTURE string of item LS-S, or spaces.
ITEM-PICTURE.
    MOVE SPACES TO LS-PICTURE
    MOVE ND-FIRST(SY-NODE(LS-S)) TO LS-CHILD
    PERFORM UNTIL LS-CHILD = 0
        IF ND-KIND(LS-CHILD) = "CLAU" AND ND-DETAIL(LS-CHILD) = "PICTURE"
           AND ND-NAME(LS-CHILD) > 0
            CALL "PLB-TOK-TEXT" USING PLB-TOKENS ND-NAME(LS-CHILD)
                LS-PICTURE LS-LEN
        END-IF
        MOVE ND-NEXT(LS-CHILD) TO LS-CHILD
    END-PERFORM.

*> LS-NAME = the item's name, or FILLER.
ITEM-NAME.
    MOVE SY-NAME(LS-S) TO LS-NAME
    IF LS-NAME = SPACES
        MOVE "FILLER" TO LS-NAME
    END-IF.

*> path:line of token LS-TOKEN.
APPEND-PLACE.
    CALL "PLB-SRC-FILE-PATH" USING PLB-SOURCE-SET TK-FILE-ID(LS-TOKEN)
        LS-PATH
    CALL "PLB-STR-LENGTH" USING LS-PATH LS-LEN
    IF LS-LEN > 0
        STRING LS-PATH(1:LS-LEN) DELIMITED BY SIZE
            INTO LS-OUT WITH POINTER LS-PTR
    END-IF
    STRING ":" DELIMITED BY SIZE INTO LS-OUT WITH POINTER LS-PTR
    MOVE 0 TO LS-NUM
    IF TK-SRC-LINE(LS-TOKEN) > 0
        MOVE SL-LINE-NO(TK-SRC-LINE(LS-TOKEN)) TO LS-NUM
    END-IF
    PERFORM APPEND-NUM.

APPEND-NUM.
    CALL "PLB-STR-FROM-INT" USING LS-NUM LS-NUM-TEXT LS-NUM-LEN
    STRING LS-NUM-TEXT(1:LS-NUM-LEN) DELIMITED BY SIZE
        INTO LS-OUT WITH POINTER LS-PTR.

*> After the size in LS-NUM.
APPEND-BYTES.
    IF LS-NUM = 1
        STRING " byte" DELIMITED BY SIZE INTO LS-OUT WITH POINTER LS-PTR
    ELSE
        STRING " bytes" DELIMITED BY SIZE
            INTO LS-OUT WITH POINTER LS-PTR
    END-IF.

START-OUT.
    MOVE SPACES TO LS-OUT
    MOVE 1 TO LS-PTR.

PRINT-OUT.
    CALL "PLB-STR-LENGTH" USING LS-OUT LS-LEN
    IF LS-LEN > 0
        DISPLAY LS-OUT(1:LS-LEN)
    END-IF.
END PROGRAM PLB-LAYOUT-RECORDS.
