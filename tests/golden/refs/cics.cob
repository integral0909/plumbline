*> Arguments of CICS commands: options that return data set their
*> argument, options that pass data read it, LENGTH does both.
IDENTIFICATION DIVISION.
PROGRAM-ID. CUSTINQ.
DATA DIVISION.
WORKING-STORAGE SECTION.
01  CUST-KEY            PIC X(8).
01  CUST-REC            PIC X(200).
01  REC-LEN             PIC S9(4) COMP VALUE 200.
01  WS-RESP             PIC S9(8) COMP.
01  WS-ABSTIME          PIC S9(15) COMP-3.
01  WS-DATE             PIC X(10).
LINKAGE SECTION.
01  DFHCOMMAREA         PIC X(8).
PROCEDURE DIVISION.
    IF EIBCALEN > 0
        MOVE DFHCOMMAREA TO CUST-KEY
    END-IF
    EXEC CICS READ FILE('CUSTMAST') INTO(CUST-REC)
              RIDFLD(CUST-KEY) LENGTH(REC-LEN) RESP(WS-RESP)
    END-EXEC
    IF WS-RESP NOT = DFHRESP(NORMAL)
        MOVE SPACES TO CUST-REC
    END-IF
    EXEC CICS ASKTIME ABSTIME(WS-ABSTIME) END-EXEC
    EXEC CICS FORMATTIME ABSTIME(WS-ABSTIME) YYYYMMDD(WS-DATE)
    END-EXEC
    EXEC CICS SEND TEXT FROM(CUST-REC) LENGTH(REC-LEN) END-EXEC
    EXEC CICS SEND TEXT FROM(WS-DATE) LENGTH(10) END-EXEC
    EXEC CICS RETURN END-EXEC.
