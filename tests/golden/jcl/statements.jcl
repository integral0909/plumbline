//PAYROLL  JOB (ACCT),'NIGHTLY RUN',CLASS=A,
//             MSGCLASS=X
//* A comment line, and a JOBLIB that belongs to no step.
//JOBLIB   DD DSN=PROD.LOADLIB,DISP=SHR
//EXTRACT  EXEC PGM=PAYEXT,PARM='DATE=TODAY,  KEEP' THIS IS A COMMENT
//INFILE   DD DSN=PROD.PAYROLL.MASTER,
//            DISP=(OLD,KEEP,KEEP)
//OUTFILE  DD DSN=PROD.PAYROLL.EXTRACT(+1),DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSDA,SPACE=(CYL,(5,5),RLSE)
//         DD DSN=PROD.PAYROLL.EXTRA,DISP=SHR
//REPORT   DD SYSOUT=*
//SYSIN    DD *
  THIS LINE IS DATA, NOT JCL
//NOTHING  DD DUMMY
//CARDS    DD DATA,DLM=$$
//THIS LOOKS LIKE JCL BUT IS DATA
$$
//SUMMARY  EXEC PGM=PAYSUM,PARM='A LONG PARAMETER THAT RUNS PAST COLUMN SEVENTY
//             ONE AND GOES ON'
//INFILE   DD DSN=PROD.PAYROLL.EXTRACT(0),DISP=SHR
//BACKUP   EXEC PAYBKUP
//COPY.INPUT DD DSN=PROD.PAYROLL.EXTRACT(0),DISP=SHR
//*
//
//NEXTJOB  JOB CLASS=B
//STEP1    EXEC PROC=INSTRM
