*> PLB-K002 read-update-not-released: a CICS READ UPDATE of a file the
*> program never rewrites, deletes, or unlocks.
IDENTIFICATION DIVISION.
PROGRAM-ID. UPDATES.
DATA DIVISION.
WORKING-STORAGE SECTION.
01  WS-ACCT-FILE        PIC X(8) VALUE "ACCTDAT".
01  WS-TRAN-FILE        PIC X(8) VALUE "TRANSACT".
01  WS-ACCT-ID          PIC 9(11).
01  WS-TRAN-ID          PIC X(16).
01  ACCT-RECORD         PIC X(300).
01  TRAN-RECORD         PIC X(350).
01  WS-RESP             PIC S9(8) COMP.
PROCEDURE DIVISION.
    EXEC CICS READ FILE(WS-ACCT-FILE) INTO(ACCT-RECORD)
         RIDFLD(WS-ACCT-ID) UPDATE RESP(WS-RESP)
    END-EXEC
    IF WS-RESP = DFHRESP(NORMAL)
        EXEC CICS REWRITE FILE(WS-ACCT-FILE) FROM(ACCT-RECORD)
             RESP(WS-RESP)
        END-EXEC
    END-IF
    EXEC CICS READ DATASET(WS-TRAN-FILE) INTO(TRAN-RECORD)
         RIDFLD(WS-TRAN-ID) UPDATE RESP(WS-RESP)
    END-EXEC
    EXEC CICS READ FILE('CUSTDAT') INTO(ACCT-RECORD)
         RIDFLD(WS-ACCT-ID) UPDATE RESP(WS-RESP)
    END-EXEC
    IF WS-RESP = DFHRESP(NORMAL)
        EXEC CICS UNLOCK FILE('CUSTDAT') RESP(WS-RESP) END-EXEC
    END-IF
    EXEC CICS READ FILE('CARDDAT') INTO(ACCT-RECORD)
         RIDFLD(WS-ACCT-ID) RESP(WS-RESP)
    END-EXEC
    IF WS-RESP NOT = DFHRESP(NORMAL)
        DISPLAY TRAN-RECORD
    END-IF
    EXEC CICS RETURN END-EXEC.
