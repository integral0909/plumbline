*> PLB-Q002 cursor-not-closed and PLB-Q003 cursor-not-opened.
IDENTIFICATION DIVISION.
PROGRAM-ID. CURSORS.
DATA DIVISION.
WORKING-STORAGE SECTION.
    EXEC SQL INCLUDE SQLCA END-EXEC.
    EXEC SQL DECLARE ORDERS TABLE
        ( ORDER_ID  CHAR(8) NOT NULL,
          STATUS    CHAR(1) NOT NULL )
    END-EXEC.
    EXEC SQL DECLARE C-PAIRED CURSOR FOR
        SELECT ORDER_ID FROM ORDERS
    END-EXEC.
    EXEC SQL DECLARE C-LEFT-OPEN CURSOR WITH HOLD FOR
        SELECT ORDER_ID FROM ORDERS WHERE STATUS = 'O'
    END-EXEC.
    EXEC SQL DECLARE C-NEVER-OPENED SCROLL CURSOR FOR
        SELECT ORDER_ID FROM ORDERS WHERE STATUS = 'C'
    END-EXEC.
01  WS-ORDER-ID         PIC X(8).
PROCEDURE DIVISION.
    EXEC SQL OPEN C-PAIRED END-EXEC
    IF SQLCODE = 0
        EXEC SQL FETCH C-PAIRED INTO :WS-ORDER-ID END-EXEC
    END-IF
    EXEC SQL CLOSE C-PAIRED END-EXEC
    EXEC SQL OPEN C-LEFT-OPEN END-EXEC
    IF SQLCODE = 0
        EXEC SQL FETCH NEXT FROM C-LEFT-OPEN INTO :WS-ORDER-ID END-EXEC
    END-IF
    IF SQLCODE = 0
        EXEC SQL FETCH FIRST FROM C-NEVER-OPENED INTO :WS-ORDER-ID
        END-EXEC
    END-IF
    IF SQLCODE = 0
        DISPLAY WS-ORDER-ID
    END-IF
    GOBACK.
