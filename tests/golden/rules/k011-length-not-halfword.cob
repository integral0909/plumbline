*> PLB-K011 length-not-halfword: a CICS LENGTH that is not a halfword
*> binary item, or an FLENGTH that is not a fullword.
IDENTIFICATION DIVISION.
PROGRAM-ID. LENSIZE.
DATA DIVISION.
WORKING-STORAGE SECTION.
01  WS-LEN-FULL         PIC S9(8) COMP.
01  WS-LEN-NUM          PIC 9(4).
01  WS-LEN              PIC S9(4) COMP.
01  WS-FLEN-HALF        PIC S9(4) COMP.
01  WS-FLEN             PIC S9(8) COMP.
01  WS-RESP             PIC S9(8) COMP.
01  WS-RECORD           PIC X(80).
01  WS-KEY              PIC X(11).
PROCEDURE DIVISION.
    *> Reported: a fullword and a display number in LENGTH, and a
    *> halfword in FLENGTH.
    EXEC CICS READ FILE('ACCTDAT') INTO(WS-RECORD) RIDFLD(WS-KEY)
         LENGTH(WS-LEN-FULL) RESP(WS-RESP)
    END-EXEC
    EXEC CICS WRITEQ TS QUEUE('TEMPQ') FROM(WS-RECORD)
         LENGTH(WS-LEN-NUM) RESP(WS-RESP)
    END-EXEC
    EXEC CICS PUT CONTAINER('DATA') FROM(WS-RECORD)
         FLENGTH(WS-FLEN-HALF) RESP(WS-RESP)
    END-EXEC
    *> Reported: a fullword ITEM and NUMITEMS of READQ TS.
    EXEC CICS READQ TS QUEUE('TEMPQ') INTO(WS-RECORD)
         ITEM(WS-LEN-FULL) NUMITEMS(WS-LEN-FULL) RESP(WS-RESP)
    END-EXEC
    *> Not reported: a halfword, a fullword in FLENGTH, LENGTH OF, and
    *> a number.
    EXEC CICS READ FILE('ACCTDAT') INTO(WS-RECORD) RIDFLD(WS-KEY)
         LENGTH(WS-LEN) RESP(WS-RESP)
    END-EXEC
    EXEC CICS PUT CONTAINER('DATA') FROM(WS-RECORD)
         FLENGTH(WS-FLEN) RESP(WS-RESP)
    END-EXEC
    EXEC CICS WRITEQ TS QUEUE('TEMPQ') FROM(WS-RECORD)
         LENGTH(LENGTH OF WS-RECORD) RESP(WS-RESP)
    END-EXEC
    EXEC CICS WRITEQ TS QUEUE('TEMPQ') FROM(WS-RECORD)
         LENGTH(80) RESP(WS-RESP)
    END-EXEC
    EXEC CICS READQ TS QUEUE('TEMPQ') INTO(WS-RECORD)
         ITEM(WS-LEN) NUMITEMS(WS-LEN) RESP(WS-RESP)
    END-EXEC
    GOBACK.
