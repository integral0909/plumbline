*> PLB-Q028 order-by-for-update: a cursor declared with both ORDER BY
*> and FOR UPDATE.
IDENTIFICATION DIVISION.
PROGRAM-ID. ORDUPD.
DATA DIVISION.
WORKING-STORAGE SECTION.
    *> Reported.
    EXEC SQL
        DECLARE ACCT-CUR CURSOR FOR
            SELECT ACCT_ID, BALANCE FROM ACCOUNT
             ORDER BY ACCT_ID
               FOR UPDATE OF BALANCE
    END-EXEC.
    *> Not reported: ORDER BY in a subquery, a cursor that only orders,
    *> and a static sensitive scrollable cursor.
    EXEC SQL
        DECLARE BIG-CUR CURSOR FOR
            SELECT ACCT_ID FROM ACCOUNT
             WHERE BALANCE > (SELECT MAX(B) FROM (SELECT BALANCE AS B
                    FROM HISTORY ORDER BY BALANCE FETCH FIRST 1 ROW ONLY)
                    AS H)
               FOR UPDATE
    END-EXEC.
    EXEC SQL
        DECLARE LIST-CUR CURSOR FOR
            SELECT ACCT_ID FROM ACCOUNT ORDER BY ACCT_ID
    END-EXEC.
    EXEC SQL
        DECLARE SCROLL-CUR SENSITIVE STATIC SCROLL CURSOR FOR
            SELECT ACCT_ID FROM ACCOUNT ORDER BY ACCT_ID
               FOR UPDATE
    END-EXEC.
PROCEDURE DIVISION.
    EXEC SQL OPEN ACCT-CUR END-EXEC
    EXEC SQL OPEN BIG-CUR END-EXEC
    EXEC SQL OPEN LIST-CUR END-EXEC
    EXEC SQL OPEN SCROLL-CUR END-EXEC
    STOP RUN.
