//* PLB-J011 dd-name-repeated: a step with the same DD name twice.
//POSTING  JOB (ACCT),'POSTING',CLASS=A
//POST     EXEC PGM=IEFBR14
//TRANFILE DD DSN=PROD.TRANSACT.DAILY,DISP=SHR
//XREFFILE DD DSN=PROD.CARDXREF,DISP=SHR
//* Reported: the second TRANFILE.
//TRANFILE DD DSN=PROD.TRANSACT.BACKUP,DISP=SHR
//* Not reported: a concatenation, and the same name in another step.
//INPUT    DD DSN=PROD.INPUT.PART1,DISP=SHR
//         DD DSN=PROD.INPUT.PART2,DISP=SHR
//REPORT   EXEC PGM=IEFBR14
//TRANFILE DD DSN=PROD.TRANSACT.DAILY,DISP=SHR
