*> PLB-K017 tsq-option-invalid: WRITEQ TS with REWRITE and no ITEM, or
*> a LENGTH of 0 or above 32763.
IDENTIFICATION DIVISION.
PROGRAM-ID. TSQOPT.
DATA DIVISION.
WORKING-STORAGE SECTION.
01  WS-RESP             PIC S9(8) COMP.
01  WS-ITEM             PIC S9(4) COMP VALUE 1.
01  WS-LEN              PIC S9(4) COMP VALUE 80.
01  WS-RECORD           PIC X(80) VALUE SPACES.
PROCEDURE DIVISION.
    *> Reported: REWRITE without ITEM, LENGTH(0), and LENGTH(40000).
    EXEC CICS WRITEQ TS QUEUE('PAYQ') FROM(WS-RECORD) REWRITE
        RESP(WS-RESP) END-EXEC
    EXEC CICS WRITEQ TS QUEUE('PAYQ') FROM(WS-RECORD) LENGTH(0)
        RESP(WS-RESP) END-EXEC
    EXEC CICS WRITEQ TS QUEUE('PAYQ') FROM(WS-RECORD) LENGTH(40000)
        RESP(WS-RESP) END-EXEC
    *> Not reported: REWRITE with ITEM, a LENGTH in range, an item, and
    *> a transient data queue.
    EXEC CICS WRITEQ TS QUEUE('PAYQ') FROM(WS-RECORD) ITEM(WS-ITEM)
        REWRITE RESP(WS-RESP) END-EXEC
    EXEC CICS WRITEQ TS QUEUE('PAYQ') FROM(WS-RECORD) LENGTH(80)
        RESP(WS-RESP) END-EXEC
    EXEC CICS WRITEQ TS QUEUE('PAYQ') FROM(WS-RECORD) LENGTH(WS-LEN)
        RESP(WS-RESP) END-EXEC
    EXEC CICS WRITEQ TD QUEUE('CSSL') FROM(WS-RECORD) LENGTH(80)
        RESP(WS-RESP) END-EXEC
    EXEC CICS RETURN END-EXEC.
