*> PLB-K015 time-option-out-of-range: HOURS, MINUTES, SECONDS, or
*> MILLISECS of DELAY or START outside its range.
IDENTIFICATION DIVISION.
PROGRAM-ID. TIMEOPT.
DATA DIVISION.
WORKING-STORAGE SECTION.
01  WS-RESP             PIC S9(8) COMP.
01  WS-WAIT             PIC S9(8) COMP VALUE 90.
PROCEDURE DIVISION.
    *> Reported: 90 seconds with minutes, 100 hours, 6000 minutes
    *> alone, and 1000 milliseconds with seconds.
    EXEC CICS DELAY FOR MINUTES(1) SECONDS(90) RESP(WS-RESP)
    END-EXEC
    EXEC CICS START TRANSID('PAYR') AFTER HOURS(100) RESP(WS-RESP)
    END-EXEC
    EXEC CICS DELAY FOR MINUTES(6000) RESP(WS-RESP) END-EXEC
    EXEC CICS DELAY FOR SECONDS(1) MILLISECS(1000) RESP(WS-RESP)
    END-EXEC
    *> Not reported: 90 seconds alone, 5999 minutes alone, values in
    *> range together, and an item.
    EXEC CICS DELAY FOR SECONDS(90) RESP(WS-RESP) END-EXEC
    EXEC CICS START TRANSID('PAYR') AFTER MINUTES(5999) RESP(WS-RESP)
    END-EXEC
    EXEC CICS DELAY UNTIL HOURS(23) MINUTES(59) SECONDS(59)
        RESP(WS-RESP) END-EXEC
    EXEC CICS DELAY FOR SECONDS(WS-WAIT) RESP(WS-RESP) END-EXEC
    EXEC CICS RETURN END-EXEC.
