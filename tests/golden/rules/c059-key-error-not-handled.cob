*> PLB-C059 key-error-not-handled.
IDENTIFICATION DIVISION.
PROGRAM-ID. KEYS.
ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT CUST-FILE ASSIGN TO "CUSTOMER"
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS CUST-KEY.
    SELECT SLOT-FILE ASSIGN TO "SLOTS"
        ORGANIZATION IS RELATIVE
        ACCESS MODE IS SEQUENTIAL
        RELATIVE KEY IS WS-SLOT.
    SELECT REPORT-FILE ASSIGN TO "REPORT"
        ORGANIZATION IS LINE SEQUENTIAL.
DATA DIVISION.
FILE SECTION.
FD  CUST-FILE.
01  CUST-REC.
    05  CUST-KEY        PIC X(8).
    05  CUST-NAME       PIC X(30).
FD  SLOT-FILE.
01  SLOT-REC            PIC X(10).
FD  REPORT-FILE.
01  REPORT-LINE         PIC X(80).
WORKING-STORAGE SECTION.
01  WS-SLOT             PIC 9(4) VALUE 1.
PROCEDURE DIVISION.
    OPEN I-O CUST-FILE SLOT-FILE
    OPEN OUTPUT REPORT-FILE
    MOVE "C0000001" TO CUST-KEY
    MOVE "ACME" TO CUST-NAME
    *> Reported: a duplicate key stops the run.
    WRITE CUST-REC
    *> Fine: INVALID KEY.
    REWRITE CUST-REC
        INVALID KEY DISPLAY "NO CUSTOMER " CUST-KEY
    END-REWRITE
    *> Reported: START and random DELETE.
    START CUST-FILE KEY >= CUST-KEY
    DELETE CUST-FILE RECORD
    *> Fine: DELETE in sequential access takes no INVALID KEY, and a
    *> line sequential file has no keys.
    READ SLOT-FILE NEXT
        AT END DISPLAY "NO SLOTS"
    END-READ
    DELETE SLOT-FILE RECORD
    WRITE REPORT-LINE FROM CUST-REC
    CLOSE CUST-FILE SLOT-FILE REPORT-FILE
    GOBACK.
