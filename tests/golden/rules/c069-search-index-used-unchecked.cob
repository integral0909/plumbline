*> PLB-C069 search-index-used-unchecked: the index of a SEARCH without
*> AT END used after it, as if an entry had been found.
IDENTIFICATION DIVISION.
PROGRAM-ID. RATES.
DATA DIVISION.
WORKING-STORAGE SECTION.
01  RATE-TABLE.
    05  RATE-ENTRY      OCCURS 10 INDEXED BY RATE-IX.
        10  RATE-CODE   PIC X(2).
        10  RATE-VALUE  PIC 9V999.
01  WS-CODE             PIC X(2) VALUE "AB".
01  WS-RATE             PIC 9V999 VALUE 0.
01  WS-FOUND            PIC X VALUE "N".
01  WS-SLOT             PIC 99 VALUE 0.
PROCEDURE DIVISION.
REPORTED.
    MOVE SPACES TO RATE-TABLE
    SET RATE-IX TO 1
    SEARCH RATE-ENTRY
        WHEN RATE-CODE (RATE-IX) = WS-CODE
            CONTINUE
    END-SEARCH
    MOVE RATE-VALUE (RATE-IX) TO WS-RATE.
VARYING-ITEM.
    SET RATE-IX TO 1
    SEARCH RATE-ENTRY VARYING WS-SLOT
        WHEN RATE-CODE (RATE-IX) = WS-CODE
            CONTINUE
    END-SEARCH
    DISPLAY RATE-CODE (WS-SLOT).
NOT-REPORTED.
    *> AT END handles the miss.
    SET RATE-IX TO 1
    SEARCH RATE-ENTRY
        AT END MOVE 0 TO WS-RATE
        WHEN RATE-CODE (RATE-IX) = WS-CODE
            MOVE RATE-VALUE (RATE-IX) TO WS-RATE
    END-SEARCH
    *> A flag tested first, and an index set again first.
    SET RATE-IX TO 1
    SEARCH RATE-ENTRY
        WHEN RATE-CODE (RATE-IX) = WS-CODE
            MOVE "Y" TO WS-FOUND
    END-SEARCH
    IF WS-FOUND = "Y"
        MOVE RATE-VALUE (RATE-IX) TO WS-RATE
    END-IF
    SEARCH RATE-ENTRY
        WHEN RATE-CODE (RATE-IX) = WS-CODE
            CONTINUE
    END-SEARCH
    SET RATE-IX TO 1
    MOVE RATE-VALUE (RATE-IX) TO WS-RATE
    STOP RUN.
