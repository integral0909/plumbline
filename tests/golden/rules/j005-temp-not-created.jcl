//TEMPS    JOB CLASS=A
//* PLB-J005: &&SORTED is created by SORT and read by COPY; &&LOST is
//* read but never created, and &&LATE only by a later step.
//SORT     EXEC PGM=SORT
//SORTIN   DD DSN=PAY.HISTORY(0),DISP=SHR
//SORTOUT  DD DSN=&&SORTED,DISP=(NEW,PASS)
//COPY     EXEC PGM=IEBGENER
//SYSUT1   DD DSN=&&SORTED,DISP=(OLD,DELETE)
//         DD DSN=&&LOST,DISP=(OLD,DELETE)
//SYSUT2   DD DSN=PAY.HISTORY(+1),DISP=(NEW,CATLG)
//READ     EXEC PGM=IEBGENER
//SYSUT1   DD DSN=&&LATE,DISP=SHR
//SYSUT2   DD SYSOUT=*
//MAKE     EXEC PGM=IEFBR14
//LATE     DD DSN=&&LATE,DISP=(NEW,PASS)
