*> PLB-Q030 for-update-read-only: a cursor declared FOR UPDATE whose
*> result table cannot be changed.
IDENTIFICATION DIVISION.
PROGRAM-ID. READONLY.
DATA DIVISION.
WORKING-STORAGE SECTION.
    *> Reported: a join, DISTINCT, a column function, GROUP BY, and
    *> UNION.
    EXEC SQL
        DECLARE JOIN-CUR CURSOR FOR
            SELECT A.ACCT_ID FROM ACCOUNT A, HISTORY H
             WHERE A.ACCT_ID = H.ACCT_ID
               FOR UPDATE
    END-EXEC.
    EXEC SQL
        DECLARE DIST-CUR CURSOR FOR
            SELECT DISTINCT BRANCH FROM ACCOUNT FOR UPDATE
    END-EXEC.
    EXEC SQL
        DECLARE SUM-CUR CURSOR FOR
            SELECT SUM(BALANCE) FROM ACCOUNT FOR UPDATE
    END-EXEC.
    EXEC SQL
        DECLARE GROUP-CUR CURSOR FOR
            SELECT BRANCH FROM ACCOUNT GROUP BY BRANCH FOR UPDATE
    END-EXEC.
    EXEC SQL
        DECLARE BOTH-CUR CURSOR FOR
            SELECT ACCT_ID FROM ACCOUNT
            UNION
            SELECT ACCT_ID FROM HISTORY
               FOR UPDATE
    END-EXEC.
    *> Not reported: one table with DISTINCT and MAX in a subquery, and
    *> a join without FOR UPDATE.
    EXEC SQL
        DECLARE BIG-CUR CURSOR FOR
            SELECT ACCT_ID, BALANCE FROM ACCOUNT
             WHERE BALANCE > (SELECT MAX(BALANCE) FROM HISTORY)
               AND BRANCH IN (SELECT DISTINCT BRANCH FROM HISTORY)
               FOR UPDATE OF BALANCE
    END-EXEC.
    EXEC SQL
        DECLARE LIST-CUR CURSOR FOR
            SELECT A.ACCT_ID FROM ACCOUNT A, HISTORY H
             WHERE A.ACCT_ID = H.ACCT_ID
    END-EXEC.
PROCEDURE DIVISION.
    EXEC SQL OPEN JOIN-CUR END-EXEC
    EXEC SQL OPEN DIST-CUR END-EXEC
    EXEC SQL OPEN SUM-CUR END-EXEC
    EXEC SQL OPEN GROUP-CUR END-EXEC
    EXEC SQL OPEN BOTH-CUR END-EXEC
    EXEC SQL OPEN BIG-CUR END-EXEC
    EXEC SQL OPEN LIST-CUR END-EXEC
    STOP RUN.
