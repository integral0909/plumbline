*> Results of SQL statements and CICS commands that nothing checks,
*> next to ones that are checked in place, in a performed paragraph,
*> or by WHENEVER SQLERROR; and dynamic SQL.
IDENTIFICATION DIVISION.
PROGRAM-ID. EMBEDDED.
DATA DIVISION.
WORKING-STORAGE SECTION.
    EXEC SQL INCLUDE SQLCA END-EXEC.
01  CUST-ID         PIC X(8) VALUE "C1".
01  CUST-NAME       PIC X(30).
01  SQL-TEXT        PIC X(200) VALUE "DELETE FROM CUSTOMER".
01  WS-RESP         PIC S9(8) COMP.
01  CUST-REC        PIC X(100).
PROCEDURE DIVISION.
MAIN-LINE.
*>  Not checked: the next statement is more SQL.
    EXEC SQL SELECT NAME INTO :CUST-NAME FROM CUSTOMER
             WHERE ID = :CUST-ID END-EXEC
    EXEC SQL UPDATE CUSTOMER SET SEEN = 'Y' WHERE ID = :CUST-ID
    END-EXEC
    IF SQLCODE NOT = 0
        DISPLAY "UPDATE FAILED"
    END-IF
*>  Checked in a performed paragraph.
    EXEC SQL DELETE FROM CUSTOMER WHERE ID = :CUST-ID END-EXEC
    PERFORM CHECK-SQL
*>  Dynamic SQL, checked by the WHENEVER in force.
    EXEC SQL WHENEVER SQLERROR GO TO SQL-FAILED END-EXEC
    EXEC SQL EXECUTE IMMEDIATE :SQL-TEXT END-EXEC
    EXEC SQL WHENEVER SQLERROR CONTINUE END-EXEC
*>  RESP tested, RESP not tested, and NOHANDLE alone.
    EXEC CICS READ FILE('CUST') INTO(CUST-REC) RIDFLD(CUST-ID)
         RESP(WS-RESP) END-EXEC
    IF WS-RESP NOT = DFHRESP(NORMAL)
        DISPLAY CUST-NAME
    END-IF
    EXEC CICS WRITE FILE('LOG') FROM(CUST-REC) RIDFLD(CUST-ID)
         RESP(WS-RESP) END-EXEC
    EXEC CICS DELETE FILE('TEMP') RIDFLD(CUST-ID) NOHANDLE END-EXEC
    EXEC CICS RETURN END-EXEC.
CHECK-SQL.
    IF SQLCODE NOT = 0
        DISPLAY "SQL ERROR " SQLCODE
    END-IF.
SQL-FAILED.
    DISPLAY "SQL FAILED"
    EXEC CICS RETURN END-EXEC.
