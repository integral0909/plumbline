*> File I/O: statuses tested and not, a file used but never opened,
*> statements the open modes do not allow, and a file never closed.
IDENTIFICATION DIVISION.
PROGRAM-ID. FILES.
ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT CUST-FILE ASSIGN TO "CUST"
        ORGANIZATION IS INDEXED ACCESS IS DYNAMIC
        RECORD KEY IS CUST-KEY
        FILE STATUS IS CUST-STATUS.
    SELECT REPORT-FILE ASSIGN TO "REPORT"
        FILE STATUS IS REPORT-STATUS.
    SELECT LOG-FILE ASSIGN TO "LOG"
        FILE STATUS IS LOG-STATUS.
    SELECT AUDIT-FILE ASSIGN TO "AUDIT".
DATA DIVISION.
FILE SECTION.
FD  CUST-FILE.
01  CUST-REC.
    05  CUST-KEY        PIC X(8).
    05  CUST-NAME       PIC X(30).
FD  REPORT-FILE.
01  REPORT-LINE         PIC X(80).
FD  LOG-FILE.
01  LOG-LINE            PIC X(80).
FD  AUDIT-FILE.
01  AUDIT-LINE          PIC X(80).
WORKING-STORAGE SECTION.
01  CUST-STATUS         PIC XX.
    88  CUST-OK         VALUE "00".
01  REPORT-STATUS       PIC XX.
01  LOG-STATUS          PIC XX.
PROCEDURE DIVISION.
MAIN-LINE.
*>  Tested through its condition name.
    OPEN INPUT CUST-FILE
    IF NOT CUST-OK
        STOP RUN
    END-IF
*>  Not tested: the next statement on REPORT-FILE comes first.
    OPEN OUTPUT REPORT-FILE
    WRITE REPORT-LINE FROM "HEADER"
    PERFORM CHECK-REPORT
*>  INVALID KEY handles the error; but CUST-FILE is opened only INPUT.
    READ CUST-FILE KEY IS CUST-KEY
        INVALID KEY DISPLAY "NO CUSTOMER"
    END-READ
    REWRITE CUST-REC
    IF NOT CUST-OK
        DISPLAY "REWRITE FAILED"
    END-IF
*>  AUDIT-FILE is never opened.
    WRITE AUDIT-LINE FROM CUST-NAME
*>  LOG-FILE is opened, never closed, and its status is never tested.
    OPEN EXTEND LOG-FILE
    WRITE LOG-LINE FROM CUST-NAME
    CLOSE CUST-FILE REPORT-FILE
    STOP RUN.
CHECK-REPORT.
    IF REPORT-STATUS NOT = "00"
        DISPLAY "REPORT WRITE FAILED"
    END-IF.
