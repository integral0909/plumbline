*> PLB-Q010 cursor-undeclared.
IDENTIFICATION DIVISION.
PROGRAM-ID. UNDECL.
DATA DIVISION.
WORKING-STORAGE SECTION.
    EXEC SQL INCLUDE SQLCA END-EXEC.
    EXEC SQL DECLARE ORDERS TABLE
        ( ORDER_ID  CHAR(8) NOT NULL )
    END-EXEC.
    EXEC SQL DECLARE ORDER-CUR CURSOR FOR
        SELECT ORDER_ID FROM ORDERS
    END-EXEC.
01  WS-ORDER-ID         PIC X(8).
01  WS-ROW              PIC S9(9) COMP VALUE 2.
01  WS-LOCATOR          PIC S9(9) COMP VALUE 0.
PROCEDURE DIVISION.
    EXEC SQL OPEN ORDER-CUR END-EXEC
    IF SQLCODE = 0
        EXEC SQL FETCH ORDER-CUR INTO :WS-ORDER-ID END-EXEC
    END-IF
    IF SQLCODE = 0
        EXEC SQL FETCH ABSOLUTE :WS-ROW ORDERCUR INTO :WS-ORDER-ID
        END-EXEC
    END-IF
    IF SQLCODE = 0
        EXEC SQL FETCH NEXT FROM ORDER-CURS INTO :WS-ORDER-ID END-EXEC
    END-IF
    IF SQLCODE = 0
        EXEC SQL CLOSE ORDER-CRS END-EXEC
    END-IF
    EXEC SQL CLOSE ORDER-CUR END-EXEC
    IF SQLCODE = 0
        EXEC SQL ALLOCATE PROC-CUR CURSOR FOR RESULT SET :WS-LOCATOR
        END-EXEC
    END-IF
    IF SQLCODE = 0
        EXEC SQL FETCH PROC-CUR INTO :WS-ORDER-ID END-EXEC
    END-IF
    IF SQLCODE = 0
        EXEC SQL CLOSE PROC-CUR END-EXEC
    END-IF
    IF SQLCODE = 0
        DISPLAY WS-ORDER-ID
    END-IF
    GOBACK.
