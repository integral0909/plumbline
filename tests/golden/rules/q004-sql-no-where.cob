*> PLB-Q004 sql-no-where: UPDATE or DELETE without WHERE. A WHERE in a
*> subquery does not count; WHERE CURRENT OF does.
IDENTIFICATION DIVISION.
PROGRAM-ID. NOWHERE.
DATA DIVISION.
WORKING-STORAGE SECTION.
    EXEC SQL INCLUDE SQLCA END-EXEC.
    EXEC SQL DECLARE ORDERS TABLE
        ( ORDER_ID  CHAR(8) NOT NULL,
          STATUS    CHAR(1) NOT NULL )
    END-EXEC.
    EXEC SQL DECLARE ARCHIVE TABLE
        ( ORDER_ID  CHAR(8) NOT NULL )
    END-EXEC.
    EXEC SQL DECLARE C-ORDERS CURSOR FOR
        SELECT ORDER_ID FROM ORDERS FOR UPDATE OF STATUS
    END-EXEC.
01  WS-ORDER-ID         PIC X(8).
PROCEDURE DIVISION.
    EXEC SQL UPDATE ORDERS SET STATUS = 'C' END-EXEC
    IF SQLCODE NOT = 0
        DISPLAY "UPDATE FAILED"
    END-IF
    EXEC SQL DELETE FROM ORDERS
        WHERE ORDER_ID = :WS-ORDER-ID
    END-EXEC
    IF SQLCODE NOT = 0
        DISPLAY "DELETE FAILED"
    END-IF
    EXEC SQL DELETE FROM ARCHIVE
        WHERE ORDER_ID IN (SELECT ORDER_ID FROM ORDERS)
    END-EXEC
    IF SQLCODE NOT = 0
        DISPLAY "DELETE FAILED"
    END-IF
    EXEC SQL UPDATE ORDERS SET STATUS =
        (SELECT MAX(STATUS) FROM ORDERS WHERE ORDER_ID = 'X')
    END-EXEC
    IF SQLCODE NOT = 0
        DISPLAY "UPDATE FAILED"
    END-IF
    EXEC SQL OPEN C-ORDERS END-EXEC
    IF SQLCODE = 0
        EXEC SQL FETCH C-ORDERS INTO :WS-ORDER-ID END-EXEC
        IF SQLCODE = 0
            EXEC SQL UPDATE ORDERS SET STATUS = 'A'
                WHERE CURRENT OF C-ORDERS
            END-EXEC
            IF SQLCODE NOT = 0
                DISPLAY "UPDATE FAILED"
            END-IF
        END-IF
        EXEC SQL CLOSE C-ORDERS END-EXEC
    END-IF
    GOBACK.
