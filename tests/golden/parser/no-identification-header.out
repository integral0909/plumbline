UNIT @3:1
  PROG PROGRAM OUTER @3:1
    DIVN IDENTIFICATION @3:1
      IDPA PROGRAM-ID OUTER @3:1
    DIVN DATA @4:1
      SECT WORKING-STORAGE @5:1
        DATA 1 X @6:1
          CLAU PICTURE XX @6:25
          CLAU VALUE @6:32
    DIVN PROCEDURE @7:1
      SENT @8:5
        STMT CALL @8:5
        STMT STOP @9:5
    PROG PROGRAM INNER @10:1
      DIVN IDENTIFICATION @10:1
        IDPA PROGRAM-ID INNER @10:1
      DIVN DATA @11:1
        SECT LINKAGE @12:1
          DATA 1 Y @13:1
            CLAU PICTURE XX @13:25
      DIVN PROCEDURE @14:1
        USNG USING Y @14:26
        SENT @15:5
          STMT MOVE @15:5
          STMT EXIT PROGRAM @16:5
  PROG PROGRAM NEXT-ONE @19:1
    DIVN IDENTIFICATION @19:1
      IDPA PROGRAM-ID NEXT-ONE @19:1
    DIVN PROCEDURE @20:1
      SENT @21:5
        STMT GOBACK @21:5
