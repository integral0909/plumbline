UNIT @3:1
  PROG PROGRAM SQLTYPES @3:1
    DIVN IDENTIFICATION @3:1
      IDPA PROGRAM-ID SQLTYPES @4:1
    DIVN DATA @5:1
      SECT WORKING-STORAGE @6:1
        DATA 1 WS-LOCATOR @7:1
          CLAU SQL @7:21
        DATA 1 WS-DOC @8:1
          CLAU SQL @8:21
        DATA 1 WS-ROW-ID @9:1
          CLAU SQL @9:21
        DATA 1 WS-COUNT @10:1
          CLAU PICTURE 9(4) @10:21
          CLAU VALUE @10:30
    DIVN PROCEDURE @11:1
      SENT @12:5
        STMT DISPLAY @12:5
        STMT GOBACK @13:5
