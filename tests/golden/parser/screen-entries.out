UNIT @4:1
  PROG PROGRAM SCREENS @4:1
    DIVN IDENTIFICATION @4:1
      IDPA PROGRAM-ID SCREENS @5:1
    DIVN DATA @6:1
      SECT WORKING-STORAGE @7:1
        DATA 1 REPLY @8:1
          CLAU PICTURE X @8:25
      SECT SCREEN @9:1
        DATA 1 MAIN-SCREEN @10:1
          DATA 5 @11:5
            CLAU BLANK @11:9
          DATA 5 @12:5
            CLAU LINE @12:9
            CLAU COLUMN @12:16
            CLAU VALUE @12:26
          DATA 5 @13:5
            CLAU LINE @13:9
            CLAU COLUMN @13:16
            CLAU PICTURE X @13:26
    DIVN PROCEDURE @14:1
      SENT @15:5
        STMT DISPLAY @15:5
        STMT ACCEPT @16:5
        STMT STOP @17:5
