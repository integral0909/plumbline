//ACCTJOB  JOB CLASS=A
//EXTRACT  EXEC PGM=ACCTEXT
//EXTOUT   DD DSN=PROD.ACCT.EXTRACT,DISP=(NEW,CATLG,DELETE),
//            RECFM=FB,LRECL=300
//* Reported: ACCTRPT reads the extract as 350-byte records.
//REPORT   EXEC PGM=ACCTRPT
//EXTIN    DD DSN=PROD.ACCT.EXTRACT,DISP=SHR
//* Fine: the same length; the history's records vary.
//SUMMARY  EXEC PGM=ACCTSUM
//EXTIN    DD DSN=PROD.ACCT.EXTRACT,DISP=SHR
//HISTOUT  DD DSN=PROD.ACCT.HIST(+1),DISP=(NEW,CATLG)
