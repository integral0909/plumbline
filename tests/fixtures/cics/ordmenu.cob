*> CICS commands that name resources, checked against orders.csd.
IDENTIFICATION DIVISION.
PROGRAM-ID. ORDMENU.
DATA DIVISION.
WORKING-STORAGE SECTION.
01  ORDER-FILE         PIC X(8) VALUE "ORDFILE".
01  NEXT-PROGRAM       PIC X(8) VALUE "ORDENTRY".
01  ORDER-REC          PIC X(80).
01  ORDER-KEY          PIC X(8) VALUE SPACES.
01  WS-RESP            PIC S9(8) COMP.
PROCEDURE DIVISION.
    EXEC CICS READ FILE(ORDER-FILE) INTO(ORDER-REC) RIDFLD(ORDER-KEY)
        RESP(WS-RESP)
    END-EXEC
    IF WS-RESP NOT = 0
        EXEC CICS READ DATASET('ORDHIST') INTO(ORDER-REC)
            RIDFLD(ORDER-KEY) RESP(WS-RESP)
        END-EXEC
    END-IF
    IF WS-RESP NOT = 0
        EXEC CICS WRITEQ TD QUEUE('CSSL') FROM(ORDER-KEY)
            RESP(WS-RESP)
        END-EXEC
        EXEC CICS WRITEQ TD QUEUE('ORDQ') FROM(ORDER-KEY)
            RESP(WS-RESP)
        END-EXEC
    END-IF
    EXEC CICS LINK PROGRAM('ORDPRICE') RESP(WS-RESP) END-EXEC
    EXEC CICS LINK PROGRAM('DFHWBST') RESP(WS-RESP) END-EXEC
    EXEC CICS LINK PROGRAM('SUBPROG') RESP(WS-RESP) END-EXEC
    EXEC CICS XCTL PROGRAM(NEXT-PROGRAM) RESP(WS-RESP) END-EXEC
    EXEC CICS RETURN TRANSID('ORD9') END-EXEC.
IDENTIFICATION DIVISION.
PROGRAM-ID. SUBPROG.
PROCEDURE DIVISION.
    GOBACK.
END PROGRAM SUBPROG.
END PROGRAM ORDMENU.
