//SHARED   JOB (ACCT),'SHR FOR OUTPUT'
//* PAYUPD writes PAYRPT, and updates PAYMAST in place.
//UPDATE   EXEC PGM=PAYUPD
//PAYMAST  DD DSN=PAY.MASTER,DISP=SHR
//PAYMAST1 DD DSN=PAY.MASTER.PATH,DISP=SHR
//RATES    DD DSN=PAY.RATES,DISP=SHR
//PAYRPT   DD DSN=PAY.REPORT,DISP=SHR
//SORTWK01 DD UNIT=SYSDA,SPACE=(CYL,1)
//PAYLOG   DD SYSOUT=*
