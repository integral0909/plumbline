//BLOCKS   JOB (ACCT),'BLKSIZE'
//COPY     EXEC PGM=IEBGENER
//SYSPRINT DD SYSOUT=*
//SYSIN    DD DUMMY
//* FB: 27900 is not a multiple of 80.
//SYSUT1   DD DSN=PAY.INPUT,DISP=SHR,
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=27900)
//* VB: 100 has no room for a 100-byte record and its descriptor.
//SYSUT2   DD DSN=PAY.LOG,DISP=(NEW,CATLG),
//            RECFM=VB,LRECL=100,BLKSIZE=100
//* Fine: a multiple of 80, BLKSIZE=0, and VB with room.
//COPY2    EXEC PGM=IEBGENER
//SYSPRINT DD SYSOUT=*
//SYSIN    DD DUMMY
//SYSUT1   DD DSN=PAY.INPUT,DISP=SHR,
//            DCB=(RECFM=FB,LRECL=80,BLKSIZE=27920)
//SYSUT2   DD DSN=PAY.COPY,DISP=(NEW,CATLG),
//            RECFM=FB,LRECL=80,BLKSIZE=0
//LOG      DD DSN=PAY.LOG2,DISP=(NEW,CATLG),
//            RECFM=VB,LRECL=100,BLKSIZE=104
