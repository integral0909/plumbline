//RETAINJB JOB (ACCT),'RETAIN',CLASS=A
//BACKUP   EXEC PGM=PAYBKUP
//* Reported: a day past the year's end, day 366 of 2023, a RETPD
//* above 93000, both coded, and a temporary data set.
//YEAREND  DD DSN=PAY.YEAREND,DISP=(NEW,CATLG),EXPDT=2024/400
//NOLEAP   DD DSN=PAY.NOLEAP,DISP=(NEW,CATLG),EXPDT=2023/366
//LONG     DD DSN=PAY.LONG,DISP=(NEW,CATLG),RETPD=99999
//BOTH     DD DSN=PAY.BOTH,DISP=(NEW,CATLG),EXPDT=2030/001,RETPD=30
//WORK     DD DSN=&&WORK,DISP=(NEW,PASS),RETPD=30
//* Not reported: day 366 of a leap year, a never-scratch date, the
//* short form, and RETPD in range.
//LEAP     DD DSN=PAY.LEAP,DISP=(NEW,CATLG),EXPDT=2024/366
//KEEP     DD DSN=PAY.KEEP,DISP=(NEW,CATLG),EXPDT=99365
//OLD      DD DSN=PAY.OLD,DISP=(NEW,CATLG),EXPDT=96366
//MONTH    DD DSN=PAY.MONTH,DISP=(NEW,CATLG),RETPD=30
