//LRECLBAD JOB (ACCT),'LRECL',CLASS=A
//EXTRACT  EXEC PGM=PAYEXTR
//* Reported: a record longer than 32760, LRECL=0 for fixed records,
//* and a variable record shorter than 5.
//BIG      DD DSN=PAY.BIG,DISP=(NEW,CATLG),RECFM=FB,LRECL=40000
//EMPTY    DD DSN=PAY.EMPTY,DISP=(NEW,CATLG),DCB=(RECFM=FB,LRECL=0)
//TINY     DD DSN=PAY.TINY,DISP=(NEW,CATLG),RECFM=VB,LRECL=4
//* Not reported: 32760, 32761 for VSAM, LRECL=0 for RECFM=U, and 0
//* with no RECFM.
//MOST     DD DSN=PAY.MOST,DISP=(NEW,CATLG),RECFM=VB,LRECL=32760
//KSDS     DD DSN=PAY.KSDS,DISP=(NEW,CATLG),RECORG=KS,LRECL=32761
//UNDEF    DD DSN=PAY.UNDEF,DISP=(NEW,CATLG),RECFM=U,LRECL=0
//LIKE     DD DSN=PAY.LIKE,DISP=(NEW,CATLG),LRECL=0
