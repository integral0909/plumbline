//UTILS    JOB (ACCT),'UTILITY DD'
//* IEBGENER without SYSIN and SYSPRINT.
//COPY     EXEC PGM=IEBGENER
//SYSUT1   DD DSN=PAY.INPUT,DISP=SHR
//SYSUT2   DD DSN=PAY.COPY,DISP=(NEW,CATLG,DELETE)
//* IDCAMS with its commands.
//DEFINE   EXEC PGM=IDCAMS
//SYSPRINT DD SYSOUT=*
//SYSIN    DD *
  LISTCAT ENTRIES(PAY.INPUT)
/*
//* The TSO batch program without SYSTSIN.
//RUNDB2   EXEC PGM=IKJEFT01
//SYSTSPRT DD SYSOUT=*
//* A procedure's step may get its DD from the job that runs it.
//GENPROC  PROC
//GEN      EXEC PGM=IEBGENER
//SYSUT1   DD DSN=PAY.INPUT,DISP=SHR
//         PEND
//RUNGEN   EXEC GENPROC
//GEN.SYSUT2 DD SYSOUT=*
