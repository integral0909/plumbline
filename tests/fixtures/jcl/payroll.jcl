//PAYROLL  JOB CLASS=A
//* Everything PAYUPD and PAYLOG open, and the path of the alternate
//* index of PAYMAST.
//UPDATE   EXEC PGM=PAYUPD
//PAYMAST  DD DSN=PAY.MASTER,DISP=SHR
//PAYMAST1 DD DSN=PAY.MASTER.PATH,DISP=SHR
//PAYRPT   DD SYSOUT=*
//PAYLOG   DD DSN=PAY.LOG,DISP=MOD
//SYSOUT   DD SYSOUT=*
//* No DD PAYLOG for the called program, and a DD nothing uses.
//RERUN    EXEC PGM=PAYUPD
//PAYMAST  DD DSN=PAY.MASTER,DISP=SHR
//PAYRPT   DD SYSOUT=*
//OLDFILE  DD DSN=PAY.OLD,DISP=SHR
//* A procedure whose step gets PAYLOG from the job.
//NIGHTLY  EXEC PAYPROC
//UPD.PAYLOG DD DSN=PAY.LOG,DISP=MOD
//* A utility.
//CLEANUP  EXEC PGM=IEFBR14
