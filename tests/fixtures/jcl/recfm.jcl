//RECFMJOB JOB (ACCT),'RECFM',CLASS=A
//EXTRACT  EXEC PGM=PAYEXTR
//* Reported: letters out of order, a doubled letter, and both A and M.
//OUTBF    DD DSN=PAY.OUTBF,DISP=(NEW,CATLG),RECFM=BF,LRECL=80
//OUTFBB   DD DSN=PAY.OUTFBB,DISP=(NEW,CATLG),DCB=(RECFM=FBB,LRECL=80)
//OUTAM    DD DSN=PAY.OUTAM,DISP=(NEW,CATLG),RECFM=FBAM,LRECL=133
//* Not reported: formats the Reference lists.
//PRINT    DD DSN=PAY.PRINT,DISP=(NEW,CATLG),RECFM=FBA,LRECL=133
//SPAN     DD DSN=PAY.SPAN,DISP=(NEW,CATLG),RECFM=VBS,LRECL=X
//TAPE     DD DSN=PAY.TAPE,DISP=(NEW,CATLG),RECFM=DBA
//LOAD     DD DSN=PAY.LOAD,DISP=(NEW,CATLG),DCB=(RECFM=U,BLKSIZE=6144)
//OVER     DD DSN=PAY.OVER,DISP=(NEW,CATLG),RECFM=VBSTM
