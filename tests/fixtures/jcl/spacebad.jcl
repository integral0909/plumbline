//SPACEJOB JOB (ACCT),'SPACE',CLASS=A
//EXTRACT  EXEC PGM=PAYEXTR
//* Reported: a unit that is not one, a quantity above 16777215, and an
//* option that is not one.
//TRACKS   DD DSN=PAY.TRACKS,DISP=(NEW,CATLG),SPACE=(TRACKS,(10,5))
//HUGE     DD DSN=PAY.HUGE,DISP=(NEW,CATLG),SPACE=(TRK,(20000000,5))
//FREE     DD DSN=PAY.FREE,DISP=(NEW,CATLG),SPACE=(CYL,(1,1),RELEASE)
//* Not reported: the forms the Reference shows.
//PDS      DD DSN=PAY.LOAD,DISP=(NEW,CATLG),SPACE=(TRK,(20,,2))
//ONE      DD DSN=PAY.ONE,DISP=(NEW,CATLG),SPACE=(TRK,20,RLSE,CONTIG)
//BLOCKS   DD DSN=PAY.BLOCKS,DISP=(NEW,CATLG),SPACE=(400,30,,,ROUND)
//CYLS     DD DSN=PAY.CYLS,DISP=(NEW,CATLG),SPACE=(CYL,(5,5),RLSE)
