//COPYJOB  JOB (ACCT),'COPY',CLASS=A
//* Reported: SYSUT2 is the data set SYSUT1 reads.
//COPY1    EXEC PGM=IEBGENER
//SYSPRINT DD SYSOUT=*
//SYSIN    DD DUMMY
//SYSUT1   DD DSN=PAY.MASTER,DISP=SHR
//SYSUT2   DD DSN=PAY.MASTER,DISP=OLD
//* Reported: SYSUT2 is one of the data sets concatenated to SYSUT1.
//COPY2    EXEC PGM=IEBGENER
//SYSPRINT DD SYSOUT=*
//SYSIN    DD DUMMY
//SYSUT1   DD DSN=PAY.DAY1,DISP=SHR
//         DD DSN=PAY.ALL,DISP=SHR
//SYSUT2   DD DSN=PAY.ALL,DISP=MOD
//* Not reported: another data set.
//COPY3    EXEC PGM=IEBGENER
//SYSPRINT DD SYSOUT=*
//SYSIN    DD DUMMY
//SYSUT1   DD DSN=PAY.MASTER,DISP=SHR
//SYSUT2   DD DSN=PAY.BACKUP,DISP=OLD
