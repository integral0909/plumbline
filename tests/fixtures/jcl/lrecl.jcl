//LRECL    JOB CLASS=A
//* PLB-J006: PAYRPT is 132 bytes in PAYUPD (133 with an ASA control
//* character is right), RATES 80, MASTER 38, and PAYLOG 80 in PAYLOG.
//UPDATE   EXEC PGM=PAYUPD
//PAYMAST  DD DSN=PAY.MASTER,DISP=SHR
//RATES    DD DSN=PAY.RATES,DISP=SHR,DCB=(RECFM=FB,LRECL=81)
//PAYRPT   DD DSN=PAY.REPORT,DISP=(NEW,CATLG),
//            DCB=(RECFM=FBA,LRECL=133,BLKSIZE=0)
//PAYLOG   DD DSN=PAY.LOG,DISP=MOD,RECFM=VB,LRECL=40
