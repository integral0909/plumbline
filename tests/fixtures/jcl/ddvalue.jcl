//VALUEJOB JOB (ACCT),'VALUE',CLASS=A
//REPORT   EXEC PGM=PAYRPT
//* Reported: HOLD=YESS, FREE=EOJ, SPIN=UNALLOCATE, AVGREC=B, and
//* RECORG=KSDS.
//HELD     DD SYSOUT=A,HOLD=YESS
//FREED    DD DSN=PAY.FREED,DISP=SHR,FREE=EOJ
//SPUN     DD SYSOUT=A,SPIN=UNALLOCATE
//AVG      DD DSN=PAY.AVG,DISP=(NEW,CATLG),SPACE=(80,(10,5)),AVGREC=B
//KSDS     DD DSN=PAY.KSDS,DISP=(NEW,CATLG),RECORG=KSDS
//* Not reported: values the Reference lists.
//LIST     DD SYSOUT=A,HOLD=Y,SPIN=(UNALLOC,'23:00')
//CLOSED   DD DSN=PAY.CLOSED,DISP=SHR,FREE=CLOSE
//RECS     DD DSN=PAY.RECS,DISP=(NEW,CATLG),SPACE=(80,(10,5)),AVGREC=K
//ESDS     DD DSN=PAY.ESDS,DISP=(NEW,CATLG),RECORG=ES
