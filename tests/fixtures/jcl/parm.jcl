//PARMJOB  JOB (ACCT),'PARM',CLASS=A
//* A PARM of 101 characters: reported.
//LONG     EXEC PGM=PAYRPT,PARM='XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
//             XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
//             XXXXXXX'
//* 100 characters, and 101 written with a doubled apostrophe that
//* passes one: not reported.
//EXACT    EXEC PGM=PAYRPT,PARM='XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
//             XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
//             XXXXXX'
//QUOTE    EXEC PGM=PAYRPT,PARM='IT''SXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
//             XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
//             XXXXXXX'
//* A symbol, which may be longer or shorter: not counted.
//SYMBOL   EXEC PGM=PAYRPT,PARM='&OPTIONS'
