//* Reported: RD=RESTART on the JOB statement.
//EXECJOB  JOB (ACCT),'EXEC',CLASS=A,RD=RESTART
//* Reported: ADDRSPC=VIRTUAL, MEMLIMIT=10GB, and MEMLIMIT=20000P.
//LOAD     EXEC PGM=PAYLOAD,ADDRSPC=VIRTUAL
//SORT     EXEC PGM=SORT,MEMLIMIT=10GB
//BIG      EXEC PGM=PAYBIG,MEMLIMIT=20000P
//* Not reported: values the Reference lists.
//REAL     EXEC PGM=PAYREAL,ADDRSPC=REAL,RD=RNC
//LIMIT    EXEC PGM=PAYLIM,MEMLIMIT=16384P
//ANY      EXEC PGM=PAYANY,MEMLIMIT=NOLIMIT
//TEN      EXEC PGM=PAYTEN,MEMLIMIT=10G
