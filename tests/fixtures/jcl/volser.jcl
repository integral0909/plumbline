//VOLJOB   JOB (ACCT),'VOL',CLASS=A
//COPY     EXEC PGM=PAYCOPY
//* Reported: a serial of seven characters, SCRTCH, L00042, and one
//* named twice.
//LONG     DD DSN=PAY.LONG,DISP=OLD,VOL=SER=PAYVOL1,UNIT=3390
//SCRATCH  DD DSN=PAY.SCRATCH,DISP=OLD,VOL=SER=SCRTCH,UNIT=TAPE
//NOLABEL  DD DSN=PAY.NOLABEL,DISP=OLD,VOL=SER=L00042,UNIT=TAPE
//TWICE    DD DSN=PAY.TWICE,DISP=OLD,VOL=SER=(T00001,T00002,T00001)
//* Not reported: serials of 1 to 6 characters, in a list, and quoted.
//ONE      DD DSN=PAY.ONE,DISP=OLD,VOL=SER=PAY001,UNIT=3390
//MANY     DD DSN=PAY.MANY,DISP=OLD,VOL=(,,,3,SER=(T00001,T00002))
//QUOTED   DD DSN=PAY.QUOTED,DISP=OLD,VOL=SER='PAY.01',UNIT=3390
