//* Reported: 3000M on the JOB statement.
//PAYJOB   JOB (ACCT),'PAY',CLASS=A,REGION=3000M
//* Reported: more than 2096128K, a number without K or M, and a
//* gigabyte value.
//SORT     EXEC PGM=SORT,REGION=4000000K
//LOAD     EXEC PGM=PAYLOAD,REGION=4096
//MERGE    EXEC PGM=PAYMERGE,REGION=2G
//* Not reported: values in range, 0K and 0M, and a symbol.
//EXTRACT  EXEC PGM=PAYEXTR,REGION=2096128K
//REPORT   EXEC PGM=PAYRPT,REGION=2047M
//CHECK    EXEC PGM=PAYCHK,REGION=0K
//PURGE    EXEC PGM=PAYPURGE,REGION=0M
//LAST     EXEC PGM=PAYLAST,REGION=&SIZE
