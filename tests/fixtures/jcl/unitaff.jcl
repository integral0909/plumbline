//AFFJOB   JOB (ACCT),'AFF',CLASS=A
//COPY     EXEC PGM=PAYCOPY
//* Reported: an affinity to a DD that comes after it.
//TAPE1    DD DSN=PAY.TAPE1,DISP=OLD,UNIT=AFF=TAPE2
//TAPE2    DD DSN=PAY.TAPE2,DISP=OLD,UNIT=TAPE
//* Not reported: an affinity to an earlier DD.
//TAPE3    DD DSN=PAY.TAPE3,DISP=OLD,UNIT=AFF=TAPE2
//* Reported: an affinity to a DD with FREE=CLOSE, and one with
//* STORCLAS.
//TAPE4    DD DSN=PAY.TAPE4,DISP=OLD,UNIT=TAPE,FREE=CLOSE
//TAPE5    DD DSN=PAY.TAPE5,DISP=OLD,UNIT=AFF=TAPE4
//TAPE6    DD DSN=PAY.TAPE6,DISP=OLD,UNIT=AFF=TAPE2,STORCLAS=FAST
