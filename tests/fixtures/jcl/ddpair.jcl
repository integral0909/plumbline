//PAIRJOB  JOB (ACCT),'PAIRS',CLASS=A
//DEFINE   EXEC PGM=PAYDEF
//* Reported: RECORG with RECFM, AVGREC with SPACE in tracks, LRECL in
//* both forms, and RECORG with DCB=DSORG.
//KSDS     DD DSN=PAY.KSDS,DISP=(NEW,CATLG),RECORG=KS,RECFM=FB
//RECS     DD DSN=PAY.RECS,DISP=(NEW,CATLG),AVGREC=K,
//            SPACE=(TRK,(10,5))
//TWICE    DD DSN=PAY.TWICE,DISP=(NEW,CATLG),LRECL=80,
//            DCB=(RECFM=FB,LRECL=80)
//ESDS     DD DSN=PAY.ESDS,DISP=(NEW,CATLG),RECORG=ES,DCB=(DSORG=PS)
//* Not reported: AVGREC with a record length, and RECFM with LRECL.
//RECORDS  DD DSN=PAY.RECORDS,DISP=(NEW,CATLG),AVGREC=K,
//            SPACE=(80,(10,5))
//FLAT     DD DSN=PAY.FLAT,DISP=(NEW,CATLG),RECFM=FB,LRECL=80
