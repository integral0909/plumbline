       IDENTIFICATION DIVISION.
       PROGRAM-ID. ACCTMNT.
       ENVIRONMENT DIVISION.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT HIST-FILE ASSIGN TO HISTFILE.
       DATA DIVISION.
       FILE SECTION.
       FD  HIST-FILE.
       01  HIST-REC                PIC X(80).
       WORKING-STORAGE SECTION.
       01  WS-ID                   PIC S9(9) COMP.
       01  WS-BALANCE              PIC S9(7)V99 COMP-3.
       01  WS-ACCOUNT-REC          PIC X(300).
       01  LIT-ACCTFILE            PIC X(8) VALUE 'ACCTDAT '.
           EXEC SQL DECLARE ACCT-CUR CURSOR FOR
               SELECT ACCT_ID FROM BANK.ACCOUNT
           END-EXEC.
       PROCEDURE DIVISION.
           EXEC SQL INSERT INTO BANK.AUDIT (ACCT_ID) VALUES (:WS-ID)
           END-EXEC
           EXEC SQL UPDATE BANK.ACCOUNT SET BALANCE = :WS-BALANCE
               WHERE ACCT_ID = :WS-ID
           END-EXEC
           EXEC SQL DELETE FROM BANK.AUDIT WHERE ACCT_ID = :WS-ID
           END-EXEC
           OPEN EXTEND HIST-FILE
           WRITE HIST-REC
           CLOSE HIST-FILE
           EXEC CICS READ DATASET(LIT-ACCTFILE) INTO(WS-ACCOUNT-REC)
               RIDFLD(WS-ID) UPDATE
           END-EXEC
           EXEC CICS REWRITE FILE('ACCTDAT') FROM(WS-ACCOUNT-REC)
           END-EXEC
           GOBACK.
