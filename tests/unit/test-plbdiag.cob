*> Unit tests for src/lib/plbdiag.cob.
IDENTIFICATION DIVISION.
PROGRAM-ID. TEST-PLBDIAG.
DATA DIVISION.
WORKING-STORAGE SECTION.
COPY "plbdiag.cpy".
01  WS-FILE-ID              PIC 9(4) COMP-5.
01  WS-LINE                 PIC 9(9) COMP-5.
01  WS-COLUMN               PIC 9(4) COMP-5.
01  WS-INDEX                PIC 9(9) COMP-5.
01  WS-TEXT                 PIC X(300).
01  WS-SHORT                PIC X(20).
01  WS-LEN                  PIC 9(9) COMP-5.
01  WS-I                    PIC 9(9) COMP-5.
01  WS-EXPECT-NUM           PIC S9(18) COMP-5.
01  WS-ACTUAL-NUM           PIC S9(18) COMP-5.

PROCEDURE DIVISION.
    CALL "PLBT-BEGIN" USING "plbdiag"
    PERFORM TEST-ADD
    PERFORM TEST-SEVERITIES
    PERFORM TEST-OVERFLOW
    PERFORM TEST-FORMAT
    CALL "PLBT-END"
    STOP RUN.

TEST-ADD.
    CALL "PLBT-CASE" USING "PLB-DIAG-ADD"
    CALL "PLB-DIAG-INIT" USING PLB-DIAGNOSTICS
    MOVE 3 TO WS-FILE-ID
    MOVE 120 TO WS-LINE
    MOVE 12 TO WS-COLUMN
    CALL "PLB-DIAG-ADD" USING PLB-DIAGNOSTICS "E" "RD001"
        WS-FILE-ID WS-LINE WS-COLUMN "cannot open file"
    MOVE 1 TO WS-EXPECT-NUM
    MOVE DG-COUNT TO WS-ACTUAL-NUM
    CALL "PLBT-ASSERT-NUM" USING "one entry stored"
        WS-EXPECT-NUM WS-ACTUAL-NUM
    CALL "PLBT-ASSERT-STR" USING "code stored" "RD001" DG-CODE(1)
    CALL "PLBT-ASSERT-STR" USING "message stored" "cannot open file"
        DG-MESSAGE(1)
    MOVE 120 TO WS-EXPECT-NUM
    MOVE DG-LINE(1) TO WS-ACTUAL-NUM
    CALL "PLBT-ASSERT-NUM" USING "line stored"
        WS-EXPECT-NUM WS-ACTUAL-NUM
    MOVE 12 TO WS-EXPECT-NUM
    MOVE DG-COLUMN(1) TO WS-ACTUAL-NUM
    CALL "PLBT-ASSERT-NUM" USING "column stored"
        WS-EXPECT-NUM WS-ACTUAL-NUM.

TEST-SEVERITIES.
    CALL "PLBT-CASE" USING "severity counting"
    CALL "PLB-DIAG-INIT" USING PLB-DIAGNOSTICS
    MOVE 0 TO WS-FILE-ID WS-LINE WS-COLUMN
    CALL "PLB-DIAG-ADD" USING PLB-DIAGNOSTICS "W" "X1"
        WS-FILE-ID WS-LINE WS-COLUMN "w"
    CALL "PLB-DIAG-ADD" USING PLB-DIAGNOSTICS "N" "X2"
        WS-FILE-ID WS-LINE WS-COLUMN "n"
    CALL "PLB-DIAG-ADD" USING PLB-DIAGNOSTICS "?" "X3"
        WS-FILE-ID WS-LINE WS-COLUMN "unknown severity"
    MOVE 1 TO WS-EXPECT-NUM
    MOVE DG-WARNINGS TO WS-ACTUAL-NUM
    CALL "PLBT-ASSERT-NUM" USING "warnings counted"
        WS-EXPECT-NUM WS-ACTUAL-NUM
    MOVE DG-ERRORS TO WS-ACTUAL-NUM
    CALL "PLBT-ASSERT-NUM" USING "unknown severity counts as error"
        WS-EXPECT-NUM WS-ACTUAL-NUM
    CALL "PLBT-ASSERT-STR" USING "unknown severity stored as E" "E"
        DG-SEVERITY(3)
    MOVE 3 TO WS-EXPECT-NUM
    MOVE DG-COUNT TO WS-ACTUAL-NUM
    CALL "PLBT-ASSERT-NUM" USING "notes are stored"
        WS-EXPECT-NUM WS-ACTUAL-NUM
    CALL "PLB-DIAG-ADD" USING PLB-DIAGNOSTICS "W" "X1"
        WS-FILE-ID WS-LINE WS-COLUMN "w"
    MOVE DG-COUNT TO WS-ACTUAL-NUM
    CALL "PLBT-ASSERT-NUM" USING "identical diagnostic not repeated"
        WS-EXPECT-NUM WS-ACTUAL-NUM
    MOVE 1 TO WS-EXPECT-NUM
    MOVE DG-WARNINGS TO WS-ACTUAL-NUM
    CALL "PLBT-ASSERT-NUM" USING "nor counted again"
        WS-EXPECT-NUM WS-ACTUAL-NUM.

TEST-OVERFLOW.
    CALL "PLBT-CASE" USING "full table"
    CALL "PLB-DIAG-INIT" USING PLB-DIAGNOSTICS
    MOVE 0 TO WS-FILE-ID WS-LINE WS-COLUMN
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > DG-MAX + 5
        MOVE WS-I TO WS-LINE
        CALL "PLB-DIAG-ADD" USING PLB-DIAGNOSTICS "W" "X"
            WS-FILE-ID WS-LINE WS-COLUMN "flood"
    END-PERFORM
    MOVE DG-MAX TO WS-EXPECT-NUM
    MOVE DG-COUNT TO WS-ACTUAL-NUM
    CALL "PLBT-ASSERT-NUM" USING "stored count stops at DG-MAX"
        WS-EXPECT-NUM WS-ACTUAL-NUM
    MOVE 5 TO WS-EXPECT-NUM
    MOVE DG-DROPPED TO WS-ACTUAL-NUM
    CALL "PLBT-ASSERT-NUM" USING "excess entries are counted as dropped"
        WS-EXPECT-NUM WS-ACTUAL-NUM
    COMPUTE WS-EXPECT-NUM = DG-MAX + 5
    MOVE DG-WARNINGS TO WS-ACTUAL-NUM
    CALL "PLBT-ASSERT-NUM" USING "dropped entries still counted"
        WS-EXPECT-NUM WS-ACTUAL-NUM.

TEST-FORMAT.
    CALL "PLBT-CASE" USING "PLB-DIAG-FORMAT"
    CALL "PLB-DIAG-INIT" USING PLB-DIAGNOSTICS
    MOVE 1 TO WS-FILE-ID
    MOVE 42 TO WS-LINE
    MOVE 8 TO WS-COLUMN
    CALL "PLB-DIAG-ADD" USING PLB-DIAGNOSTICS "W" "RD002"
        WS-FILE-ID WS-LINE WS-COLUMN "line longer than 72 columns"
    MOVE 1 TO WS-INDEX
    CALL "PLB-DIAG-FORMAT" USING PLB-DIAGNOSTICS WS-INDEX
        "src/pay.cbl" WS-TEXT WS-LEN
    CALL "PLBT-ASSERT-STR" USING "full location"
        "src/pay.cbl:42:8: warning: line longer than 72 columns [RD002]"
        WS-TEXT
    MOVE 62 TO WS-EXPECT-NUM
    MOVE WS-LEN TO WS-ACTUAL-NUM
    CALL "PLBT-ASSERT-NUM" USING "length of formatted text"
        WS-EXPECT-NUM WS-ACTUAL-NUM

    MOVE 0 TO WS-COLUMN
    CALL "PLB-DIAG-ADD" USING PLB-DIAGNOSTICS "E" "RD001"
        WS-FILE-ID WS-LINE WS-COLUMN "no column"
    MOVE 2 TO WS-INDEX
    CALL "PLB-DIAG-FORMAT" USING PLB-DIAGNOSTICS WS-INDEX
        "a.cob" WS-TEXT WS-LEN
    CALL "PLBT-ASSERT-STR" USING "column 0 is omitted"
        "a.cob:42: error: no column [RD001]" WS-TEXT

    MOVE 0 TO WS-LINE
    CALL "PLB-DIAG-ADD" USING PLB-DIAGNOSTICS "N" " "
        WS-FILE-ID WS-LINE WS-COLUMN "no line, no code"
    MOVE 3 TO WS-INDEX
    CALL "PLB-DIAG-FORMAT" USING PLB-DIAGNOSTICS WS-INDEX
        " " WS-TEXT WS-LEN
    CALL "PLBT-ASSERT-STR" USING "blank path and code"
        "plumbline: note: no line, no code" WS-TEXT

    MOVE 1 TO WS-INDEX
    CALL "PLB-DIAG-FORMAT" USING PLB-DIAGNOSTICS WS-INDEX
        "src/pay.cbl" WS-SHORT WS-LEN
    CALL "PLBT-ASSERT-STR" USING "truncated to fit"
        "src/pay.cbl:42:8: wa" WS-SHORT
    MOVE 20 TO WS-EXPECT-NUM
    MOVE WS-LEN TO WS-ACTUAL-NUM
    CALL "PLBT-ASSERT-NUM" USING "truncated length"
        WS-EXPECT-NUM WS-ACTUAL-NUM

    MOVE 99 TO WS-INDEX
    CALL "PLB-DIAG-FORMAT" USING PLB-DIAGNOSTICS WS-INDEX
        "a.cob" WS-TEXT WS-LEN
    MOVE 0 TO WS-EXPECT-NUM
    MOVE WS-LEN TO WS-ACTUAL-NUM
    CALL "PLBT-ASSERT-NUM" USING "out-of-range index gives empty text"
        WS-EXPECT-NUM WS-ACTUAL-NUM.
END PROGRAM TEST-PLBDIAG.
