*> Unit tests for src/lib/plbpp.cob. Expanded token streams are covered
*> by the golden suite in tests/golden/pp; these tests check the
*> pieces underneath and the fields a listing does not show.
IDENTIFICATION DIVISION.
PROGRAM-ID. TEST-PLBPP.
DATA DIVISION.
WORKING-STORAGE SECTION.
COPY "plbsrcc.cpy".
COPY "plbsrc.cpy".
COPY "plbdiag.cpy".
COPY "plbppopt.cpy".
COPY "plbtokc.cpy".
COPY "plbtok.cpy".
COPY "plbincl.cpy".
01  WS-RESULT               PIC X.
01  WS-PATH                 PIC X(1100).
01  WS-STATUS               PIC 9(4) COMP-5.
01  WS-FILE-ID              PIC 9(4) COMP-5.
01  WS-FROM-FILE            PIC 9(4) COMP-5.
01  WS-MODE                 PIC X VALUE "A".
01  WS-I                    PIC 9(9) COMP-5.
01  WS-TEXT                 PIC X(100).
01  WS-LEN                  PIC 9(9) COMP-5.
01  WS-EXPECT-NUM           PIC S9(18) COMP-5.
01  WS-ACTUAL-NUM           PIC S9(18) COMP-5.

PROCEDURE DIVISION.
    CALL "PLBT-BEGIN" USING "plbpp"
    PERFORM TEST-SAFE-NAME
    PERFORM TEST-OPTIONS
    PERFORM TEST-RESOLVE
    PERFORM TEST-INCLUSIONS
    PERFORM TEST-NO-COPY
    CALL "PLBT-END"
    STOP RUN.

TEST-SAFE-NAME.
    CALL "PLBT-CASE" USING "PLB-PP-SAFE-NAME"
    CALL "PLB-PP-SAFE-NAME" USING "PAYREC" WS-RESULT
    CALL "PLBT-ASSERT-FLAG" USING "plain name" "Y" WS-RESULT
    CALL "PLB-PP-SAFE-NAME" USING "copy/dates.cpy" WS-RESULT
    CALL "PLBT-ASSERT-FLAG" USING "relative path" "Y" WS-RESULT
    CALL "PLB-PP-SAFE-NAME" USING "a..b.cpy" WS-RESULT
    CALL "PLBT-ASSERT-FLAG" USING "dots inside a name are fine" "Y"
        WS-RESULT
    CALL "PLB-PP-SAFE-NAME" USING "../secret" WS-RESULT
    CALL "PLBT-ASSERT-FLAG" USING "leading .." "N" WS-RESULT
    CALL "PLB-PP-SAFE-NAME" USING "copy/../../x" WS-RESULT
    CALL "PLBT-ASSERT-FLAG" USING "inner .." "N" WS-RESULT
    CALL "PLB-PP-SAFE-NAME" USING "copy/.." WS-RESULT
    CALL "PLBT-ASSERT-FLAG" USING "trailing .." "N" WS-RESULT
    CALL "PLB-PP-SAFE-NAME" USING ".." WS-RESULT
    CALL "PLBT-ASSERT-FLAG" USING "bare .." "N" WS-RESULT
    CALL "PLB-PP-SAFE-NAME" USING "/etc/passwd" WS-RESULT
    CALL "PLBT-ASSERT-FLAG" USING "absolute path" "N" WS-RESULT
    CALL "PLB-PP-SAFE-NAME" USING "copy\..\x" WS-RESULT
    CALL "PLBT-ASSERT-FLAG" USING "backslash separators" "N" WS-RESULT
    CALL "PLB-PP-SAFE-NAME" USING " " WS-RESULT
    CALL "PLBT-ASSERT-FLAG" USING "empty name" "N" WS-RESULT.

TEST-OPTIONS.
    CALL "PLBT-CASE" USING "search path options"
    CALL "PLB-PP-INIT-OPTIONS" USING PLB-PP-OPTIONS
    CALL "PLBT-ASSERT-FLAG" USING "copybook format detected" "A"
        PO-FORMAT
    PERFORM VARYING WS-I FROM 1 BY 1 UNTIL WS-I > PO-MAX-PATHS
        CALL "PLB-PP-ADD-PATH" USING PLB-PP-OPTIONS "dir" WS-STATUS
    END-PERFORM
    MOVE 0 TO WS-EXPECT-NUM
    MOVE WS-STATUS TO WS-ACTUAL-NUM
    CALL "PLBT-ASSERT-NUM" USING "paths up to the limit accepted"
        WS-EXPECT-NUM WS-ACTUAL-NUM
    CALL "PLB-PP-ADD-PATH" USING PLB-PP-OPTIONS "one-more" WS-STATUS
    MOVE 1 TO WS-EXPECT-NUM
    MOVE WS-STATUS TO WS-ACTUAL-NUM
    CALL "PLBT-ASSERT-NUM" USING "path beyond the limit refused"
        WS-EXPECT-NUM WS-ACTUAL-NUM.

TEST-RESOLVE.
    CALL "PLBT-CASE" USING "PLB-PP-RESOLVE"
    CALL "PLB-SRC-INIT" USING PLB-SOURCE-SET
    CALL "PLB-DIAG-INIT" USING PLB-DIAGNOSTICS
    CALL "PLB-PP-INIT-OPTIONS" USING PLB-PP-OPTIONS
    CALL "PLB-PP-ADD-PATH" USING PLB-PP-OPTIONS "tests/golden/pp/copy"
        WS-STATUS
    CALL "PLB-SRC-LOAD" USING PLB-SOURCE-SET PLB-DIAGNOSTICS
        "tests/golden/pp/basic.cob" WS-MODE WS-FROM-FILE WS-STATUS

    CALL "PLB-PP-RESOLVE" USING PLB-SOURCE-SET PLB-PP-OPTIONS "PAYREC"
        " " "Y" WS-FROM-FILE WS-PATH WS-STATUS
    CALL "PLBT-ASSERT-STR" USING "word found on search path"
        "tests/golden/pp/copy/payrec.cpy" WS-PATH
    MOVE 0 TO WS-EXPECT-NUM
    MOVE WS-STATUS TO WS-ACTUAL-NUM
    CALL "PLBT-ASSERT-NUM" USING "status 0 when found"
        WS-EXPECT-NUM WS-ACTUAL-NUM

    CALL "PLB-PP-RESOLVE" USING PLB-SOURCE-SET PLB-PP-OPTIONS
        "copy/dates.cpy" " " "N" WS-FROM-FILE WS-PATH WS-STATUS
    CALL "PLBT-ASSERT-STR" USING "literal found beside includer"
        "tests/golden/pp/copy/dates.cpy" WS-PATH

    CALL "PLB-PP-RESOLVE" USING PLB-SOURCE-SET PLB-PP-OPTIONS "SHARED"
        "lib" "Y" WS-FROM-FILE WS-PATH WS-STATUS
    CALL "PLBT-ASSERT-STR" USING "library is a subdirectory"
        "tests/golden/pp/copy/lib/shared.cpy" WS-PATH

    CALL "PLB-PP-RESOLVE" USING PLB-SOURCE-SET PLB-PP-OPTIONS "COPY"
        " " "Y" WS-FROM-FILE WS-PATH WS-STATUS
    MOVE 1 TO WS-EXPECT-NUM
    MOVE WS-STATUS TO WS-ACTUAL-NUM
    CALL "PLBT-ASSERT-NUM" USING "a directory is not a copybook"
        WS-EXPECT-NUM WS-ACTUAL-NUM

    CALL "PLB-PP-RESOLVE" USING PLB-SOURCE-SET PLB-PP-OPTIONS
        "../basic.cob" " " "N" WS-FROM-FILE WS-PATH WS-STATUS
    MOVE 2 TO WS-EXPECT-NUM
    MOVE WS-STATUS TO WS-ACTUAL-NUM
    CALL "PLBT-ASSERT-NUM" USING "unsafe name refused before lookup"
        WS-EXPECT-NUM WS-ACTUAL-NUM
    CALL "PLBT-ASSERT-STR" USING "no path for unsafe name" " "
        WS-PATH

    CALL "PLB-PP-RESOLVE" USING PLB-SOURCE-SET PLB-PP-OPTIONS "SHARED"
        "../copy" "Y" WS-FROM-FILE WS-PATH WS-STATUS
    MOVE 2 TO WS-EXPECT-NUM
    MOVE WS-STATUS TO WS-ACTUAL-NUM
    CALL "PLBT-ASSERT-NUM" USING "unsafe library refused"
        WS-EXPECT-NUM WS-ACTUAL-NUM.

TEST-INCLUSIONS.
    CALL "PLBT-CASE" USING "inclusion records and token origins"
    CALL "PLB-SRC-INIT" USING PLB-SOURCE-SET
    CALL "PLB-DIAG-INIT" USING PLB-DIAGNOSTICS
    CALL "PLB-SRC-LOAD" USING PLB-SOURCE-SET PLB-DIAGNOSTICS
        "tests/golden/pp/nested.cob" WS-MODE WS-FILE-ID WS-STATUS
    CALL "PLB-PP-RUN" USING PLB-SOURCE-SET PLB-DIAGNOSTICS
        PLB-PP-OPTIONS PLB-TOKENS PLB-INCLUSIONS WS-FILE-ID
    MOVE 2 TO WS-EXPECT-NUM
    MOVE IN-COUNT TO WS-ACTUAL-NUM
    CALL "PLBT-ASSERT-NUM" USING "two inclusions"
        WS-EXPECT-NUM WS-ACTUAL-NUM
    MOVE 0 TO WS-EXPECT-NUM
    MOVE IN-PARENT(1) TO WS-ACTUAL-NUM
    CALL "PLBT-ASSERT-NUM" USING "outer included from main"
        WS-EXPECT-NUM WS-ACTUAL-NUM
    MOVE 1 TO WS-EXPECT-NUM
    MOVE IN-PARENT(2) TO WS-ACTUAL-NUM
    CALL "PLBT-ASSERT-NUM" USING "inner included from outer"
        WS-EXPECT-NUM WS-ACTUAL-NUM
    MOVE 2 TO WS-EXPECT-NUM
    MOVE IN-FROM-LINE(2) TO WS-ACTUAL-NUM
    CALL "PLBT-ASSERT-NUM" USING "COPY INNER is on line 2 of outer"
        WS-EXPECT-NUM WS-ACTUAL-NUM

    *> Tokens: 01 OUTER-GROUP . 05 INNER-FIELD PIC X . eof
    MOVE 1 TO WS-EXPECT-NUM
    MOVE TK-INCL(1) TO WS-ACTUAL-NUM
    CALL "PLBT-ASSERT-NUM" USING "outer tokens carry inclusion 1"
        WS-EXPECT-NUM WS-ACTUAL-NUM
    MOVE 2 TO WS-EXPECT-NUM
    MOVE TK-INCL(4) TO WS-ACTUAL-NUM
    CALL "PLBT-ASSERT-NUM" USING "inner tokens carry inclusion 2"
        WS-EXPECT-NUM WS-ACTUAL-NUM
    MOVE 0 TO WS-EXPECT-NUM
    MOVE TK-INCL(TK-COUNT) TO WS-ACTUAL-NUM
    CALL "PLBT-ASSERT-NUM" USING "eof belongs to the main file"
        WS-EXPECT-NUM WS-ACTUAL-NUM
    CALL "PLBT-ASSERT-FLAG" USING "stream ends with eof" "E"
        TK-KIND(TK-COUNT).

TEST-NO-COPY.
    CALL "PLBT-CASE" USING "file without COPY or REPLACE"
    CALL "PLB-SRC-INIT" USING PLB-SOURCE-SET
    CALL "PLB-DIAG-INIT" USING PLB-DIAGNOSTICS
    CALL "PLB-SRC-LOAD" USING PLB-SOURCE-SET PLB-DIAGNOSTICS
        "tests/golden/lexer/numbers.cob" WS-MODE WS-FILE-ID WS-STATUS
    CALL "PLB-PP-RUN" USING PLB-SOURCE-SET PLB-DIAGNOSTICS
        PLB-PP-OPTIONS PLB-TOKENS PLB-INCLUSIONS WS-FILE-ID
    MOVE 0 TO WS-EXPECT-NUM
    MOVE IN-COUNT TO WS-ACTUAL-NUM
    CALL "PLBT-ASSERT-NUM" USING "no inclusions"
        WS-EXPECT-NUM WS-ACTUAL-NUM
    MOVE DG-COUNT TO WS-ACTUAL-NUM
    CALL "PLBT-ASSERT-NUM" USING "no diagnostics"
        WS-EXPECT-NUM WS-ACTUAL-NUM
    MOVE 55 TO WS-EXPECT-NUM
    MOVE TK-COUNT TO WS-ACTUAL-NUM
    CALL "PLBT-ASSERT-NUM" USING "tokens pass through unchanged"
        WS-EXPECT-NUM WS-ACTUAL-NUM
    MOVE 3 TO WS-I
    CALL "PLB-TOK-TEXT" USING PLB-TOKENS WS-I WS-TEXT WS-LEN
    CALL "PLBT-ASSERT-STR" USING "text copied" "PIC" WS-TEXT.
END PROGRAM TEST-PLBPP.
