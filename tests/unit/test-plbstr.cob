*> Unit tests for src/lib/plbstr.cob.
IDENTIFICATION DIVISION.
PROGRAM-ID. TEST-PLBSTR.
DATA DIVISION.
WORKING-STORAGE SECTION.
01  WS-TEXT                 PIC X(40).
01  WS-SHORT                PIC X(3).
01  WS-LEN                  PIC 9(9) COMP-5.
01  WS-FLAG                 PIC X.
01  WS-EXPECT-NUM           PIC S9(18) COMP-5.
01  WS-ACTUAL-NUM           PIC S9(18) COMP-5.
01  WS-VALUE                PIC S9(18) COMP-5.
01  WS-TINY                 PIC X(2).

PROCEDURE DIVISION.
    CALL "PLBT-BEGIN" USING "plbstr"
    PERFORM TEST-LENGTH
    PERFORM TEST-UPPER
    PERFORM TEST-STARTS-WITH
    PERFORM TEST-FIRST-NONBLANK
    PERFORM TEST-FROM-INT
    CALL "PLBT-END"
    STOP RUN.

TEST-LENGTH.
    CALL "PLBT-CASE" USING "PLB-STR-LENGTH"
    MOVE SPACES TO WS-TEXT
    CALL "PLB-STR-LENGTH" USING WS-TEXT WS-LEN
    MOVE 0 TO WS-EXPECT-NUM
    MOVE WS-LEN TO WS-ACTUAL-NUM
    CALL "PLBT-ASSERT-NUM" USING "blank text has length 0"
        WS-EXPECT-NUM WS-ACTUAL-NUM

    MOVE "PERFORM" TO WS-TEXT
    CALL "PLB-STR-LENGTH" USING WS-TEXT WS-LEN
    MOVE 7 TO WS-EXPECT-NUM
    MOVE WS-LEN TO WS-ACTUAL-NUM
    CALL "PLBT-ASSERT-NUM" USING "trailing spaces are not counted"
        WS-EXPECT-NUM WS-ACTUAL-NUM

    MOVE "   MOVE A TO B" TO WS-TEXT
    CALL "PLB-STR-LENGTH" USING WS-TEXT WS-LEN
    MOVE 14 TO WS-EXPECT-NUM
    MOVE WS-LEN TO WS-ACTUAL-NUM
    CALL "PLBT-ASSERT-NUM" USING "leading spaces are counted"
        WS-EXPECT-NUM WS-ACTUAL-NUM

    MOVE "ABC" TO WS-SHORT
    CALL "PLB-STR-LENGTH" USING WS-SHORT WS-LEN
    MOVE 3 TO WS-EXPECT-NUM
    MOVE WS-LEN TO WS-ACTUAL-NUM
    CALL "PLBT-ASSERT-NUM" USING "full field has its declared length"
        WS-EXPECT-NUM WS-ACTUAL-NUM.

TEST-UPPER.
    CALL "PLBT-CASE" USING "PLB-STR-UPPER"
    MOVE "perform para-1 thru para-9" TO WS-TEXT
    CALL "PLB-STR-UPPER" USING WS-TEXT
    CALL "PLBT-ASSERT-STR" USING "letters are folded"
        "PERFORM PARA-1 THRU PARA-9" WS-TEXT

    MOVE "Mixed-Case 01 'x'" TO WS-TEXT
    CALL "PLB-STR-UPPER" USING WS-TEXT
    CALL "PLBT-ASSERT-STR" USING "digits and punctuation unchanged"
        "MIXED-CASE 01 'X'" WS-TEXT.

TEST-STARTS-WITH.
    CALL "PLBT-CASE" USING "PLB-STR-STARTS-WITH"
    MOVE "PROCEDURE DIVISION." TO WS-TEXT
    CALL "PLB-STR-STARTS-WITH" USING WS-TEXT "PROCEDURE" WS-FLAG
    CALL "PLBT-ASSERT-FLAG" USING "matching prefix" "Y" WS-FLAG

    CALL "PLB-STR-STARTS-WITH" USING WS-TEXT "DATA" WS-FLAG
    CALL "PLBT-ASSERT-FLAG" USING "different prefix" "N" WS-FLAG

    CALL "PLB-STR-STARTS-WITH" USING WS-TEXT "     " WS-FLAG
    CALL "PLBT-ASSERT-FLAG" USING "blank prefix never matches" "N"
        WS-FLAG

    MOVE "ABC" TO WS-SHORT
    CALL "PLB-STR-STARTS-WITH" USING WS-SHORT "ABCD" WS-FLAG
    CALL "PLBT-ASSERT-FLAG" USING "prefix longer than text" "N" WS-FLAG.

TEST-FIRST-NONBLANK.
    CALL "PLBT-CASE" USING "PLB-STR-FIRST-NONBLANK"
    MOVE "       IDENTIFICATION DIVISION." TO WS-TEXT
    CALL "PLB-STR-FIRST-NONBLANK" USING WS-TEXT WS-LEN
    MOVE 8 TO WS-EXPECT-NUM
    MOVE WS-LEN TO WS-ACTUAL-NUM
    CALL "PLBT-ASSERT-NUM" USING "area A start of fixed-format line"
        WS-EXPECT-NUM WS-ACTUAL-NUM

    MOVE SPACES TO WS-TEXT
    CALL "PLB-STR-FIRST-NONBLANK" USING WS-TEXT WS-LEN
    MOVE 0 TO WS-EXPECT-NUM
    MOVE WS-LEN TO WS-ACTUAL-NUM
    CALL "PLBT-ASSERT-NUM" USING "blank text gives 0"
        WS-EXPECT-NUM WS-ACTUAL-NUM.

TEST-FROM-INT.
    CALL "PLBT-CASE" USING "PLB-STR-FROM-INT"
    MOVE 0 TO WS-VALUE
    CALL "PLB-STR-FROM-INT" USING WS-VALUE WS-TEXT WS-LEN
    CALL "PLBT-ASSERT-STR" USING "zero" "0" WS-TEXT
    MOVE 1 TO WS-EXPECT-NUM
    MOVE WS-LEN TO WS-ACTUAL-NUM
    CALL "PLBT-ASSERT-NUM" USING "zero has length 1"
        WS-EXPECT-NUM WS-ACTUAL-NUM

    MOVE 1234567 TO WS-VALUE
    CALL "PLB-STR-FROM-INT" USING WS-VALUE WS-TEXT WS-LEN
    CALL "PLBT-ASSERT-STR" USING "left-justified" "1234567" WS-TEXT
    MOVE 7 TO WS-EXPECT-NUM
    MOVE WS-LEN TO WS-ACTUAL-NUM
    CALL "PLBT-ASSERT-NUM" USING "length of digits"
        WS-EXPECT-NUM WS-ACTUAL-NUM

    MOVE -42 TO WS-VALUE
    CALL "PLB-STR-FROM-INT" USING WS-VALUE WS-TEXT WS-LEN
    CALL "PLBT-ASSERT-STR" USING "negative has leading minus" "-42"
        WS-TEXT

    MOVE 123 TO WS-VALUE
    CALL "PLB-STR-FROM-INT" USING WS-VALUE WS-TINY WS-LEN
    CALL "PLBT-ASSERT-STR" USING "overflow is visible" "**" WS-TINY
    MOVE 2 TO WS-EXPECT-NUM
    MOVE WS-LEN TO WS-ACTUAL-NUM
    CALL "PLBT-ASSERT-NUM" USING "overflow length is field length"
        WS-EXPECT-NUM WS-ACTUAL-NUM.
END PROGRAM TEST-PLBSTR.
