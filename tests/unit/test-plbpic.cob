*> Unit tests for src/lib/plbpic.cob.
IDENTIFICATION DIVISION.
PROGRAM-ID. TEST-PLBPIC.
DATA DIVISION.
WORKING-STORAGE SECTION.
COPY "plbpic.cpy".
01  WS-PIC                  PIC X(30).
01  WS-LABEL                PIC X(60).
01  WS-CATEGORY             PIC X.
01  WS-SIZE                 PIC 9(9) COMP-5.
01  WS-DIGITS               PIC 9(9) COMP-5.
01  WS-SCALE                PIC S9(9) COMP-5.
01  WS-SIGNED               PIC X.
01  WS-ERROR                PIC X(60).
01  WS-USAGE                PIC X(20).
01  WS-BYTES                PIC 9(9) COMP-5.
01  WS-EXPECT-BYTES         PIC 9(9) COMP-5.
01  WS-EXPECT-NUM           PIC S9(18) COMP-5.
01  WS-ACTUAL-NUM           PIC S9(18) COMP-5.

PROCEDURE DIVISION.
    CALL "PLBT-BEGIN" USING "plbpic"
    PERFORM TEST-VALID
    PERFORM TEST-SYMBOLIC
    PERFORM TEST-INVALID
    PERFORM TEST-STORAGE
    CALL "PLBT-END"
    STOP RUN.

*> Analyze WS-PIC and compare every field with the expectations.
CHECK-VALID.
    CALL "PLB-PIC-ANALYZE" USING WS-PIC PLB-PIC-INFO
    CALL "PLBT-ASSERT-FLAG" USING WS-LABEL WS-CATEGORY PI-CATEGORY
    MOVE WS-SIZE TO WS-EXPECT-NUM
    MOVE PI-SIZE TO WS-ACTUAL-NUM
    CALL "PLBT-ASSERT-NUM" USING "  size" WS-EXPECT-NUM WS-ACTUAL-NUM
    MOVE WS-DIGITS TO WS-EXPECT-NUM
    MOVE PI-DIGITS TO WS-ACTUAL-NUM
    CALL "PLBT-ASSERT-NUM" USING "  digits" WS-EXPECT-NUM WS-ACTUAL-NUM
    MOVE WS-SCALE TO WS-EXPECT-NUM
    MOVE PI-SCALE TO WS-ACTUAL-NUM
    CALL "PLBT-ASSERT-NUM" USING "  scale" WS-EXPECT-NUM WS-ACTUAL-NUM
    CALL "PLBT-ASSERT-FLAG" USING "  signed" WS-SIGNED PI-SIGNED.

CHECK-INVALID.
    CALL "PLB-PIC-ANALYZE" USING WS-PIC PLB-PIC-INFO
    CALL "PLBT-ASSERT-FLAG" USING WS-LABEL "?" PI-CATEGORY
    CALL "PLBT-ASSERT-STR" USING "  message" WS-ERROR PI-ERROR.

CHECK-STORAGE.
    CALL "PLB-PIC-ANALYZE" USING WS-PIC PLB-PIC-INFO
    CALL "PLB-PIC-STORAGE" USING PLB-PIC-INFO WS-USAGE WS-BYTES
    MOVE WS-EXPECT-BYTES TO WS-EXPECT-NUM
    MOVE WS-BYTES TO WS-ACTUAL-NUM
    CALL "PLBT-ASSERT-NUM" USING WS-LABEL WS-EXPECT-NUM WS-ACTUAL-NUM.

TEST-VALID.
    CALL "PLBT-CASE" USING "valid pictures"
    MOVE "X(10)" TO WS-PIC
    MOVE "X(10): alphanumeric with repetition" TO WS-LABEL
    MOVE "X" TO WS-CATEGORY
    MOVE 10 TO WS-SIZE
    MOVE 0 TO WS-DIGITS
    MOVE 0 TO WS-SCALE
    MOVE "N" TO WS-SIGNED
    PERFORM CHECK-VALID
    MOVE "XXX" TO WS-PIC
    MOVE "XXX: repeated symbols" TO WS-LABEL
    MOVE "X" TO WS-CATEGORY
    MOVE 3 TO WS-SIZE
    MOVE 0 TO WS-DIGITS
    MOVE 0 TO WS-SCALE
    MOVE "N" TO WS-SIGNED
    PERFORM CHECK-VALID
    MOVE "A(5)" TO WS-PIC
    MOVE "A(5): alphabetic" TO WS-LABEL
    MOVE "A" TO WS-CATEGORY
    MOVE 5 TO WS-SIZE
    MOVE 0 TO WS-DIGITS
    MOVE 0 TO WS-SCALE
    MOVE "N" TO WS-SIGNED
    PERFORM CHECK-VALID
    MOVE "AA99" TO WS-PIC
    MOVE "AA99: A with 9 is alphanumeric" TO WS-LABEL
    MOVE "X" TO WS-CATEGORY
    MOVE 4 TO WS-SIZE
    MOVE 2 TO WS-DIGITS
    MOVE 0 TO WS-SCALE
    MOVE "N" TO WS-SIGNED
    PERFORM CHECK-VALID
    MOVE "9(5)" TO WS-PIC
    MOVE "9(5): unsigned integer" TO WS-LABEL
    MOVE "9" TO WS-CATEGORY
    MOVE 5 TO WS-SIZE
    MOVE 5 TO WS-DIGITS
    MOVE 0 TO WS-SCALE
    MOVE "N" TO WS-SIGNED
    PERFORM CHECK-VALID
    MOVE "S9(7)V99" TO WS-PIC
    MOVE "S9(7)V99: signed with implied decimals" TO WS-LABEL
    MOVE "9" TO WS-CATEGORY
    MOVE 9 TO WS-SIZE
    MOVE 9 TO WS-DIGITS
    MOVE 2 TO WS-SCALE
    MOVE "Y" TO WS-SIGNED
    PERFORM CHECK-VALID
    MOVE "s9(3)v9" TO WS-PIC
    MOVE "s9(3)v9: lower case accepted" TO WS-LABEL
    MOVE "9" TO WS-CATEGORY
    MOVE 4 TO WS-SIZE
    MOVE 4 TO WS-DIGITS
    MOVE 1 TO WS-SCALE
    MOVE "Y" TO WS-SIGNED
    PERFORM CHECK-VALID
    MOVE "99PPP" TO WS-PIC
    MOVE "99PPP: P scaling to the right" TO WS-LABEL
    MOVE "9" TO WS-CATEGORY
    MOVE 2 TO WS-SIZE
    MOVE 5 TO WS-DIGITS
    MOVE -3 TO WS-SCALE
    MOVE "N" TO WS-SIGNED
    PERFORM CHECK-VALID
    MOVE "PPP99" TO WS-PIC
    MOVE "PPP99: P scaling to the left" TO WS-LABEL
    MOVE "9" TO WS-CATEGORY
    MOVE 2 TO WS-SIZE
    MOVE 5 TO WS-DIGITS
    MOVE 5 TO WS-SCALE
    MOVE "N" TO WS-SIGNED
    PERFORM CHECK-VALID
    MOVE "VPP9" TO WS-PIC
    MOVE "VPP9: V then P" TO WS-LABEL
    MOVE "9" TO WS-CATEGORY
    MOVE 1 TO WS-SIZE
    MOVE 3 TO WS-DIGITS
    MOVE 3 TO WS-SCALE
    MOVE "N" TO WS-SIGNED
    PERFORM CHECK-VALID
    MOVE "ZZ,ZZ9.99" TO WS-PIC
    MOVE "ZZ,ZZ9.99: zero suppression and point" TO WS-LABEL
    MOVE "E" TO WS-CATEGORY
    MOVE 9 TO WS-SIZE
    MOVE 7 TO WS-DIGITS
    MOVE 2 TO WS-SCALE
    MOVE "N" TO WS-SIGNED
    PERFORM CHECK-VALID
    MOVE "$$,$$9.99" TO WS-PIC
    MOVE "$$,$$9.99: floating currency" TO WS-LABEL
    MOVE "E" TO WS-CATEGORY
    MOVE 9 TO WS-SIZE
    MOVE 6 TO WS-DIGITS
    MOVE 2 TO WS-SCALE
    MOVE "N" TO WS-SIGNED
    PERFORM CHECK-VALID
    MOVE "+++9" TO WS-PIC
    MOVE "+++9: floating plus" TO WS-LABEL
    MOVE "E" TO WS-CATEGORY
    MOVE 4 TO WS-SIZE
    MOVE 3 TO WS-DIGITS
    MOVE 0 TO WS-SCALE
    MOVE "Y" TO WS-SIGNED
    PERFORM CHECK-VALID
    MOVE "-9(4)" TO WS-PIC
    MOVE "-9(4): fixed leading minus" TO WS-LABEL
    MOVE "E" TO WS-CATEGORY
    MOVE 5 TO WS-SIZE
    MOVE 4 TO WS-DIGITS
    MOVE 0 TO WS-SCALE
    MOVE "Y" TO WS-SIGNED
    PERFORM CHECK-VALID
    MOVE "9(4)-" TO WS-PIC
    MOVE "9(4)-: fixed trailing minus" TO WS-LABEL
    MOVE "E" TO WS-CATEGORY
    MOVE 5 TO WS-SIZE
    MOVE 4 TO WS-DIGITS
    MOVE 0 TO WS-SCALE
    MOVE "Y" TO WS-SIGNED
    PERFORM CHECK-VALID
    MOVE "9(5)CR" TO WS-PIC
    MOVE "9(5)CR: credit symbol" TO WS-LABEL
    MOVE "E" TO WS-CATEGORY
    MOVE 7 TO WS-SIZE
    MOVE 5 TO WS-DIGITS
    MOVE 0 TO WS-SCALE
    MOVE "Y" TO WS-SIGNED
    PERFORM CHECK-VALID
    MOVE "***,**9.99DB" TO WS-PIC
    MOVE "***,**9.99DB: check protection and debit" TO WS-LABEL
    MOVE "E" TO WS-CATEGORY
    MOVE 12 TO WS-SIZE
    MOVE 8 TO WS-DIGITS
    MOVE 2 TO WS-SCALE
    MOVE "Y" TO WS-SIGNED
    PERFORM CHECK-VALID
    MOVE "99/99/9999" TO WS-PIC
    MOVE "99/99/9999: numeric with slash insertion" TO WS-LABEL
    MOVE "E" TO WS-CATEGORY
    MOVE 10 TO WS-SIZE
    MOVE 8 TO WS-DIGITS
    MOVE 0 TO WS-SCALE
    MOVE "N" TO WS-SIGNED
    PERFORM CHECK-VALID
    MOVE "AAB9" TO WS-PIC
    MOVE "AAB9: insertion makes it alphanumeric-edited" TO WS-LABEL
    MOVE "D" TO WS-CATEGORY
    MOVE 4 TO WS-SIZE
    MOVE 1 TO WS-DIGITS
    MOVE 0 TO WS-SCALE
    MOVE "N" TO WS-SIGNED
    PERFORM CHECK-VALID
    MOVE "XX/XX" TO WS-PIC
    MOVE "XX/XX: alphanumeric-edited" TO WS-LABEL
    MOVE "D" TO WS-CATEGORY
    MOVE 5 TO WS-SIZE
    MOVE 0 TO WS-DIGITS
    MOVE 0 TO WS-SCALE
    MOVE "N" TO WS-SIGNED
    PERFORM CHECK-VALID
    MOVE "X(3)B0X" TO WS-PIC
    MOVE "X(3)B0X: space and zero insertion" TO WS-LABEL
    MOVE "D" TO WS-CATEGORY
    MOVE 6 TO WS-SIZE
    MOVE 0 TO WS-DIGITS
    MOVE 0 TO WS-SCALE
    MOVE "N" TO WS-SIGNED
    PERFORM CHECK-VALID
    MOVE "N(10)" TO WS-PIC
    MOVE "N(10): national" TO WS-LABEL
    MOVE "N" TO WS-CATEGORY
    MOVE 10 TO WS-SIZE
    MOVE 0 TO WS-DIGITS
    MOVE 0 TO WS-SCALE
    MOVE "N" TO WS-SIGNED
    PERFORM CHECK-VALID
    MOVE "NNBNN" TO WS-PIC
    MOVE "NNBNN: national-edited" TO WS-LABEL
    MOVE "M" TO WS-CATEGORY
    MOVE 5 TO WS-SIZE
    MOVE 0 TO WS-DIGITS
    MOVE 0 TO WS-SCALE
    MOVE "N" TO WS-SIGNED
    PERFORM CHECK-VALID
    MOVE "1(8)" TO WS-PIC
    MOVE "1(8): boolean" TO WS-LABEL
    MOVE "1" TO WS-CATEGORY
    MOVE 8 TO WS-SIZE
    MOVE 0 TO WS-DIGITS
    MOVE 0 TO WS-SCALE
    MOVE "N" TO WS-SIGNED
    PERFORM CHECK-VALID
    MOVE "9(38)" TO WS-PIC
    MOVE "9(38): 38 digits is the limit" TO WS-LABEL
    MOVE "9" TO WS-CATEGORY
    MOVE 38 TO WS-SIZE
    MOVE 38 TO WS-DIGITS
    MOVE 0 TO WS-SCALE
    MOVE "N" TO WS-SIGNED
    PERFORM CHECK-VALID
    MOVE "X(60000)" TO WS-PIC
    MOVE "X(60000): large repetition" TO WS-LABEL
    MOVE "X" TO WS-CATEGORY
    MOVE 60000 TO WS-SIZE
    MOVE 0 TO WS-DIGITS
    MOVE 0 TO WS-SCALE
    MOVE "N" TO WS-SIGNED
    PERFORM CHECK-VALID.

TEST-SYMBOLIC.
    CALL "PLBT-CASE" USING "constant names as repetition counts"
    MOVE "X(MAX-LEN)" TO WS-PIC
    CALL "PLB-PIC-ANALYZE" USING WS-PIC PLB-PIC-INFO
    CALL "PLBT-ASSERT-FLAG" USING "accepted as alphanumeric" "X"
        PI-CATEGORY
    CALL "PLBT-ASSERT-FLAG" USING "flagged as symbolic" "Y" PI-SYMBOLIC
    MOVE "9(5)" TO WS-PIC
    CALL "PLB-PIC-ANALYZE" USING WS-PIC PLB-PIC-INFO
    CALL "PLBT-ASSERT-FLAG" USING "numeric count is not symbolic" "N"
        PI-SYMBOLIC.

TEST-INVALID.
    CALL "PLBT-CASE" USING "invalid pictures"
    MOVE SPACES TO WS-PIC
    MOVE "rejects ''" TO WS-LABEL
    MOVE "empty picture" TO WS-ERROR
    PERFORM CHECK-INVALID
    MOVE "X(10" TO WS-PIC
    MOVE "rejects 'X(10'" TO WS-LABEL
    MOVE "unbalanced parenthesis" TO WS-ERROR
    PERFORM CHECK-INVALID
    MOVE "X()" TO WS-PIC
    MOVE "rejects 'X()'" TO WS-LABEL
    MOVE "empty repetition count" TO WS-ERROR
    PERFORM CHECK-INVALID
    MOVE "X(1A)" TO WS-PIC
    MOVE "rejects 'X(1A)'" TO WS-LABEL
    MOVE "repetition count is not a number" TO WS-ERROR
    PERFORM CHECK-INVALID
    MOVE "X(0)" TO WS-PIC
    MOVE "rejects 'X(0)'" TO WS-LABEL
    MOVE "repetition count must be at least 1" TO WS-ERROR
    PERFORM CHECK-INVALID
    MOVE "9S99" TO WS-PIC
    MOVE "rejects '9S99'" TO WS-LABEL
    MOVE "S must appear once, as the first symbol" TO WS-ERROR
    PERFORM CHECK-INVALID
    MOVE "9V9V9" TO WS-PIC
    MOVE "rejects '9V9V9'" TO WS-LABEL
    MOVE "more than one V" TO WS-ERROR
    PERFORM CHECK-INVALID
    MOVE "99.99.9" TO WS-PIC
    MOVE "rejects '99.99.9'" TO WS-LABEL
    MOVE "more than one decimal point" TO WS-ERROR
    PERFORM CHECK-INVALID
    MOVE "9V9.9" TO WS-PIC
    MOVE "rejects '9V9.9'" TO WS-LABEL
    MOVE "both V and a decimal point" TO WS-ERROR
    PERFORM CHECK-INVALID
    MOVE "9(39)" TO WS-PIC
    MOVE "rejects '9(39)'" TO WS-LABEL
    MOVE "more than 38 digit positions" TO WS-ERROR
    PERFORM CHECK-INVALID
    MOVE "XQX" TO WS-PIC
    MOVE "rejects 'XQX'" TO WS-LABEL
    MOVE "invalid character 'Q' in picture" TO WS-ERROR
    PERFORM CHECK-INVALID
    MOVE "S9(3).99" TO WS-PIC
    MOVE "rejects 'S9(3).99'" TO WS-LABEL
    MOVE "S cannot be used in an edited picture" TO WS-ERROR
    PERFORM CHECK-INVALID
    MOVE "X9V9" TO WS-PIC
    MOVE "rejects 'X9V9'" TO WS-LABEL
    MOVE "numeric symbols in an alphanumeric picture" TO WS-ERROR
    PERFORM CHECK-INVALID
    MOVE "N9" TO WS-PIC
    MOVE "rejects 'N9'" TO WS-LABEL
    MOVE "national positions mixed with other symbols" TO WS-ERROR
    PERFORM CHECK-INVALID
    MOVE "1X" TO WS-PIC
    MOVE "rejects '1X'" TO WS-LABEL
    MOVE "boolean positions mixed with other symbols" TO WS-ERROR
    PERFORM CHECK-INVALID
    MOVE "V" TO WS-PIC
    MOVE "rejects 'V'" TO WS-LABEL
    MOVE "picture has no character positions" TO WS-ERROR
    PERFORM CHECK-INVALID.

TEST-STORAGE.
    CALL "PLBT-CASE" USING "PLB-PIC-STORAGE"
    MOVE "9(5)" TO WS-PIC
    MOVE SPACES TO WS-USAGE
    MOVE 5 TO WS-EXPECT-BYTES
    MOVE "display size" TO WS-LABEL
    PERFORM CHECK-STORAGE
    MOVE "9(5)" TO WS-PIC
    MOVE "DISPLAY" TO WS-USAGE
    MOVE 5 TO WS-EXPECT-BYTES
    MOVE "explicit DISPLAY" TO WS-LABEL
    PERFORM CHECK-STORAGE
    MOVE "S9(7)V99" TO WS-PIC
    MOVE "COMP-3" TO WS-USAGE
    MOVE 5 TO WS-EXPECT-BYTES
    MOVE "packed: 9 digits" TO WS-LABEL
    PERFORM CHECK-STORAGE
    MOVE "S9(4)" TO WS-PIC
    MOVE "PACKED-DECIMAL" TO WS-USAGE
    MOVE 3 TO WS-EXPECT-BYTES
    MOVE "packed: 4 digits" TO WS-LABEL
    PERFORM CHECK-STORAGE
    MOVE "9(4)" TO WS-PIC
    MOVE "BINARY" TO WS-USAGE
    MOVE 2 TO WS-EXPECT-BYTES
    MOVE "binary up to 4 digits" TO WS-LABEL
    PERFORM CHECK-STORAGE
    MOVE "S9(9)" TO WS-PIC
    MOVE "COMP" TO WS-USAGE
    MOVE 4 TO WS-EXPECT-BYTES
    MOVE "binary up to 9 digits" TO WS-LABEL
    PERFORM CHECK-STORAGE
    MOVE "9(18)" TO WS-PIC
    MOVE "COMP-5" TO WS-USAGE
    MOVE 8 TO WS-EXPECT-BYTES
    MOVE "binary up to 18 digits" TO WS-LABEL
    PERFORM CHECK-STORAGE
    MOVE "9(20)" TO WS-PIC
    MOVE "COMP-4" TO WS-USAGE
    MOVE 16 TO WS-EXPECT-BYTES
    MOVE "binary beyond 18 digits" TO WS-LABEL
    PERFORM CHECK-STORAGE
    MOVE "9(3)" TO WS-PIC
    MOVE "COMP-X" TO WS-USAGE
    MOVE 2 TO WS-EXPECT-BYTES
    MOVE "COMP-X by digits" TO WS-LABEL
    PERFORM CHECK-STORAGE
    MOVE "N(10)" TO WS-PIC
    MOVE SPACES TO WS-USAGE
    MOVE 20 TO WS-EXPECT-BYTES
    MOVE "national is two bytes each" TO WS-LABEL
    PERFORM CHECK-STORAGE
    MOVE "X" TO WS-PIC
    MOVE "COMP-1" TO WS-USAGE
    MOVE 4 TO WS-EXPECT-BYTES
    MOVE "COMP-1 ignores the picture" TO WS-LABEL
    PERFORM CHECK-STORAGE
    MOVE "X" TO WS-PIC
    MOVE "COMP-2" TO WS-USAGE
    MOVE 8 TO WS-EXPECT-BYTES
    MOVE "COMP-2" TO WS-LABEL
    PERFORM CHECK-STORAGE
    MOVE "X" TO WS-PIC
    MOVE "POINTER" TO WS-USAGE
    MOVE 8 TO WS-EXPECT-BYTES
    MOVE "pointer" TO WS-LABEL
    PERFORM CHECK-STORAGE
    MOVE "X" TO WS-PIC
    MOVE "BINARY-CHAR" TO WS-USAGE
    MOVE 1 TO WS-EXPECT-BYTES
    MOVE "binary-char" TO WS-LABEL
    PERFORM CHECK-STORAGE
    MOVE "X" TO WS-PIC
    MOVE "index" TO WS-USAGE
    MOVE 4 TO WS-EXPECT-BYTES
    MOVE "usage is case-insensitive" TO WS-LABEL
    PERFORM CHECK-STORAGE.
END PROGRAM TEST-PLBPIC.
