*> Unit tests for src/lib/plbstream.cob.
IDENTIFICATION DIVISION.
PROGRAM-ID. TEST-PLBSTREAM.
DATA DIVISION.
WORKING-STORAGE SECTION.
COPY "plbsrcc.cpy".
COPY "plbsrc.cpy".
COPY "plbdiag.cpy".
COPY "plbstrm.cpy".
01  WS-MODE                 PIC X VALUE "X".
01  WS-DEBUG                PIC X.
01  WS-FILE-ID              PIC 9(4) COMP-5.
01  WS-STATUS               PIC 9(4) COMP-5.
01  WS-EXPECT               PIC X(200).
01  WS-POS                  PIC 9(9) COMP-5.
01  WS-SEGMENT              PIC 9(9) COMP-5.
01  WS-LINE                 PIC 9(9) COMP-5.
01  WS-COLUMN               PIC 9(4) COMP-5.
01  WS-EXPECT-NUM           PIC S9(18) COMP-5.
01  WS-ACTUAL-NUM           PIC S9(18) COMP-5.

PROCEDURE DIVISION.
    CALL "PLBT-BEGIN" USING "plbstream"
    PERFORM TEST-LITERAL-CONTINUATION
    PERFORM TEST-WORD-CONTINUATION
    PERFORM TEST-DEBUG-LINES
    PERFORM TEST-LOCATE
    PERFORM TEST-ORPHAN-CONTINUATION
    PERFORM TEST-EMPTY
    CALL "PLBT-END"
    STOP RUN.

LOAD-STREAM-FIXTURE.
    CALL "PLB-SRC-INIT" USING PLB-SOURCE-SET
    CALL "PLB-DIAG-INIT" USING PLB-DIAGNOSTICS
    CALL "PLB-SRC-LOAD" USING PLB-SOURCE-SET PLB-DIAGNOSTICS
        "tests/fixtures/lexer/stream.cbl" WS-MODE WS-FILE-ID WS-STATUS
    CALL "PLB-STREAM-BUILD" USING PLB-SOURCE-SET PLB-DIAGNOSTICS
        PLB-STREAM WS-FILE-ID WS-DEBUG.

TEST-LITERAL-CONTINUATION.
    CALL "PLBT-CASE" USING "continued literal"
    MOVE "N" TO WS-DEBUG
    PERFORM LOAD-STREAM-FIXTURE
    *> "HELLO ends in column 27, so 45 spaces pad it to column 72,
    *> and the continuation resumes after its opening quote.
    MOVE SPACES TO WS-EXPECT
    MOVE "01  MSG VALUE ""HELLO" TO WS-EXPECT(1:20)
    MOVE "WORLD""." TO WS-EXPECT(66:7)
    CALL "PLBT-ASSERT-STR" USING "literal padded and joined"
        WS-EXPECT(1:72) ST-TEXT(1:72)
    MOVE 65 TO WS-EXPECT-NUM
    MOVE SG-LEN(1) TO WS-ACTUAL-NUM
    CALL "PLBT-ASSERT-NUM" USING "first segment includes padding"
        WS-EXPECT-NUM WS-ACTUAL-NUM
    MOVE 13 TO WS-EXPECT-NUM
    MOVE SG-COL(2) TO WS-ACTUAL-NUM
    CALL "PLBT-ASSERT-NUM" USING "continuation starts after quote"
        WS-EXPECT-NUM WS-ACTUAL-NUM
    MOVE 0 TO WS-EXPECT-NUM
    MOVE DG-COUNT TO WS-ACTUAL-NUM
    CALL "PLBT-ASSERT-NUM" USING "no diagnostics"
        WS-EXPECT-NUM WS-ACTUAL-NUM.

TEST-WORD-CONTINUATION.
    CALL "PLBT-CASE" USING "continued word"
    *> Segment 2 ends at 72; the newline is 73; line 3 starts at 74.
    CALL "PLBT-ASSERT-STR" USING "newline between lines" X"0A"
        ST-TEXT(73:1)
    CALL "PLBT-ASSERT-STR" USING "word joined across comment line"
        "01  LONG-NAME-PART-TWO PIC X." ST-TEXT(74:29)
    MOVE 5 TO WS-EXPECT-NUM
    MOVE ST-SEG-COUNT TO WS-ACTUAL-NUM
    CALL "PLBT-ASSERT-NUM" USING "debugging line left out"
        WS-EXPECT-NUM WS-ACTUAL-NUM.

TEST-DEBUG-LINES.
    CALL "PLBT-CASE" USING "debugging mode"
    MOVE "Y" TO WS-DEBUG
    PERFORM LOAD-STREAM-FIXTURE
    MOVE 6 TO WS-EXPECT-NUM
    MOVE ST-SEG-COUNT TO WS-ACTUAL-NUM
    CALL "PLBT-ASSERT-NUM" USING "debugging line included"
        WS-EXPECT-NUM WS-ACTUAL-NUM
    CALL "PLBT-ASSERT-STR" USING "debugging text in stream"
        "DISPLAY ""DEBUG""." ST-TEXT(SG-START(5):SG-LEN(5))
    MOVE 6 TO WS-EXPECT-NUM
    MOVE SL-LINE-NO(SG-LINE(5)) TO WS-ACTUAL-NUM
    CALL "PLBT-ASSERT-NUM" USING "segment points at line 6"
        WS-EXPECT-NUM WS-ACTUAL-NUM
    MOVE "N" TO WS-DEBUG.

TEST-LOCATE.
    CALL "PLBT-CASE" USING "PLB-STREAM-LOCATE"
    PERFORM LOAD-STREAM-FIXTURE
    MOVE 5 TO WS-POS
    MOVE 1 TO WS-SEGMENT
    CALL "PLB-STREAM-LOCATE" USING PLB-STREAM WS-POS WS-SEGMENT
        WS-LINE WS-COLUMN
    MOVE 12 TO WS-EXPECT-NUM
    MOVE WS-COLUMN TO WS-ACTUAL-NUM
    CALL "PLBT-ASSERT-NUM" USING "column in first line"
        WS-EXPECT-NUM WS-ACTUAL-NUM

    MOVE 66 TO WS-POS
    CALL "PLB-STREAM-LOCATE" USING PLB-STREAM WS-POS WS-SEGMENT
        WS-LINE WS-COLUMN
    MOVE 2 TO WS-EXPECT-NUM
    MOVE SL-LINE-NO(WS-LINE) TO WS-ACTUAL-NUM
    CALL "PLBT-ASSERT-NUM" USING "continuation maps to line 2"
        WS-EXPECT-NUM WS-ACTUAL-NUM
    MOVE 13 TO WS-EXPECT-NUM
    MOVE WS-COLUMN TO WS-ACTUAL-NUM
    CALL "PLBT-ASSERT-NUM" USING "column after the quote"
        WS-EXPECT-NUM WS-ACTUAL-NUM

    MOVE 73 TO WS-POS
    CALL "PLB-STREAM-LOCATE" USING PLB-STREAM WS-POS WS-SEGMENT
        WS-LINE WS-COLUMN
    MOVE 19 TO WS-EXPECT-NUM
    MOVE WS-COLUMN TO WS-ACTUAL-NUM
    CALL "PLBT-ASSERT-NUM" USING "newline maps to end of line"
        WS-EXPECT-NUM WS-ACTUAL-NUM

    MOVE 1 TO WS-POS
    CALL "PLB-STREAM-LOCATE" USING PLB-STREAM WS-POS WS-SEGMENT
        WS-LINE WS-COLUMN
    MOVE 8 TO WS-EXPECT-NUM
    MOVE WS-COLUMN TO WS-ACTUAL-NUM
    CALL "PLBT-ASSERT-NUM" USING "moving backwards restarts search"
        WS-EXPECT-NUM WS-ACTUAL-NUM.

TEST-ORPHAN-CONTINUATION.
    CALL "PLBT-CASE" USING "malformed continuations"
    CALL "PLB-SRC-INIT" USING PLB-SOURCE-SET
    CALL "PLB-DIAG-INIT" USING PLB-DIAGNOSTICS
    CALL "PLB-SRC-LOAD" USING PLB-SOURCE-SET PLB-DIAGNOSTICS
        "tests/fixtures/lexer/orphan-cont.cbl" WS-MODE WS-FILE-ID
        WS-STATUS
    CALL "PLB-STREAM-BUILD" USING PLB-SOURCE-SET PLB-DIAGNOSTICS
        PLB-STREAM WS-FILE-ID WS-DEBUG
    MOVE 2 TO WS-EXPECT-NUM
    MOVE DG-COUNT TO WS-ACTUAL-NUM
    CALL "PLBT-ASSERT-NUM" USING "two warnings"
        WS-EXPECT-NUM WS-ACTUAL-NUM
    CALL "PLBT-ASSERT-STR" USING "orphan continuation" "LX006"
        DG-CODE(1)
    CALL "PLBT-ASSERT-STR" USING "missing resume quote" "LX007"
        DG-CODE(2)
    CALL "PLBT-ASSERT-STR" USING "orphan kept as code" "ORPHAN."
        ST-TEXT(1:7).

TEST-EMPTY.
    CALL "PLBT-CASE" USING "empty input"
    MOVE 99 TO WS-FILE-ID
    CALL "PLB-STREAM-BUILD" USING PLB-SOURCE-SET PLB-DIAGNOSTICS
        PLB-STREAM WS-FILE-ID WS-DEBUG
    MOVE 0 TO WS-EXPECT-NUM
    MOVE ST-LEN TO WS-ACTUAL-NUM
    CALL "PLBT-ASSERT-NUM" USING "unknown file gives empty stream"
        WS-EXPECT-NUM WS-ACTUAL-NUM
    MOVE 1 TO WS-POS
    CALL "PLB-STREAM-LOCATE" USING PLB-STREAM WS-POS WS-SEGMENT
        WS-LINE WS-COLUMN
    MOVE 0 TO WS-EXPECT-NUM
    MOVE WS-LINE TO WS-ACTUAL-NUM
    CALL "PLBT-ASSERT-NUM" USING "locate in empty stream gives 0"
        WS-EXPECT-NUM WS-ACTUAL-NUM.
END PROGRAM TEST-PLBSTREAM.
