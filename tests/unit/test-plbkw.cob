*> Unit tests for src/lib/plbkw.cob.
IDENTIFICATION DIVISION.
PROGRAM-ID. TEST-PLBKW.
DATA DIVISION.
WORKING-STORAGE SECTION.
01  WS-KIND                 PIC X.
01  WS-COUNT                PIC 9(9) COMP-5.
01  WS-BAD                  PIC 9(9) COMP-5.
01  WS-EXPECT-NUM           PIC S9(18) COMP-5.
01  WS-ACTUAL-NUM           PIC S9(18) COMP-5.

PROCEDURE DIVISION.
    CALL "PLBT-BEGIN" USING "plbkw"
    PERFORM TEST-TABLE-ORDER
    PERFORM TEST-KINDS
    PERFORM TEST-NOT-RESERVED
    CALL "PLBT-END"
    STOP RUN.

TEST-TABLE-ORDER.
    CALL "PLBT-CASE" USING "table order"
    CALL "PLB-KW-SELF-CHECK" USING WS-COUNT WS-BAD
    MOVE 0 TO WS-EXPECT-NUM
    MOVE WS-BAD TO WS-ACTUAL-NUM
    CALL "PLBT-ASSERT-NUM" USING "entries strictly ascending"
        WS-EXPECT-NUM WS-ACTUAL-NUM
    IF WS-COUNT > 400
        MOVE "Y" TO WS-KIND
    ELSE
        MOVE "N" TO WS-KIND
    END-IF
    CALL "PLBT-ASSERT-FLAG" USING "table has over 400 words" "Y"
        WS-KIND.

TEST-KINDS.
    CALL "PLBT-CASE" USING "word kinds"
    CALL "PLB-KW-LOOKUP" USING "MOVE" WS-KIND
    CALL "PLBT-ASSERT-FLAG" USING "MOVE is a verb" "V" WS-KIND
    CALL "PLB-KW-LOOKUP" USING "ACCEPT" WS-KIND
    CALL "PLBT-ASSERT-FLAG" USING "first entry found" "V" WS-KIND
    CALL "PLB-KW-LOOKUP" USING "ZEROS" WS-KIND
    CALL "PLBT-ASSERT-FLAG" USING "ZEROS is figurative" "F" WS-KIND
    CALL "PLB-KW-LOOKUP" USING "END-PERFORM" WS-KIND
    CALL "PLBT-ASSERT-FLAG" USING "END-PERFORM terminates" "T" WS-KIND
    CALL "PLB-KW-LOOKUP" USING "RETURN-CODE" WS-KIND
    CALL "PLBT-ASSERT-FLAG" USING "RETURN-CODE is a register" "S"
        WS-KIND
    CALL "PLB-KW-LOOKUP" USING "WORKING-STORAGE" WS-KIND
    CALL "PLBT-ASSERT-FLAG" USING "last entry found" "R" WS-KIND
    CALL "PLB-KW-LOOKUP" USING "PIC" WS-KIND
    CALL "PLBT-ASSERT-FLAG" USING "PIC is reserved" "R" WS-KIND
    CALL "PLB-KW-LOOKUP" USING "GO" WS-KIND
    CALL "PLBT-ASSERT-FLAG" USING "GO starts a statement" "V" WS-KIND.

TEST-NOT-RESERVED.
    CALL "PLBT-CASE" USING "user words"
    CALL "PLB-KW-LOOKUP" USING "WS-TOTAL" WS-KIND
    CALL "PLBT-ASSERT-FLAG" USING "data name" " " WS-KIND
    CALL "PLB-KW-LOOKUP" USING "MOVES" WS-KIND
    CALL "PLBT-ASSERT-FLAG" USING "near miss" " " WS-KIND
    CALL "PLB-KW-LOOKUP" USING "A" WS-KIND
    CALL "PLBT-ASSERT-FLAG" USING "before the first entry" " " WS-KIND
    CALL "PLB-KW-LOOKUP" USING "ZZZ" WS-KIND
    CALL "PLBT-ASSERT-FLAG" USING "after the last entry" " " WS-KIND
    CALL "PLB-KW-LOOKUP" USING
        "A-NAME-THAT-IS-LONGER-THAN-THIRTY-ONE" WS-KIND
    CALL "PLBT-ASSERT-FLAG" USING "overlong word" " " WS-KIND
    CALL "PLB-KW-LOOKUP" USING " " WS-KIND
    CALL "PLBT-ASSERT-FLAG" USING "blank" " " WS-KIND.
END PROGRAM TEST-PLBKW.
