*> Unit tests for src/lib/plbast.cob.
IDENTIFICATION DIVISION.
PROGRAM-ID. TEST-PLBAST.
DATA DIVISION.
WORKING-STORAGE SECTION.
COPY "plbastc.cpy".
COPY "plbast.cpy".
01  WS-ROOT                 PIC 9(9) COMP-5.
01  WS-A                    PIC 9(9) COMP-5.
01  WS-B                    PIC 9(9) COMP-5.
01  WS-C                    PIC 9(9) COMP-5.
01  WS-D                    PIC 9(9) COMP-5.
01  WS-ZERO                 PIC 9(9) COMP-5 VALUE 0.
01  WS-TOKEN                PIC 9(9) COMP-5 VALUE 7.
01  WS-NODE                 PIC 9(9) COMP-5.
01  WS-DEPTH                PIC S9(9) COMP-5.
01  WS-COUNT                PIC 9(9) COMP-5.
01  WS-ORDER                PIC X(40).
01  WS-PTR                  PIC 9(4) COMP-5.
01  WS-DEPTHS               PIC X(40).
01  WS-DPTR                 PIC 9(4) COMP-5.
01  WS-DIGIT                PIC 9.
01  WS-EXPECT-NUM           PIC S9(18) COMP-5.
01  WS-ACTUAL-NUM           PIC S9(18) COMP-5.

PROCEDURE DIVISION.
    CALL "PLBT-BEGIN" USING "plbast"
    PERFORM BUILD-TREE
    PERFORM TEST-LINKS
    PERFORM TEST-WALK
    PERFORM TEST-SUBTREE-WALK
    PERFORM TEST-EDGES
    CALL "PLBT-END"
    STOP RUN.

*> ROOT
*>  +- A
*>  |   +- C
*>  |   +- D
*>  +- B
BUILD-TREE.
    CALL "PLB-AST-INIT" USING PLB-AST
    CALL "PLB-AST-ADD" USING PLB-AST WS-ZERO "UNIT" "ROOT" WS-TOKEN
        WS-ROOT
    CALL "PLB-AST-ADD" USING PLB-AST WS-ROOT "PROG" "A" WS-TOKEN WS-A
    CALL "PLB-AST-ADD" USING PLB-AST WS-ROOT "PROG" "B" WS-TOKEN WS-B
    CALL "PLB-AST-ADD" USING PLB-AST WS-A "PARA" "C" WS-TOKEN WS-C
    CALL "PLB-AST-ADD" USING PLB-AST WS-A "PARA" "D" WS-TOKEN WS-D.

TEST-LINKS.
    CALL "PLBT-CASE" USING "PLB-AST-ADD"
    MOVE 5 TO WS-EXPECT-NUM
    MOVE AS-COUNT TO WS-ACTUAL-NUM
    CALL "PLBT-ASSERT-NUM" USING "five nodes" WS-EXPECT-NUM WS-ACTUAL-NUM
    MOVE WS-A TO WS-EXPECT-NUM
    MOVE ND-FIRST(WS-ROOT) TO WS-ACTUAL-NUM
    CALL "PLBT-ASSERT-NUM" USING "first child of root"
        WS-EXPECT-NUM WS-ACTUAL-NUM
    MOVE WS-B TO WS-EXPECT-NUM
    MOVE ND-LAST(WS-ROOT) TO WS-ACTUAL-NUM
    CALL "PLBT-ASSERT-NUM" USING "last child of root"
        WS-EXPECT-NUM WS-ACTUAL-NUM
    MOVE ND-NEXT(WS-A) TO WS-ACTUAL-NUM
    CALL "PLBT-ASSERT-NUM" USING "sibling link"
        WS-EXPECT-NUM WS-ACTUAL-NUM
    MOVE WS-A TO WS-EXPECT-NUM
    MOVE ND-PARENT(WS-D) TO WS-ACTUAL-NUM
    CALL "PLBT-ASSERT-NUM" USING "parent link"
        WS-EXPECT-NUM WS-ACTUAL-NUM
    MOVE 7 TO WS-EXPECT-NUM
    MOVE ND-TOK-LAST(WS-D) TO WS-ACTUAL-NUM
    CALL "PLBT-ASSERT-NUM" USING "token range starts at the token"
        WS-EXPECT-NUM WS-ACTUAL-NUM
    CALL "PLBT-ASSERT-STR" USING "kind stored" "PARA" ND-KIND(WS-C)
    CALL "PLBT-ASSERT-STR" USING "detail stored" "C" ND-DETAIL(WS-C)
    CALL "PLB-AST-CHILD-COUNT" USING PLB-AST WS-A WS-COUNT
    MOVE 2 TO WS-EXPECT-NUM
    MOVE WS-COUNT TO WS-ACTUAL-NUM
    CALL "PLBT-ASSERT-NUM" USING "two children of A"
        WS-EXPECT-NUM WS-ACTUAL-NUM.

*> Record the detail of each node visited, and its depth.
WALK.
    MOVE SPACES TO WS-ORDER WS-DEPTHS
    MOVE 1 TO WS-PTR WS-DPTR
    MOVE WS-NODE TO WS-ROOT
    MOVE 0 TO WS-DEPTH
    PERFORM UNTIL WS-NODE = 0
        STRING FUNCTION TRIM(ND-DETAIL(WS-NODE)) " " DELIMITED BY SIZE
            INTO WS-ORDER WITH POINTER WS-PTR
        *> plumbline: ignore move-truncation -- the test tree is three levels deep
        MOVE WS-DEPTH TO WS-DIGIT
        STRING WS-DIGIT DELIMITED BY SIZE
            INTO WS-DEPTHS WITH POINTER WS-DPTR
        CALL "PLB-AST-NEXT" USING PLB-AST WS-ROOT WS-NODE WS-DEPTH
    END-PERFORM
    MOVE 1 TO WS-ROOT.

TEST-WALK.
    CALL "PLBT-CASE" USING "PLB-AST-NEXT"
    MOVE 1 TO WS-NODE
    PERFORM WALK
    CALL "PLBT-ASSERT-STR" USING "pre-order" "ROOT A C D B" WS-ORDER
    CALL "PLBT-ASSERT-STR" USING "depths" "01221" WS-DEPTHS.

TEST-SUBTREE-WALK.
    CALL "PLBT-CASE" USING "walking a subtree"
    MOVE WS-A TO WS-NODE
    PERFORM WALK
    CALL "PLBT-ASSERT-STR" USING "stays inside A" "A C D" WS-ORDER
    MOVE WS-C TO WS-NODE
    PERFORM WALK
    CALL "PLBT-ASSERT-STR" USING "leaf subtree" "C" WS-ORDER.

TEST-EDGES.
    CALL "PLBT-CASE" USING "edges"
    MOVE 0 TO WS-NODE
    CALL "PLB-AST-NEXT" USING PLB-AST WS-ROOT WS-NODE WS-DEPTH
    MOVE 0 TO WS-EXPECT-NUM
    MOVE WS-NODE TO WS-ACTUAL-NUM
    CALL "PLBT-ASSERT-NUM" USING "walk from 0 ends"
        WS-EXPECT-NUM WS-ACTUAL-NUM
    MOVE 99 TO WS-NODE
    CALL "PLB-AST-CHILD-COUNT" USING PLB-AST WS-NODE WS-COUNT
    MOVE WS-COUNT TO WS-ACTUAL-NUM
    CALL "PLBT-ASSERT-NUM" USING "unknown node has no children"
        WS-EXPECT-NUM WS-ACTUAL-NUM
    MOVE AS-MAX TO AS-COUNT
    CALL "PLB-AST-ADD" USING PLB-AST WS-ROOT "STMT" "X" WS-TOKEN
        WS-NODE
    MOVE WS-NODE TO WS-ACTUAL-NUM
    CALL "PLBT-ASSERT-NUM" USING "full table gives node 0"
        WS-EXPECT-NUM WS-ACTUAL-NUM.
END PROGRAM TEST-PLBAST.
